# Copy to .env, then replace the SQL password before starting Docker.
# For an existing SQL Server volume, use the password that originally initialized it.
MSSQL_SA_PASSWORD=REPLACE_WITH_YOUR_OWN_STRONG_PASSWORD
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Generate a random value of at least 32 bytes for external JWT clients.
JWT_ISSUER=PerfumeLuxe
JWT_AUDIENCE=PerfumeLuxe.Clients
JWT_SIGNING_KEY=
# Set the public HTTPS domain at deployment so canonical URLs and sitemap URLs use one host.
SEO_SITE_BASE_URL=
