@model Perfume.Web.Areas.Admin.Controllers.DatabaseBackupViewModel
@{
    ViewData["Title"] = "Trung Tâm Sao Lưu Dữ Liệu (Database Backup)";
    Layout = "_AdminLayout";
}

<div style="max-width: 1200px; margin: 0 auto; padding-bottom: 60px;">
    <!-- HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 14px;">
        <div>
            <span style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--gold-primary); font-weight: 700; display: block; margin-bottom: 4px;">
                <i class="fa-solid fa-cloud-arrow-up"></i> Disaster Recovery &amp; Snapshots
            </span>
            <h1 style="font-size: 1.85rem; font-weight: 800; margin: 0; color: var(--text-primary);">
                Trung Tâm Sao Lưu Cơ Sở Dữ Liệu (Database Backup)
            </h1>
            <p style="color: var(--text-muted); margin: 4px 0 0; font-size: 0.88rem;">
                Quản lý các bản snapshot SQL Server `.bak` độc lập (COPY_ONLY), đảm bảo an toàn tuyệt đối cho dữ liệu giao dịch và đơn hàng.
            </p>
        </div>

        <form method="post" action="/admin/admindashboard/createdatabasebackup" onsubmit="return confirm('Bạn có chắc muốn thực hiện sao lưu snapshot toàn bộ cơ sở dữ liệu PerfumeDb ngay bây giờ?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-luxe" style="padding: 10px 22px; font-size: 0.92rem; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-camera-retro"></i> Tạo Snapshot Sao Lưu Ngay
            </button>
        </form>
    </div>

    <!-- NOTIFICATIONS -->
    @if (TempData["Success"] != null)
    {
        <div style="background: rgba(42,157,143,0.15); border: 1px solid #2A9D8F; border-radius: 8px; padding: 14px 20px; margin-bottom: 24px; color: #2A9D8F; font-size: 0.92rem;">
            <i class="fa-solid fa-circle-check" style="margin-right: 6px;"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background: rgba(248,113,113,0.15); border: 1px solid #f87171; border-radius: 8px; padding: 14px 20px; margin-bottom: 24px; color: #f87171; font-size: 0.92rem;">
            <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i> @TempData["Error"]
        </div>
    }

    <!-- CONFIGURATION & STATUS CARDS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; margin-bottom: 28px;">
        <div class="luxury-card" style="padding: 20px; border-left: 3px solid var(--gold-primary);">
            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em; font-weight: 600;">Cơ Sở Dữ Liệu Mục Tiêu</span>
            <div style="font-size: 1.35rem; font-weight: 800; color: var(--gold-primary); margin-top: 4px;">
                PerfumeDb
            </div>
            <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 4px;">
                Microsoft SQL Server &bull; Chế độ: COPY_ONLY
            </div>
        </div>

        <div class="luxury-card" style="padding: 20px; border-left: 3px solid #2A9D8F;">
            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em; font-weight: 600;">Trạng Thái Thư Mục Sao Lưu</span>
            <div style="font-size: 1.15rem; font-weight: 700; color: @(Model.DirectoryExists ? "#2A9D8F" : "#f87171"); margin-top: 4px; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid @(Model.DirectoryExists ? "fa-circle-check" : "fa-triangle-exclamation")"></i>
                @(Model.DirectoryExists ? "Sẵn sàng ghi dữ liệu" : "Chưa tồn tại / Không có quyền")
            </div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px; font-family: monospace; word-break: break-all;">
                @Model.BackupDirectory
            </div>
        </div>

        <div class="luxury-card" style="padding: 20px; border-left: 3px solid #c084fc;">
            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em; font-weight: 600;">Tổng Số Bản Sao Lưu Sẵn Có</span>
            <div style="font-size: 1.35rem; font-weight: 800; color: #c084fc; margin-top: 4px;">
                @Model.BackupFiles.Count bản sao lưu
            </div>
            <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 4px;">
                Dung lượng tổng: @((Model.BackupFiles.Sum(f => f.SizeBytes) / (1024.0 * 1024.0)).ToString("F2")) MB
            </div>
        </div>
    </div>

    <!-- BACKUP FILES LIST TABLE -->
    <div class="luxury-card" style="padding: 0; overflow: hidden; margin-bottom: 28px;">
        <div style="padding: 18px 24px; border-bottom: 1px solid var(--border-card); background: var(--bg-surface-elevated); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--text-primary);">
                <i class="fa-solid fa-file-shield text-gold-gradient" style="margin-right: 8px;"></i> Danh Sách File Snapshot (.BAK)
            </h3>
            <span style="font-size: 0.78rem; color: var(--text-muted);">Tất cả các bản sao lưu đã được kiểm tra tính hợp lệ</span>
        </div>

        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-card); color: var(--text-muted); text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.05em;">
                        <th style="padding: 14px 24px;">Tên File Snapshot</th>
                        <th style="padding: 14px 24px;">Thời Điểm Sao Lưu</th>
                        <th style="padding: 14px 24px; text-align: right;">Dung Lượng</th>
                        <th style="padding: 14px 24px; text-align: center;">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.BackupFiles.Count == 0)
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                <i class="fa-solid fa-folder-open" style="font-size: 2.2rem; margin-bottom: 10px; display: block;"></i>
                                Chưa có file sao lưu nào trong thư mục. Nhấn nút <strong>"Tạo Snapshot Sao Lưu Ngay"</strong> ở góc phải trên để tạo bản backup đầu tiên.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var file in Model.BackupFiles)
                        {
                            var sizeMb = file.SizeBytes / (1024.0 * 1024.0);
                            <tr style="border-bottom: 1px solid var(--border-subtle); transition: background 0.15s;">
                                <td style="padding: 14px 24px;">
                                    <div style="font-family: monospace; font-weight: 700; color: var(--gold-primary); font-size: 0.95rem;">
                                        <i class="fa-solid fa-file-zipper" style="margin-right: 6px;"></i> @file.FileName
                                    </div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px; word-break: break-all;">
                                        @file.FullPath
                                    </div>
                                </td>
                                <td style="padding: 14px 24px; color: var(--text-secondary); white-space: nowrap;">
                                    @file.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td style="padding: 14px 24px; text-align: right; font-weight: 700; color: var(--text-primary); white-space: nowrap;">
                                    @(sizeMb >= 1 ? $"{sizeMb:F2} MB" : $"{(file.SizeBytes / 1024.0):F1} KB")
                                </td>
                                <td style="padding: 14px 24px; text-align: center;">
                                    <span style="background: rgba(42,157,143,0.15); color: #2A9D8F; border: 1px solid rgba(42,157,143,0.3); padding: 3px 10px; border-radius: 99px; font-size: 0.75rem; font-weight: 700;">
                                        <i class="fa-solid fa-shield-halved"></i> Toàn Vẹn
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- RECOVERY INSTRUCTIONS CARD -->
    <div class="luxury-card" style="padding: 24px; border: 1px dashed var(--gold-primary); background: rgba(212,175,55,0.04);">
        <h4 style="margin: 0 0 10px; font-size: 0.95rem; font-weight: 700; color: var(--gold-primary);">
            <i class="fa-solid fa-circle-info" style="margin-right: 6px;"></i> Hướng Dẫn Khôi Phục Cơ Sở Dữ Liệu Khẩn Cấp (Disaster Recovery)
        </h4>
        <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 10px;">
            Khi cần khôi phục trạng thái dữ liệu từ một bản snapshot, quản trị viên mở công cụ <strong>DB Console</strong> hoặc SQL Server Management Studio (SSMS) và thực thi cú pháp:
        </p>
        <pre style="background: var(--bg-surface-elevated); padding: 12px 16px; border-radius: 6px; font-family: monospace; font-size: 0.82rem; color: var(--gold-primary); overflow-x: auto; margin: 0;">USE master;
ALTER DATABASE [PerfumeDb] SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
RESTORE DATABASE [PerfumeDb] FROM DISK = N'/duong/dan/file.bak' WITH REPLACE;
ALTER DATABASE [PerfumeDb] SET MULTI_USER;</pre>
    </div>
</div>
