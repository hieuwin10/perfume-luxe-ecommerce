@model Perfume.Application.DTOs.SystemErrorLogsViewModel
@{
    ViewData["Title"] = "Trung Tâm Nhật Ký Lỗi Máy Chủ | PERFUME LUXE";
    Layout = "_AdminLayout";
}

<div style="max-width: 1200px; margin: 0 auto;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 1.6rem; font-weight: 800; margin: 0 0 6px; color: var(--text-primary); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-triangle-exclamation text-rose-500" style="color: #ef4444;"></i>
                Trung Tâm Nhật Ký Lỗi Máy Chủ (Crash & Error Logs)
            </h1>
            <p style="color: var(--text-muted); margin: 0; font-size: 0.88rem;">
                Tự động thu thập, phân tích và truy vết mã lỗi duy nhất (ErrorCode) cho mọi sự cố HTTP 500 & ngoại lệ hệ thống
            </p>
        </div>

        <div style="display: flex; gap: 10px; align-items: center;">
            <form method="post" action="/admin/admindashboard/clearerrorlogs" onsubmit="return confirm('Dọn dẹp các bản ghi lỗi cũ hơn 30 ngày?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mode" value="old" />
                <button type="submit" class="btn-luxe-outline" style="padding: 8px 14px; font-size: 0.82rem; border-radius: 6px;">
                    <i class="fa-solid fa-calendar-minus" style="margin-right: 4px;"></i> Xóa Log > 30 Ngày
                </button>
            </form>

            <form method="post" action="/admin/admindashboard/clearerrorlogs" onsubmit="return confirm('CẢNH BÁO: Thao tác này sẽ xóa sạch TOÀN BỘ nhật ký lỗi trong cơ sở dữ liệu. Bạn có chắc chắn không?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mode" value="all" />
                <button type="submit" class="btn-luxe" style="padding: 8px 14px; font-size: 0.82rem; background: rgba(239,68,68,0.2); color: #f87171; border: 1px solid rgba(239,68,68,0.4); border-radius: 6px; cursor: pointer;">
                    <i class="fa-solid fa-trash-can" style="margin-right: 4px;"></i> Xóa Toàn Bộ
                </button>
            </form>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div style="background: rgba(16,185,129,0.15); border: 1px solid #10b981; border-radius: 8px; padding: 12px 18px; margin-bottom: 20px; color: #10b981; font-size: 0.9rem;">
            <i class="fa-solid fa-circle-check" style="margin-right: 6px;"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background: rgba(239,68,68,0.15); border: 1px solid #ef4444; border-radius: 8px; padding: 12px 18px; margin-bottom: 20px; color: #f87171; font-size: 0.9rem;">
            <i class="fa-solid fa-triangle-exclamation" style="margin-right: 6px;"></i> @TempData["Error"]
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="luxury-card" style="padding: 18px 24px; border-radius: 12px; border: 1px solid var(--border-card); background: var(--bg-surface); margin-bottom: 20px;">
        <form method="get" action="/admin/admindashboard/errorlogs" style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin: 0;">
            <div style="flex: 1; min-width: 280px; position: relative;">
                <input type="text" name="search" value="@Model.Search" placeholder="Tìm theo Mã Lỗi (ERR-...), Thông điệp ngoại lệ, Đường dẫn URL..."
                       style="width: 100%; padding: 10px 14px 10px 36px; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 8px; color: var(--text-primary); font-size: 0.88rem; outline: none;" />
                <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 12px; top: 12px; color: var(--text-muted); font-size: 0.9rem;"></i>
            </div>

            <div style="width: 160px;">
                <select name="statusCode" style="width: 100%; padding: 10px 12px; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 8px; color: var(--text-primary); font-size: 0.88rem; outline: none;">
                    <option value="">Tất cả Status Code</option>
                    <option value="500" selected="@(Model.StatusCodeFilter == 500)">500 Internal Server Error</option>
                    <option value="503" selected="@(Model.StatusCodeFilter == 503)">503 Service Unavailable</option>
                    <option value="400" selected="@(Model.StatusCodeFilter == 400)">400 Bad Request</option>
                    <option value="404" selected="@(Model.StatusCodeFilter == 404)">404 Not Found</option>
                </select>
            </div>

            <button type="submit" class="btn-luxe" style="padding: 10px 20px; font-size: 0.88rem; border-radius: 8px; border: none; cursor: pointer;">
                <i class="fa-solid fa-filter" style="margin-right: 6px;"></i> Lọc Nhật Ký
            </button>

            @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.StatusCodeFilter.HasValue)
            {
                <a href="/admin/admindashboard/errorlogs" class="btn-luxe-outline" style="padding: 10px 16px; font-size: 0.88rem; border-radius: 8px;">
                    Xóa Bộ Lọc
                </a>
            }
        </form>
    </div>

    <!-- Error Logs Table -->
    <div class="luxury-card" style="border-radius: 12px; border: 1px solid var(--border-card); background: var(--bg-surface); overflow: hidden; margin-bottom: 24px;">
        <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-card); display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 0.9rem; font-weight: 700; color: var(--text-primary);">
                Tổng cộng: <strong style="color: #ef4444;">@Model.TotalCount</strong> bản ghi lỗi được ghi nhận
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">
                Trang @Model.CurrentPage / @Model.TotalPages
            </div>
        </div>

        @if (!Model.Logs.Any())
        {
            <div style="padding: 48px 24px; text-align: center; color: var(--text-muted);">
                <i class="fa-solid fa-shield-cat" style="font-size: 3rem; color: #10b981; margin-bottom: 16px;"></i>
                <div style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 6px;">Không Có Nhật Ký Lỗi Nào</div>
                <div style="font-size: 0.85rem;">Hệ thống đang vận hành hoàn toàn ổn định hoặc không khớp với tiêu chí tìm kiếm.</div>
            </div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
                    <thead>
                        <tr style="background: var(--bg-surface-elevated); border-bottom: 1px solid var(--border-card); color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">
                            <th style="padding: 12px 16px; width: 170px;">Mã Lỗi (ErrorCode)</th>
                            <th style="padding: 12px 16px; width: 150px;">Thời Gian</th>
                            <th style="padding: 12px 16px; width: 90px;">Status</th>
                            <th style="padding: 12px 16px;">Endpoint & Phương Thức</th>
                            <th style="padding: 12px 16px;">Nội Dung Ngoại Lệ (Message)</th>
                            <th style="padding: 12px 16px; width: 110px; text-align: center;">Chi Tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr style="border-bottom: 1px solid var(--border-card); transition: background 0.15s;">
                                <td style="padding: 12px 16px; font-family: monospace; font-weight: 700; color: #f87171;">
                                    @log.ErrorCode
                                </td>
                                <td style="padding: 12px 16px; color: var(--text-muted); white-space: nowrap;">
                                    @log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td style="padding: 12px 16px;">
                                    <span style="display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 700; background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid rgba(239,68,68,0.3);">
                                        @log.StatusCode
                                    </span>
                                </td>
                                <td style="padding: 12px 16px;">
                                    <span style="font-weight: 700; color: #fbbf24; margin-right: 6px;">@log.HttpMethod</span>
                                    <code style="color: var(--text-primary); font-size: 0.82rem;">@log.RequestPath</code>
                                </td>
                                <td style="padding: 12px 16px; color: var(--text-secondary); max-width: 380px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@log.Message">
                                    @log.Message
                                </td>
                                <td style="padding: 12px 16px; text-align: center;">
                                    <button type="button" class="btn-luxe-outline" onclick="openLogModal('@log.ErrorCode', '@Html.Raw(JavaScriptEncoder.Default.Encode(log.Message))', '@Html.Raw(JavaScriptEncoder.Default.Encode(log.StackTrace ?? "Không có stack trace"))', '@log.RequestPath', '@log.HttpMethod', '@log.ClientIp', '@Html.Raw(JavaScriptEncoder.Default.Encode(log.UserAgent ?? ""))', '@log.ActorUserId')" style="padding: 4px 10px; font-size: 0.78rem; border-radius: 6px;">
                                        <i class="fa-solid fa-eye"></i> Xem
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div style="padding: 16px 20px; display: flex; justify-content: center; gap: 8px; border-top: 1px solid var(--border-card);">
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <a href="/admin/admindashboard/errorlogs?page=@p&search=@Model.Search&statusCode=@Model.StatusCodeFilter"
                           style="padding: 6px 12px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; text-decoration: none; @(p == Model.CurrentPage ? "background: var(--gold-primary); color: #000;" : "background: var(--bg-surface-elevated); color: var(--text-muted); border: 1px solid var(--border-card);")">
                            @p
                        </a>
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Modal View Details -->
<div id="logDetailModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: 16px; max-width: 800px; width: 92%; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.9);">
        <div style="padding: 18px 24px; border-bottom: 1px solid var(--border-card); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-bug" style="color: #ef4444; font-size: 1.2rem;"></i>
                <h3 id="modalErrorCode" style="margin: 0; font-size: 1.1rem; color: #f87171; font-family: monospace;">ERR-...</h3>
            </div>
            <button type="button" onclick="closeLogModal()" style="background: none; border: none; color: var(--text-muted); font-size: 1.2rem; cursor: pointer;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div style="padding: 24px; overflow-y: auto; flex: 1; font-size: 0.88rem; display: flex; flex-direction: column; gap: 16px;">
            <div>
                <label style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Thông Điệp Lỗi (Exception Message)</label>
                <div id="modalMessage" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; padding: 12px 14px; border-radius: 8px; margin-top: 6px; font-weight: 600;"></div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div>
                    <label style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Đường Dẫn & Phương Thức</label>
                    <div id="modalPath" style="margin-top: 4px; color: var(--text-primary); font-family: monospace;"></div>
                </div>
                <div>
                    <label style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Client IP & Người Dùng</label>
                    <div id="modalClient" style="margin-top: 4px; color: var(--text-primary);"></div>
                </div>
            </div>

            <div>
                <label style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">User Agent</label>
                <div id="modalUserAgent" style="margin-top: 4px; color: var(--text-muted); font-size: 0.8rem; word-break: break-all;"></div>
            </div>

            <div>
                <label style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Dấu Vết Lỗi Hệ Thống (Stack Trace)</label>
                <pre id="modalStackTrace" style="background: #09090b; border: 1px solid #27272a; color: #a1a1aa; padding: 14px; border-radius: 8px; font-family: Consolas, monospace; font-size: 0.78rem; max-height: 260px; overflow-y: auto; white-space: pre-wrap; margin-top: 6px;"></pre>
            </div>
        </div>

        <div style="padding: 14px 24px; border-top: 1px solid var(--border-card); display: flex; justify-content: flex-end;">
            <button type="button" class="btn-luxe-outline" onclick="closeLogModal()" style="padding: 8px 20px; font-size: 0.85rem; border-radius: 6px;">
                Đóng Cửa Sổ
            </button>
        </div>
    </div>
</div>

@using System.Text.Encodings.Web
<script>
    function openLogModal(code, message, stackTrace, path, method, ip, ua, actor) {
        document.getElementById('modalErrorCode').textContent = code;
        document.getElementById('modalMessage').textContent = message;
        document.getElementById('modalPath').textContent = method + ' ' + path;
        document.getElementById('modalClient').textContent = 'IP: ' + (ip || 'N/A') + ' | User: ' + (actor || 'Khách vãng lai');
        document.getElementById('modalUserAgent').textContent = ua || 'Không rõ';
        document.getElementById('modalStackTrace').textContent = stackTrace || 'Không có dấu vết StackTrace.';
        
        var modal = document.getElementById('logDetailModal');
        modal.style.display = 'flex';
    }

    function closeLogModal() {
        var modal = document.getElementById('logDetailModal');
        modal.style.display = 'none';
    }
</script>
