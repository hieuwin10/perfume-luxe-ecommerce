@model Perfume.Application.DTOs.SystemHealthViewModel
@{
    ViewData["Title"] = "Bảng Điều Khiển Sức Khỏe Nền Tảng | PERFUME LUXE";
    Layout = "_AdminLayout";
}

<div style="max-width: 1200px; margin: 0 auto;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 1.6rem; font-weight: 800; margin: 0 0 6px; color: var(--text-primary); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-heart-pulse text-emerald-400" style="color: #10b981;"></i>
                Bảng Điều Khiển Sức Khỏe Nền Tảng (System Health)
            </h1>
            <p style="color: var(--text-muted); margin: 0; font-size: 0.88rem;">
                Giám sát thời gian thực tài nguyên máy chủ, độ trễ cơ sở dữ liệu SQL Server, bộ nhớ đệm và dọn rác bộ nhớ runtime
            </p>
        </div>

        <div style="display: flex; gap: 12px; align-items: center;">
            <form method="post" action="/admin/admindashboard/flushcache" onsubmit="return confirm('Bạn có chắc chắn muốn dọn sạch bộ nhớ đệm cache và kích hoạt GC thu gom bộ nhớ runtime?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-luxe" style="padding: 10px 20px; font-size: 0.88rem; font-weight: 700; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #fff; border: none; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);">
                    <i class="fa-solid fa-broom"></i>
                    1-Click Xóa Cache & Tối Ưu GC
                </button>
            </form>
            <a href="/admin/admindashboard/systemhealth" class="btn-luxe-outline" style="padding: 9px 16px; font-size: 0.85rem; border-radius: 8px;">
                <i class="fa-solid fa-arrows-rotate" style="margin-right: 6px;"></i> Làm Mới
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div style="background: rgba(16,185,129,0.15); border: 1px solid #10b981; border-radius: 8px; padding: 12px 18px; margin-bottom: 20px; color: #10b981; font-size: 0.9rem; display: flex; align-items: center; gap: 10px;">
            <i class="fa-solid fa-circle-check"></i>
            <div>@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background: rgba(239,68,68,0.15); border: 1px solid #ef4444; border-radius: 8px; padding: 12px 18px; margin-bottom: 20px; color: #f87171; font-size: 0.9rem; display: flex; align-items: center; gap: 10px;">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <!-- 4 Key Status Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-bottom: 24px;">
        <!-- SQL Latency -->
        <div class="luxury-card" style="padding: 20px; border-radius: 12px; border: 1px solid var(--border-card); background: var(--bg-surface);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Cơ Sở Dữ Liệu SQL</span>
                <span style="padding: 4px 10px; border-radius: 99px; font-size: 0.75rem; font-weight: 700; @(Model.SqlConnected ? "background: rgba(16,185,129,0.15); color: #10b981; border: 1px solid rgba(16,185,129,0.3);" : "background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid rgba(239,68,68,0.3);")">
                    @(Model.SqlConnected ? "● Trực Tuyến" : "● Ngoại Tuyến")
                </span>
            </div>
            <div style="font-size: 1.8rem; font-weight: 900; color: var(--text-primary); margin-bottom: 6px;">
                @Model.SqlLatencyMs <span style="font-size: 1rem; font-weight: 600; color: var(--text-muted);">ms</span>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@Model.SqlVersion">
                @Model.SqlVersion
            </div>
        </div>

        <!-- Memory / Working Set -->
        <div class="luxury-card" style="padding: 20px; border-radius: 12px; border: 1px solid var(--border-card); background: var(--bg-surface);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Bộ Nhớ Tiến Trình (RAM)</span>
                <span style="padding: 4px 10px; border-radius: 99px; font-size: 0.75rem; font-weight: 700; background: rgba(59,130,246,0.15); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3);">
                    Working Set
                </span>
            </div>
            <div style="font-size: 1.8rem; font-weight: 900; color: var(--text-primary); margin-bottom: 6px;">
                @Model.ProcessMemoryMb <span style="font-size: 1rem; font-weight: 600; color: var(--text-muted);">MB</span>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">
                GC Allocated: <strong style="color: var(--text-primary);">@Model.GcTotalMemoryMb MB</strong>
            </div>
        </div>

        <!-- Server Uptime -->
        <div class="luxury-card" style="padding: 20px; border-radius: 12px; border: 1px solid var(--border-card); background: var(--bg-surface);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Thời Gian Chạy Liên Tục</span>
                <span style="padding: 4px 10px; border-radius: 99px; font-size: 0.75rem; font-weight: 700; background: rgba(212,175,55,0.15); color: #fbbf24; border: 1px solid rgba(212,175,55,0.3);">
                    Uptime
                </span>
            </div>
            <div style="font-size: 1.8rem; font-weight: 900; color: var(--text-primary); margin-bottom: 6px;">
                @($"{Model.ServerUptime.Days}d {Model.ServerUptime.Hours:D2}h {Model.ServerUptime.Minutes:D2}m")
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">
                Khởi động: @Model.ServerStartTimeUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
            </div>
        </div>

        <!-- Disk Space -->
        <div class="luxury-card" style="padding: 20px; border-radius: 12px; border: 1px solid var(--border-card); background: var(--bg-surface);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Dung Lượng Ổ Đĩa Trống</span>
                <span style="padding: 4px 10px; border-radius: 99px; font-size: 0.75rem; font-weight: 700; background: rgba(168,85,247,0.15); color: #c084fc; border: 1px solid rgba(168,85,247,0.3);">
                    Disk Storage
                </span>
            </div>
            <div style="font-size: 1.4rem; font-weight: 800; color: var(--text-primary); margin-bottom: 6px; word-break: break-all;">
                @Model.FreeDiskSpaceGb
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">
                Ổ đĩa chứa thư mục ứng dụng
            </div>
        </div>
    </div>

    <!-- Detailed System & Platform Specs -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
        <!-- Left: Environment & Runtime -->
        <div class="luxury-card" style="padding: 24px; border-radius: 12px; border: 1px solid var(--border-card); background: var(--bg-surface);">
            <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0 0 16px; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-server text-gold-gradient"></i> Thông Tin Nền Tảng Kestrel & Hệ Điều Hành
            </h3>
            <table style="width: 100%; font-size: 0.88rem; border-collapse: collapse;">
                <tbody>
                    <tr style="border-bottom: 1px solid var(--border-card);">
                        <td style="padding: 10px 0; color: var(--text-muted); width: 40%;">Hệ Điều Hành (OS):</td>
                        <td style="padding: 10px 0; font-weight: 600; color: var(--text-primary);">@Model.OsDescription</td>
                    </tr>
                    <tr style="border-bottom: 1px solid var(--border-card);">
                        <td style="padding: 10px 0; color: var(--text-muted);">Phiên Bản .NET Runtime:</td>
                        <td style="padding: 10px 0; font-weight: 600; color: var(--text-primary);">.NET @Model.DotNetVersion</td>
                    </tr>
                    <tr style="border-bottom: 1px solid var(--border-card);">
                        <td style="padding: 10px 0; color: var(--text-muted);">Số Luồng CPU (Logical Cores):</td>
                        <td style="padding: 10px 0; font-weight: 600; color: var(--text-primary);">@Model.ProcessorCount Cores</td>
                    </tr>
                    <tr style="border-bottom: 1px solid var(--border-card);">
                        <td style="padding: 10px 0; color: var(--text-muted);">Thời Gian Máy Chủ Hiện Tại:</td>
                        <td style="padding: 10px 0; font-weight: 600; color: var(--text-primary);">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss") (Local)</td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 0; color: var(--text-muted);">Redis Cache Phân Tán:</td>
                        <td style="padding: 10px 0; font-weight: 600;">
                            @if (Model.RedisConfigured)
                            {
                                <span style="color: #10b981;"><i class="fa-solid fa-check"></i> Đã cấu hình</span>
                            }
                            else
                            {
                                <span style="color: var(--text-muted);"><i class="fa-solid fa-microchip"></i> Bộ Nhớ Trong (In-Memory Distributed)</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Right: Diagnostic Counters & Fast Action Links -->
        <div class="luxury-card" style="padding: 24px; border-radius: 12px; border: 1px solid var(--border-card); background: var(--bg-surface);">
            <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0 0 16px; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-shield-halved text-gold-gradient"></i> Thống Kê Giám Sát & Nhật Ký
            </h3>
            <div style="display: flex; flex-direction: column; gap: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: var(--bg-surface-elevated); border-radius: 8px; border: 1px solid var(--border-card);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fa-solid fa-triangle-exclamation" style="color: #ef4444; font-size: 1.1rem;"></i>
                        <div>
                            <div style="font-weight: 700; font-size: 0.9rem;">Nhật Ký Lỗi Máy Chủ (Error Logs)</div>
                            <div style="font-size: 0.78rem; color: var(--text-muted);">Các ngoại lệ hệ thống và sự cố 500</div>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-size: 1.2rem; font-weight: 800; color: #ef4444;">@Model.TotalErrorLogsCount</span>
                        <a href="/admin/admindashboard/errorlogs" class="btn-luxe-outline" style="padding: 6px 12px; font-size: 0.8rem; border-radius: 6px;">
                            Xem Chi Tiết
                        </a>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: var(--bg-surface-elevated); border-radius: 8px; border: 1px solid var(--border-card);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fa-solid fa-clipboard-check" style="color: #10b981; font-size: 1.1rem;"></i>
                        <div>
                            <div style="font-weight: 700; font-size: 0.9rem;">Nhật Ký Kiểm Toán (Audit Logs)</div>
                            <div style="font-size: 0.78rem; color: var(--text-muted);">Theo dõi thao tác quản trị & thay đổi DB</div>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-size: 1.2rem; font-weight: 800; color: #10b981;">@Model.TotalAuditLogsCount</span>
                        <a href="/admin/admindashboard/auditlogs" class="btn-luxe-outline" style="padding: 6px 12px; font-size: 0.8rem; border-radius: 6px;">
                            Xem Chi Tiết
                        </a>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: var(--bg-surface-elevated); border-radius: 8px; border: 1px solid var(--border-card);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fa-solid fa-screwdriver-wrench" style="color: #f59e0b; font-size: 1.1rem;"></i>
                        <div>
                            <div style="font-weight: 700; font-size: 0.9rem;">Chế Độ Bảo Trì Hệ Thống (Maintenance)</div>
                            <div style="font-size: 0.78rem; color: var(--text-muted);">Bảo trì toàn sàn với Admin & IP Bypass</div>
                        </div>
                    </div>
                    <a href="/admin/admindashboard/settings#maintenanceSection" class="btn-luxe-outline" style="padding: 6px 12px; font-size: 0.8rem; border-radius: 6px;">
                        Cấu Hình
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
