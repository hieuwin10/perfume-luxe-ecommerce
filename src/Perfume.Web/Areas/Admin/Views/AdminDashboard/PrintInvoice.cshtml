@model Perfume.Domain.Entities.Order
@using Perfume.Domain.Enums
@{
    Layout = null;
    var settings = ViewBag.Settings as Perfume.Application.DTOs.SystemSettingsDto;
    var storeName = settings?.StoreName ?? "PERFUME LUXE";
    var storeSlogan = settings?.StoreSlogan ?? "Haute Parfumerie & Niche Fragrances";
    var hotline = settings?.Hotline ?? "1900 8888";
    var boutique = settings?.BoutiqueAddress ?? "88 Đồng Khởi, Bến Nghé, Quận 1, TP. HCM";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Phiếu Xuất Kho & Thu Tiền COD - #@Model.OrderCode</title>
    <style>
        @@page {
            size: A4;
            margin: 15mm;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #1a1a1a;
            background: #fff;
            margin: 0;
            padding: 20px;
            font-size: 13px;
            line-height: 1.5;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #000;
            padding-bottom: 14px;
            margin-bottom: 20px;
        }
        .brand-name {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.1em;
            color: #000;
            text-transform: uppercase;
        }
        .brand-sub {
            font-size: 11px;
            color: #555;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .doc-title {
            text-align: right;
        }
        .doc-title h1 {
            font-size: 20px;
            margin: 0 0 4px;
            text-transform: uppercase;
            color: #000;
        }
        .order-code {
            font-size: 14px;
            font-weight: 700;
            color: #b45309;
        }
        .meta-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        .meta-box {
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 12px 14px;
            background: #fafafa;
        }
        .meta-box h3 {
            margin: 0 0 8px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #666;
            border-bottom: 1px solid #e5e5e5;
            padding-bottom: 4px;
        }
        .meta-item {
            margin-bottom: 4px;
        }
        .meta-item strong {
            color: #000;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px 12px;
            text-align: left;
        }
        th {
            background: #f3f4f6;
            font-weight: 700;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .text-right {
            text-align: right;
        }
        .text-center {
            text-align: center;
        }
        .totals {
            margin-left: auto;
            width: 320px;
            margin-bottom: 30px;
        }
        .totals table {
            margin: 0;
        }
        .totals td {
            border: none;
            padding: 6px 8px;
        }
        .totals tr.grand-total td {
            border-top: 2px solid #000;
            font-size: 16px;
            font-weight: 800;
            color: #000;
        }
        .cod-notice {
            background: #fef3c7;
            border: 2px dashed #d97706;
            padding: 14px;
            border-radius: 6px;
            text-align: center;
            margin-bottom: 30px;
        }
        .cod-amount {
            font-size: 22px;
            font-weight: 900;
            color: #b45309;
            margin-top: 4px;
        }
        .signatures {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            text-align: center;
            margin-top: 40px;
            page-break-inside: avoid;
        }
        .sig-col {
            padding: 0 10px;
        }
        .sig-title {
            font-weight: 700;
            margin-bottom: 60px;
            text-transform: uppercase;
            font-size: 11px;
        }
        .print-btn-bar {
            text-align: center;
            margin-bottom: 20px;
            padding: 10px;
            background: #f3f4f6;
            border-radius: 6px;
        }
        .print-btn {
            background: #000;
            color: #fff;
            border: none;
            padding: 10px 24px;
            font-weight: 700;
            cursor: pointer;
            border-radius: 4px;
            font-size: 14px;
        }
        @@media print {
            .print-btn-bar {
                display: none;
            }
            body {
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="print-btn-bar">
        <button class="print-btn" onclick="window.print()">🖨️ IN PHIẾU XUẤT KHO / HÓA ĐƠN</button>
        <span style="margin-left: 14px; color: #666; font-size: 12px;">(Nhấn Ctrl + P hoặc nút In ở trên, phiếu đã được tối ưu căn lề trang A4)</span>
    </div>

    <!-- Header -->
    <div class="header">
        <div>
            <div class="brand-name">@storeName</div>
            <div class="brand-sub">@storeSlogan</div>
            <div style="margin-top: 6px; font-size: 12px; color: #444;">
                <div>Địa chỉ: @boutique</div>
                <div>Hotline CSKH: <strong>@hotline</strong></div>
            </div>
        </div>
        <div class="doc-title">
            <h1>PHIẾU XUẤT KHO & GIAO HÀNG</h1>
            <div class="order-code">MÃ ĐƠN: #@Model.OrderCode</div>
            <div style="font-size: 12px; color: #666; margin-top: 4px;">
                Ngày lập: @DateTime.UtcNow.ToString("dd/MM/yyyy HH:mm") (UTC)
            </div>
        </div>
    </div>

    <!-- Meta Information -->
    <div class="meta-grid">
        <div class="meta-box">
            <h3>Thông Tin Người Nhận (Khách Hàng)</h3>
            <div class="meta-item"><strong>Họ và tên:</strong> @Model.CustomerName</div>
            <div class="meta-item"><strong>Số điện thoại:</strong> @Model.CustomerPhone</div>
            <div class="meta-item"><strong>Email:</strong> @Model.CustomerEmail</div>
            <div class="meta-item"><strong>Địa chỉ nhận:</strong> @Model.ShippingAddress @(string.IsNullOrWhiteSpace(Model.City) ? "" : $", {Model.City}")</div>
            @if (!string.IsNullOrWhiteSpace(Model.OrderNotes))
            {
                <div class="meta-item" style="color: #b45309;"><strong>Ghi chú:</strong> @Model.OrderNotes</div>
            }
        </div>

        <div class="meta-box">
            <h3>Chi Tiết Vận Chuyển & Thanh Toán</h3>
            <div class="meta-item"><strong>Hình thức thanh toán:</strong> @Model.PaymentMethod (Thu tiền tận nơi)</div>
            <div class="meta-item"><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</div>
            <div class="meta-item"><strong>Trạng thái đơn:</strong> @Model.OrderStatus</div>
            <div class="meta-item"><strong>Mã Voucher:</strong> @(string.IsNullOrWhiteSpace(Model.VoucherCode) ? "Không có" : Model.VoucherCode)</div>
            <div class="meta-item"><strong>Thời điểm đặt:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    </div>

    <!-- COD Notice Box -->
    <div class="cod-notice">
        <div style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
            ⚠️ SỐ TIỀN NHÂN VIÊN GIAO HÀNG (SHIPPER) CẦN THU CỦA KHÁCH:
        </div>
        <div class="cod-amount">@Model.TotalAmount.ToString("N0") VNĐ</div>
        <div style="font-size: 11px; color: #78350f; margin-top: 4px;">
            (Bằng chữ: Khách hàng thanh toán đúng số tiền trên khi nhận bưu phẩm, kiểm tra tem niêm phong Haute Parfumerie trước khi nhận)
        </div>
    </div>

    <!-- Items Table -->
    <table>
        <thead>
            <tr>
                <th style="width: 40px;" class="text-center">STT</th>
                <th>Tên Nước Hoa / Sản Phẩm</th>
                <th style="width: 140px;">Phiên Bản / Dung Tích</th>
                <th style="width: 110px;" class="text-right">Đơn Giá</th>
                <th style="width: 60px;" class="text-center">SL</th>
                <th style="width: 120px;" class="text-right">Thành Tiền</th>
            </tr>
        </thead>
        <tbody>
            @{ int stt = 1; }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="text-center">@(stt++)</td>
                    <td>
                        <strong>@item.ProductName</strong>
                        <div style="font-size: 11px; color: #666;">Mã SP: #@item.ProductId</div>
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(item.VariantLabel) ? "Chai chuẩn" : item.VariantLabel)</td>
                    <td class="text-right">@item.UnitPrice.ToString("N0") ₫</td>
                    <td class="text-center"><strong>@item.Quantity</strong></td>
                    <td class="text-right"><strong>@item.TotalPrice.ToString("N0") ₫</strong></td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Totals Table -->
    <div class="totals">
        <table>
            <tr>
                <td>Tạm tính hàng hóa:</td>
                <td class="text-right">@Model.SubTotal.ToString("N0") ₫</td>
            </tr>
            @if (Model.DiscountAmount > 0)
            {
                <tr style="color: #b45309;">
                    <td>Chiết khấu Voucher:</td>
                    <td class="text-right">-@Model.DiscountAmount.ToString("N0") ₫</td>
                </tr>
            }
            <tr>
                <td>Phí vận chuyển:</td>
                <td class="text-right">@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("N0") + " ₫")</td>
            </tr>
            <tr class="grand-total">
                <td>TỔNG THANH TOÁN:</td>
                <td class="text-right">@Model.TotalAmount.ToString("N0") ₫</td>
            </tr>
        </table>
    </div>

    <!-- Signatures -->
    <div class="signatures">
        <div class="sig-col">
            <div class="sig-title">Người Lập Phiếu</div>
            <div style="font-size: 11px; color: #888;">(Ký và ghi rõ họ tên)</div>
        </div>
        <div class="sig-col">
            <div class="sig-title">Nhân Viên Giao Hàng</div>
            <div style="font-size: 11px; color: #888;">(Ký và ghi rõ họ tên)</div>
        </div>
        <div class="sig-col">
            <div class="sig-title">Khách Hàng Nhận</div>
            <div style="font-size: 11px; color: #888;">(Ký và ghi rõ họ tên)</div>
        </div>
    </div>
</body>
</html>
