@model List<Perfume.Domain.Entities.Brand>
@{
    ViewData["Title"] = "Quản Lý Thương Hiệu Nước Hoa";
    Layout = "_AdminLayout";
}

<div style="max-width: 1300px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 14px;">
        <div>
            <h1 style="font-size: 1.6rem; font-weight: 800; margin: 0 0 6px; color: var(--text-primary);">
                <i class="fa-solid fa-copyright text-gold-gradient" style="margin-right: 8px;"></i> Thương Hiệu Nước Hoa (Brands)
            </h1>
            <p style="color: var(--text-muted); margin: 0; font-size: 0.88rem;">
                Quản lý các nhà sáng tạo hương Haute Parfumerie (Tổng: @Model.Count thương hiệu)
            </p>
        </div>

        <button onclick="openBrandModal(0, '', '', '', '', false)" class="btn-luxe" style="padding: 8px 18px; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-plus"></i> Thêm Thương Hiệu
        </button>
    </div>

    @if (TempData["Error"] != null)
    {
        <div style="background: rgba(230,57,70,0.12); border: 1px solid #e63946; border-radius: 8px; padding: 12px 18px; margin-bottom: 20px; color: #f87171; font-size: 0.9rem;">
            <i class="fa-solid fa-triangle-exclamation" style="margin-right: 6px;"></i> @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div style="background: rgba(42,157,143,0.15); border: 1px solid #2A9D8F; border-radius: 8px; padding: 12px 18px; margin-bottom: 20px; color: #2A9D8F; font-size: 0.9rem;">
            <i class="fa-solid fa-circle-check" style="margin-right: 6px;"></i> @TempData["Success"]
        </div>
    }

    <!-- Brand Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
        @foreach (var b in Model)
        {
            <div class="luxury-card" style="padding: 20px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 12px;">
                        <img src="@(string.IsNullOrWhiteSpace(b.LogoUrl) ? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=100&q=80" : b.LogoUrl)" 
                             alt="@b.Name" 
                             style="width: 50px; height: 50px; border-radius: 8px; object-fit: cover; border: 1px solid var(--border-card); background: #000;" />
                        <div>
                            <div style="font-weight: 700; font-size: 1.05rem; color: var(--text-primary);">@b.Name</div>
                            <div style="font-size: 0.78rem; color: var(--gold-primary);">
                                <i class="fa-solid fa-earth-americas" style="margin-right: 4px;"></i>@(b.Country ?? "Global")
                            </div>
                        </div>
                    </div>

                    <p style="color: var(--text-secondary); font-size: 0.82rem; line-height: 1.4; margin-bottom: 14px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @(b.Description ?? "Chưa có mô tả.")
                    </p>
                </div>

                <div style="border-top: 1px solid var(--border-card); padding-top: 12px; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 0.8rem; color: var(--text-muted);">
                        <strong style="color: var(--text-primary);">@b.Products.Count</strong> sản phẩm
                    </span>

                    <div style="display: flex; gap: 8px;">
                        <button onclick="openBrandModal(@b.Id, '@b.Name', '@(b.Country ?? "")', '@(b.LogoUrl ?? "")', '@(b.Description ?? "")', @(b.IsFeatured ? "true" : "false"))"
                                style="background: none; border: none; color: var(--gold-primary); cursor: pointer; padding: 4px; font-size: 0.85rem;" title="Sửa">
                            <i class="fa-solid fa-pen-to-square"></i> Sửa
                        </button>
                        <form method="post" action="/admin/catalogmanager/deletebrand" style="margin: 0;" onsubmit="return confirm('Bạn có chắc muốn xóa thương hiệu này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@b.Id" />
                            <button type="submit" style="background: none; border: none; color: #f87171; cursor: pointer; padding: 4px; font-size: 0.85rem;" title="Xóa">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Create / Edit Brand -->
<div id="brandModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); z-index: 2000; align-items: center; justify-content: center; padding: 20px;">
    <div class="luxury-card" style="max-width: 500px; width: 100%; padding: 26px; border: 1px solid var(--gold-primary);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
            <h3 id="brandModalTitle" style="margin: 0; font-size: 1.2rem; color: var(--text-primary); font-weight: 700;">Thêm Thương Hiệu</h3>
            <button onclick="closeBrandModal()" style="background: none; border: none; color: var(--text-muted); font-size: 1.2rem; cursor: pointer;">&times;</button>
        </div>

        <form method="post" action="/admin/catalogmanager/savebrand">
            @Html.AntiForgeryToken()
            <input type="hidden" id="brandId" name="id" value="0" />

            <div style="display: flex; flex-direction: column; gap: 14px;">
                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; text-transform: uppercase;">Tên Thương Hiệu *</label>
                    <input type="text" id="brandName" name="name" required
                           style="width: 100%; padding: 10px 12px; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 6px; color: var(--text-primary); font-size: 0.9rem; outline: none;" />
                </div>

                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; text-transform: uppercase;">Quốc Gia (Country)</label>
                    <input type="text" id="brandCountry" name="country" placeholder="vd: Pháp (France), Ý (Italy), Mỹ..."
                           style="width: 100%; padding: 10px 12px; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 6px; color: var(--text-primary); font-size: 0.9rem; outline: none;" />
                </div>

                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; text-transform: uppercase;">Logo CDN Url</label>
                    <input type="url" id="brandLogo" name="logoUrl" placeholder="https://..."
                           style="width: 100%; padding: 10px 12px; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 6px; color: var(--text-primary); font-size: 0.9rem; outline: none;" />
                </div>

                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; text-transform: uppercase;">Mô Tả Thương Hiệu</label>
                    <textarea id="brandDesc" name="description" rows="3"
                              style="width: 100%; padding: 10px 12px; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 6px; color: var(--text-primary); font-size: 0.85rem; outline: none;"></textarea>
                </div>

                <div>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.88rem; color: var(--text-primary);">
                        <input type="checkbox" id="brandFeatured" name="isFeatured" value="true" style="accent-color: var(--gold-primary);" /> Thương hiệu nổi bật (Hiển thị Trang Chủ)
                    </label>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px;">
                    <button type="button" onclick="closeBrandModal()" class="btn-luxe-outline" style="padding: 8px 16px;">Hủy</button>
                    <button type="submit" class="btn-luxe" style="padding: 8px 20px;">Lưu</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function openBrandModal(id, name, country, logo, desc, featured) {
        document.getElementById('brandId').value = id;
        document.getElementById('brandName').value = name;
        document.getElementById('brandCountry').value = country;
        document.getElementById('brandLogo').value = logo;
        document.getElementById('brandDesc').value = desc;
        document.getElementById('brandFeatured').checked = featured;
        document.getElementById('brandModalTitle').innerText = id === 0 ? 'Thêm Thương Hiệu Mới' : 'Sửa Thương Hiệu';
        const modal = document.getElementById('brandModal');
        modal.style.display = 'flex';
    }
    function closeBrandModal() {
        document.getElementById('brandModal').style.display = 'none';
    }
</script>
