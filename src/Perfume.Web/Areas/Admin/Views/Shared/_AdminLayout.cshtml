@using Microsoft.AspNetCore.Identity
@inject SignInManager<Perfume.Infrastructure.Identity.AppUser> SignInManager
@inject UserManager<Perfume.Infrastructure.Identity.AppUser> UserManager
<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin Console") | PERFUME LUXE</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/luxury-perfume.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dark-theme">
    <!-- Admin Console Navigation -->
    <header style="background: #111116; border-bottom: 1px solid rgba(212, 175, 55, 0.2); padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 1000; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
            <button type="button" class="admin-nav-toggle-btn" id="adminNavToggleBtn" aria-label="Mở menu quản trị">
                <i class="fa-solid fa-bars"></i> Menu Quản Trị
            </button>

            <a href="@(User.IsInRole("Admin") ? "/admin/admindashboard" : "/admin/storemanager")" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
                <div style="width: 34px; height: 34px; border-radius: 6px; background: var(--gold-gradient); display: flex; align-items: center; justify-content: center; color: #000; font-weight: 800; font-size: 1.1rem;">
                    <i class="fa-solid fa-crown"></i>
                </div>
                <div>
                    <span style="font-weight: 700; letter-spacing: 0.05em; font-size: 1.05rem; color: #FFF;">PERFUME LUXE ADMIN</span>
                    <span style="font-size: 0.7rem; color: var(--gold-primary); display: block; line-height: 1;">Enterprise Management Suite</span>
                </div>
            </a>

            <nav class="admin-header-nav" id="adminHeaderNav">
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin/admindashboard" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                        <i class="fa-solid fa-gauge-high" style="margin-right: 4px;"></i> Tổng Quan
                    </a>
                }
                <a href="/admin/storemanager" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-chart-line" style="margin-right: 4px;"></i> Thống Kê
                </a>
                <a href="/admin/admindashboard/financialreport" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; color: var(--gold-primary);">
                    <i class="fa-solid fa-coins" style="margin-right: 4px;"></i> Tài Chính P&amp;L
                </a>
                <a href="/admin/admindashboard/products" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-bottle-droplet" style="margin-right: 4px;"></i> Sản Phẩm
                </a>
                <a href="/admin/catalogmanager/brands" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-copyright" style="margin-right: 4px;"></i> Thương Hiệu
                </a>
                <a href="/admin/catalogmanager/fragrancefamilies" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-palette" style="margin-right: 4px;"></i> Nhóm Hương
                </a>
                <a href="/admin/catalogmanager/fragrancenotes" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-leaf" style="margin-right: 4px;"></i> Nốt Hương
                </a>
                <a href="/admin/admindashboard/inventory" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-warehouse" style="margin-right: 4px;"></i> Tồn Kho
                </a>
                <a href="/admin/admindashboard/banners" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-images" style="margin-right: 4px;"></i> Banners
                </a>
                <a href="/admin/admindashboard/orders" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-boxes-stacked" style="margin-right: 4px;"></i> Đơn Hàng
                </a>
                <a href="/admin/admindashboard/flashsales" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; color: #f59e0b;">
                    <i class="fa-solid fa-bolt" style="margin-right: 4px;"></i> Flash Sale
                </a>
                <a href="/admin/admindashboard/tastings" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-crown" style="margin-right: 4px; color: var(--gold-primary);"></i> Lịch Hẹn VIP
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin/admindashboard/users" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                        <i class="fa-solid fa-users-gear" style="margin-right: 4px;"></i> Phân Quyền
                    </a>
                }
                <a href="/admin/storemanager/vouchers" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-ticket" style="margin-right: 4px;"></i> Voucher
                </a>
                <a href="/admin/storemanager/reviews" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-star" style="margin-right: 4px;"></i> Đánh Giá
                </a>
                <a href="/admin/admindashboard/blogs" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-feather-pointed" style="margin-right: 4px; color: var(--gold-primary);"></i> Tạp Chí / Blog
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin/admindashboard/systemhealth" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; color: #10b981; font-weight: 600;">
                        <i class="fa-solid fa-heart-pulse" style="margin-right: 4px;"></i> Sức Khỏe HT
                    </a>
                    <a href="/admin/admindashboard/errorlogs" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; color: #ef4444; font-weight: 600;">
                        <i class="fa-solid fa-triangle-exclamation" style="margin-right: 4px;"></i> Error Logs
                    </a>
                    <a href="/admin/admindashboard/auditlogs" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                        <i class="fa-solid fa-clipboard-check" style="margin-right: 4px;"></i> Audit Logs
                    </a>
                    <a href="/admin/admindashboard/databasebackup" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                        <i class="fa-solid fa-cloud-arrow-up" style="margin-right: 4px;"></i> Sao Lưu DB
                    </a>
                    <a href="/admin/admindashboard/erd" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; color: var(--gold-primary);">
                        <i class="fa-solid fa-diagram-project" style="margin-right: 4px;"></i> Sơ Đồ ERD
                    </a>
                    <a href="/admin/admindashboard/settings" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem;">
                        <i class="fa-solid fa-gear" style="margin-right: 4px;"></i> Cài Đặt
                    </a>
                    <a href="/admin/databaseconsole" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; background: rgba(212,175,55,0.1); border: 1px solid rgba(212,175,55,0.25);">
                        <i class="fa-solid fa-database" style="margin-right: 4px;"></i> DB Console
                    </a>
                }
                <a href="/swagger" target="_blank" class="nav-link" style="padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; background: rgba(42,157,143,0.12); border: 1px solid rgba(42,157,143,0.35); color: #2dd4bf; font-weight: 600;">
                    <i class="fa-solid fa-code" style="margin-right: 4px;"></i> API Swagger
                </a>
            </nav>
        </div>

        <div style="display: flex; align-items: center; gap: 14px;">
            @if (SignInManager.IsSignedIn(User))
            {
                var currentUser = await UserManager.GetUserAsync(User);
                <div style="display: flex; align-items: center; gap: 8px; font-size: 0.82rem;">
                    <span style="color: var(--text-secondary);">@currentUser?.FullName</span>
                    @if (User.IsInRole("Admin")) { <span class="role-badge-admin">Admin</span> }
                    else if (User.IsInRole("StoreManager")) { <span class="role-badge-manager">Cửa Hàng Trưởng</span> }
                </div>
            }

            <!-- Dark / Light theme toggle -->
            <button type="button" class="icon-btn" id="themeToggleBtnAdmin" style="width: 34px; height: 34px;" title="Chuyển theme">
                <i class="fa-solid fa-moon" id="themeIconAdmin"></i>
            </button>

            <!-- Storefront Link -->
            <a href="/" class="btn-luxe-outline" style="padding: 6px 12px; font-size: 0.78rem;">
                <i class="fa-solid fa-store" style="margin-right: 4px;"></i> Cửa Hàng
            </a>

            <!-- Logout -->
            <form method="post" action="/account/logout" style="margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="icon-btn" title="Đăng Xuất" style="width: 34px; height: 34px; color: #f87171;">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </button>
            </form>
        </div>
    </header>

    <main style="padding: 24px;">
        @RenderBody()
    </main>

    <script>
        (function() {
            const saved = localStorage.getItem('perfume_luxe_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', saved);
            document.body.className = saved === 'dark' ? 'dark-theme' : 'light-theme';
            const icon = document.getElementById('themeIconAdmin');
            if (icon) icon.className = saved === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
        })();

        document.getElementById('themeToggleBtnAdmin')?.addEventListener('click', function() {
            const cur = document.documentElement.getAttribute('data-theme') || 'dark';
            const next = cur === 'dark' ? 'light' : 'dark';
            localStorage.setItem('perfume_luxe_theme', next);
            document.documentElement.setAttribute('data-theme', next);
            document.body.className = next === 'dark' ? 'dark-theme' : 'light-theme';
            const icon = document.getElementById('themeIconAdmin');
            if (icon) icon.className = next === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
        });

        // Admin mobile navigation toggle
        const adminNavToggleBtn = document.getElementById('adminNavToggleBtn');
        const adminHeaderNav = document.getElementById('adminHeaderNav');
        if (adminNavToggleBtn && adminHeaderNav) {
            adminNavToggleBtn.addEventListener('click', () => {
                adminHeaderNav.classList.toggle('active');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
