@model TableDataResult?
@{
    ViewData["Title"] = "AWS-Style Database Console";
    var tables = ViewBag.Tables as List<TableInfo> ?? new List<TableInfo>();
    string activeTable = ViewBag.ActiveTable as string ?? "";
    long totalRows = tables.Sum(t => t.RowCount);
    decimal totalSpace = tables.Sum(t => t.TotalSpaceMB);
}

<div class="aws-console-wrapper">
    <!-- Top System Metrics (AWS Style) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 18px 20px;">
            <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 6px;">Tổng Số Bảng</div>
            <div style="font-size: 1.8rem; font-weight: 700; color: var(--gold-primary);"><i class="fa-solid fa-table-list" style="margin-right: 8px;"></i>@tables.Count</div>
        </div>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 18px 20px;">
            <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 6px;">Tổng Bản Ghi</div>
            <div style="font-size: 1.8rem; font-weight: 700; color: #48CAE4;"><i class="fa-solid fa-database" style="margin-right: 8px;"></i>@totalRows.ToString("N0")</div>
        </div>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 18px 20px;">
            <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 6px;">Dung Lượng CSDL</div>
            <div style="font-size: 1.8rem; font-weight: 700; color: #52B788;"><i class="fa-solid fa-hard-drive" style="margin-right: 8px;"></i>@totalSpace MB</div>
        </div>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 18px 20px;">
            <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 6px;">Hệ Quản Trị</div>
            <div style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-top: 6px;"><i class="fa-brands fa-microsoft" style="color: #00A4EF; margin-right: 6px;"></i>SQL Server 2022</div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Message"] != null)
    {
        <div style="background: rgba(82, 183, 136, 0.15); border: 1px solid rgba(82, 183, 136, 0.4); color: #52B788; padding: 12px 18px; border-radius: var(--radius-sm); margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
            <i class="fa-solid fa-circle-check"></i> <span>@TempData["Message"]</span>
        </div>
    }
    @if (TempData["Error"] != null || ViewBag.Error != null)
    {
        <div style="background: rgba(230, 57, 70, 0.15); border: 1px solid rgba(230, 57, 70, 0.4); color: #E63946; padding: 12px 18px; border-radius: var(--radius-sm); margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
            <i class="fa-solid fa-triangle-exclamation"></i> <span>@(TempData["Error"] ?? ViewBag.Error)</span>
        </div>
    }

    <!-- Tabs Navigation -->
    <div style="display: flex; gap: 12px; border-bottom: 1px solid var(--border-card); margin-bottom: 24px;">
        <button type="button" class="tab-btn active" id="tableTabBtn" onclick="switchConsoleTab('tableTab')">
            <i class="fa-solid fa-table" style="margin-right: 6px;"></i> Duyệt Bảng & CRUD Trực Quan
        </button>
        <button type="button" class="tab-btn" id="queryTabBtn" onclick="switchConsoleTab('queryTab')">
            <i class="fa-solid fa-terminal" style="margin-right: 6px;"></i> Trình Chạy Lệnh SQL (Query Runner)
        </button>
        <button type="button" class="tab-btn" id="seederTabBtn" onclick="switchConsoleTab('seederTab')">
            <i class="fa-solid fa-cloud-arrow-down" style="margin-right: 6px;"></i> Nạp Dữ Liệu Mẫu (Seed Data)
        </button>
    </div>

    <!-- TAB 1: TABLE EXPLORER & VISUAL CRUD -->
    <div id="tableTab" class="tab-content active">
        <div class="console-grid">
            <!-- Sidebar: Table Navigator -->
            <div class="tables-sidebar">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                    <span style="font-weight: 700; font-size: 0.9rem; text-transform: uppercase; color: var(--gold-primary);">Danh Sách Bảng</span>
                    <span style="font-size: 0.75rem; background: var(--bg-surface-elevated); padding: 2px 8px; border-radius: 12px;">@tables.Count bảng</span>
                </div>
                <input type="text" id="tableSearchInput" placeholder="Lọc bảng..." onkeyup="filterTablesList()" style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); padding: 8px 12px; border-radius: var(--radius-sm); color: var(--text-primary); font-size: 0.85rem; margin-bottom: 12px; outline: none;" />
                
                <div id="tablesNavList" style="display: flex; flex-direction: column; gap: 4px; max-height: 600px; overflow-y: auto;">
                    @foreach (var tbl in tables)
                    {
                        bool isCurrent = tbl.TableName.Equals(activeTable, StringComparison.OrdinalIgnoreCase);
                        <a href="/admin/databaseconsole?table=@tbl.TableName" class="table-list-item @(isCurrent ? "active" : "")">
                            <span style="display: flex; align-items: center; gap: 8px;">
                                <i class="fa-solid fa-table" style="font-size: 0.8rem; opacity: 0.7;"></i>
                                <span class="table-name-text">@tbl.TableName</span>
                            </span>
                            <span style="font-size: 0.75rem; background: var(--bg-main); padding: 2px 6px; border-radius: 4px; opacity: 0.8;">@tbl.RowCount</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Main Panel: Data Grid & Actions -->
            <div class="console-main-panel">
                @if (Model != null)
                {
                    var pkCol = Model.Columns.FirstOrDefault(c => c.IsPrimaryKey)?.ColumnName ?? Model.Columns.FirstOrDefault()?.ColumnName ?? "Id";
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
                        <div>
                            <h2 style="font-size: 1.5rem; margin-bottom: 2px;">
                                <i class="fa-solid fa-table text-gold-gradient" style="margin-right: 8px;"></i>dbo.@Model.TableName
                            </h2>
                            <div style="font-size: 0.8rem; color: var(--text-muted);">
                                Hiển thị @Model.Rows.Count trong tổng số @Model.TotalRows bản ghi (Trang @Model.CurrentPage / @Math.Max(1, Model.TotalPages))
                            </div>
                        </div>

                        <div style="display: flex; gap: 10px;">
                            <button type="button" class="btn-luxe" onclick="openAddRowModal('@Model.TableName')" style="padding: 9px 18px; font-size: 0.82rem;">
                                <i class="fa-solid fa-plus"></i> Thêm Bản Ghi Mới
                            </button>
                            <button type="button" class="btn-luxe-outline" onclick="toggleSchemaModal()" style="padding: 8px 16px; font-size: 0.82rem;">
                                <i class="fa-solid fa-circle-info"></i> Xem Cấu Trúc Cột
                            </button>
                        </div>
                    </div>

                    <!-- Data Grid Table -->
                    @if (Model.Rows.Any())
                    {
                        <div style="overflow-x: auto; border: 1px solid var(--border-card); border-radius: var(--radius-sm); margin-bottom: 20px;">
                            <table class="data-table-custom">
                                <thead>
                                    <tr>
                                        <th style="width: 90px; text-align: center;">Thao Tác</th>
                                        @foreach (var col in Model.Columns)
                                        {
                                            <th>
                                                @col.ColumnName
                                                @if (col.IsPrimaryKey)
                                                {
                                                    <i class="fa-solid fa-key" style="color: var(--gold-primary); font-size: 0.7rem; margin-left: 4px;" title="Primary Key"></i>
                                                }
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.Rows)
                                    {
                                        var pkVal = row.ContainsKey(pkCol) ? row[pkCol]?.ToString() : "";
                                        <tr>
                                            <td style="text-align: center; white-space: nowrap;">
                                                <button type="button" onclick="openEditRowModal('@Model.TableName', '@pkCol', '@pkVal')" style="background: none; border: none; color: var(--gold-primary); cursor: pointer; padding: 4px 6px;" title="Chỉnh sửa">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>
                                                <form asp-action="DeleteRow" asp-route-table="@Model.TableName" asp-route-pkCol="@pkCol" asp-route-pkVal="@pkVal" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bản ghi này?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" style="background: none; border: none; color: #E63946; cursor: pointer; padding: 4px 6px;" title="Xóa">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                </form>
                                            </td>
                                            @foreach (var col in Model.Columns)
                                            {
                                                var val = row.ContainsKey(col.ColumnName) ? row[col.ColumnName] : null;
                                                <td>
                                                    @if (val == null)
                                                    {
                                                        <span style="color: var(--text-muted); font-style: italic;">NULL</span>
                                                    }
                                                    else if (val is bool b)
                                                    {
                                                        <span style="color: @(b ? "#52B788" : "#E63946"); font-weight: 600;">@(b ? "True" : "False")</span>
                                                    }
                                                    else
                                                    {
                                                        var strVal = val.ToString();
                                                        if (strVal != null && strVal.Length > 80)
                                                        {
                                                            <span title="@strVal">@(strVal[..77])...</span>
                                                        }
                                                        else
                                                        {
                                                            @strVal
                                                        }
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div style="display: flex; justify-content: center; gap: 8px; align-items: center;">
                                @if (Model.CurrentPage > 1)
                                {
                                    <a href="/admin/databaseconsole?table=@Model.TableName&page=@(Model.CurrentPage - 1)" class="btn-luxe-outline" style="padding: 6px 12px; font-size: 0.78rem;">&laquo; Trước</a>
                                }
                                <span style="font-size: 0.85rem; color: var(--text-muted); padding: 0 10px;">Trang @Model.CurrentPage / @Model.TotalPages</span>
                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <a href="/admin/databaseconsole?table=@Model.TableName&page=@(Model.CurrentPage + 1)" class="btn-luxe-outline" style="padding: 6px 12px; font-size: 0.78rem;">Tiếp &raquo;</a>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align: center; padding: 60px 20px; color: var(--text-muted); border: 1px dashed var(--border-card); border-radius: var(--radius-sm);">
                            <i class="fa-solid fa-inbox" style="font-size: 3rem; margin-bottom: 12px; opacity: 0.4;"></i>
                            <h4 style="font-size: 1.2rem; margin-bottom: 6px;">Bảng '@Model.TableName' Chưa Có Dữ Liệu</h4>
                            <p style="font-size: 0.88rem; margin-bottom: 16px;">Bạn có thể nhấn "Thêm Bản Ghi Mới" hoặc sang tab "Nạp Dữ Liệu Mẫu" để chạy nạp dữ liệu ban đầu.</p>
                            <button type="button" class="btn-luxe" onclick="openAddRowModal('@Model.TableName')">
                                <i class="fa-solid fa-plus"></i> Thêm Bản Ghi Đầu Tiên
                            </button>
                        </div>
                    }

                    <!-- Schema Inspector Drawer/Modal -->
                    <div id="schemaModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.7); z-index: 2500; align-items: center; justify-content: center;">
                        <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); max-width: 700px; width: 90%; max-height: 80vh; overflow-y: auto; padding: 24px; box-shadow: var(--shadow-luxury);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                                <h3 style="font-size: 1.25rem;"><i class="fa-solid fa-columns text-gold-gradient" style="margin-right: 6px;"></i> Cấu Trúc Bảng: @Model.TableName</h3>
                                <button type="button" onclick="toggleSchemaModal()" style="background: none; border: none; color: var(--text-muted); font-size: 1.2rem; cursor: pointer;"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                            <table class="data-table-custom">
                                <thead>
                                    <tr>
                                        <th>Cột</th>
                                        <th>Kiểu Dữ Liệu</th>
                                        <th>Độ Dài Tối Đa</th>
                                        <th>Nullable</th>
                                        <th>Khóa Chính</th>
                                        <th>Identity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.Columns)
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">@c.ColumnName</td>
                                            <td><code>@c.DataType</code></td>
                                            <td>@(c.MaxLength.HasValue ? c.MaxLength.Value.ToString() : "-")</td>
                                            <td>@(c.IsNullable ? "YES" : "NO")</td>
                                            <td>@(c.IsPrimaryKey ? "PK" : "-")</td>
                                            <td>@(c.IsIdentity ? "YES" : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TAB 2: SQL QUERY RUNNER -->
    <div id="queryTab" class="tab-content" style="display: none;">
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 24px;">
            <h3 style="font-size: 1.3rem; margin-bottom: 6px;"><i class="fa-solid fa-terminal text-gold-gradient" style="margin-right: 8px;"></i> SQL Query Runner (AWS Style)</h3>
            <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 16px;">
                Thực thi các câu lệnh truy vấn SQL trực tiếp trên cơ sở dữ liệu `PerfumeDb`. Hỗ trợ câu lệnh SELECT, JOIN, GROUP BY, v.v.
            </p>

            <div style="margin-bottom: 16px;">
                <textarea id="sqlQueryInput" rows="5" style="width: 100%; font-family: monospace; font-size: 0.9rem; background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); color: #48CAE4; padding: 16px; border-radius: var(--radius-sm); outline: none;">SELECT TOP 10 Id, Name, BasePrice, Concentration, RatingAverage FROM Products ORDER BY BasePrice DESC;</textarea>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div style="display: flex; gap: 10px;">
                    <button type="button" class="btn-luxe" onclick="runCustomQuery()">
                        <i class="fa-solid fa-play"></i> Thực Thi Truy Vấn (Run)
                    </button>
                    <button type="button" class="btn-luxe-outline" onclick="clearQueryInput()">
                        Xóa Lệnh
                    </button>
                </div>
                <div id="queryTimingInfo" style="font-size: 0.85rem; color: var(--gold-primary);"></div>
            </div>

            <div id="queryResultsWrapper" style="overflow-x: auto; min-height: 200px; border: 1px solid var(--border-card); border-radius: var(--radius-sm); padding: 12px; background: var(--bg-main);">
                <div style="text-align: center; padding: 60px 0; color: var(--text-muted);">
                    <i class="fa-solid fa-terminal" style="font-size: 2.5rem; margin-bottom: 10px; opacity: 0.3;"></i>
                    <p>Nhập câu lệnh SQL phía trên và nhấn "Thực Thi Truy Vấn" để xem kết quả.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 3: SEED DATA & SCRIPT LOADER -->
    <div id="seederTab" class="tab-content" style="display: none;">
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 24px; max-width: 900px; margin: 0 auto;">
            <div style="text-align: center; margin-bottom: 30px;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(212, 175, 55, 0.15); display: inline-flex; align-items: center; justify-content: center; color: var(--gold-primary); font-size: 1.8rem; margin-bottom: 16px;">
                    <i class="fa-solid fa-cloud-arrow-down"></i>
                </div>
                <h3 style="font-size: 1.6rem; margin-bottom: 8px;">Nạp Dữ Liệu Ban Đầu (Database Seeder)</h3>
                <p style="color: var(--text-secondary); font-size: 0.9rem; max-width: 650px; margin: 0 auto; line-height: 1.6;">
                    Đúng theo yêu cầu kiến trúc: <strong>Không hardcode dữ liệu mẫu trong mã nguồn C#</strong>. Toàn bộ dữ liệu 15+ chai nước hoa kinh điển (Dior Sauvage Elixir, Bleu de Chanel, Creed Aventus, Tom Ford, Kilian...) được định nghĩa trong file script riêng <code>scripts/seed_perfume_data.sql</code> và có thể nạp vào Database bằng nút bên dưới!
                </p>
            </div>

            <!-- 1-Click Seeder Action -->
            <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 24px; margin-bottom: 24px; text-align: center;">
                <h4 style="font-size: 1.15rem; color: var(--gold-primary); margin-bottom: 10px;">
                    <i class="fa-solid fa-wand-magic-sparkles" style="margin-right: 6px;"></i> Nạp Dữ Liệu Mẫu Tự Động (1-Click)
                </h4>
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 18px;">
                    Hệ thống sẽ đọc file <code>scripts/seed_perfume_data.sql</code> và nạp đầy đủ Brands, Categories, Fragrance Families, Notes, Products, Variants và Vouchers.
                </p>
                <button type="button" class="btn-luxe" id="btnExecuteSeed" onclick="executeDefaultSeed()" style="padding: 14px 32px; font-size: 0.95rem;">
                    <i class="fa-solid fa-bolt"></i> Nạp Ngay Bộ Dữ Liệu Nước Hoa Mẫu
                </button>
            </div>

            <!-- Custom Script Executor -->
            <div>
                <h4 style="font-size: 1.05rem; margin-bottom: 10px;"><i class="fa-solid fa-file-code" style="margin-right: 6px;"></i> Hoặc Thực Thi Tập Lệnh Tùy Chỉnh (Custom SQL Script):</h4>
                <textarea id="customScriptInput" rows="6" placeholder="Dán nội dung lệnh SQL (hỗ trợ phân tách lệnh bằng GO)..." style="width: 100%; font-family: monospace; font-size: 0.85rem; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 14px; border-radius: var(--radius-sm); outline: none; margin-bottom: 12px;"></textarea>
                <button type="button" class="btn-luxe-outline" onclick="executeCustomScript()">
                    <i class="fa-solid fa-play"></i> Chạy Tập Lệnh Này
                </button>
            </div>

            <!-- Execution Status Box -->
            <div id="seedStatusBox" style="margin-top: 20px; display: none;"></div>
        </div>
    </div>
</div>

<!-- DYNAMIC ADD / EDIT ROW MODAL -->
<div id="rowModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.7); z-index: 2600; align-items: center; justify-content: center;">
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); max-width: 650px; width: 90%; max-height: 85vh; overflow-y: auto; padding: 24px; box-shadow: var(--shadow-luxury);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 id="rowModalTitle" style="font-size: 1.3rem;"><i class="fa-solid fa-pen-to-square text-gold-gradient" style="margin-right: 6px;"></i> Thêm Bản Ghi Mới</h3>
            <button type="button" onclick="closeRowModal()" style="background: none; border: none; color: var(--text-muted); font-size: 1.2rem; cursor: pointer;"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <form id="rowForm" method="post" asp-action="SaveRow">
            @Html.AntiForgeryToken()
            <input type="hidden" name="table" id="rowFormTable" value="@activeTable" />
            <input type="hidden" name="pkCol" id="rowFormPkCol" value="" />
            <input type="hidden" name="pkVal" id="rowFormPkVal" value="" />

            <div id="rowFormFields" style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 20px;">
                <!-- Dynamically populated fields -->
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn-luxe-outline" onclick="closeRowModal()">Hủy</button>
                <button type="submit" class="btn-luxe">Lưu Bản Ghi</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .tab-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 600;
            padding: 12px 20px;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: var(--transition);
        }
        .tab-btn:hover {
            color: var(--text-primary);
        }
        .tab-btn.active {
            color: var(--gold-primary);
            border-bottom-color: var(--gold-primary);
        }
    </style>
}

@section Scripts {
    <script>
        function switchConsoleTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

            const target = document.getElementById(tabId);
            if (target) target.style.display = 'block';

            if (tabId === 'tableTab') document.getElementById('tableTabBtn')?.classList.add('active');
            if (tabId === 'queryTab') document.getElementById('queryTabBtn')?.classList.add('active');
            if (tabId === 'seederTab') document.getElementById('seederTabBtn')?.classList.add('active');
        }

        function filterTablesList() {
            const kw = document.getElementById('tableSearchInput').value.toLowerCase();
            document.querySelectorAll('#tablesNavList .table-list-item').forEach(item => {
                const name = item.querySelector('.table-name-text')?.innerText.toLowerCase() || '';
                item.style.display = name.includes(kw) ? 'flex' : 'none';
            });
        }

        function toggleSchemaModal() {
            const m = document.getElementById('schemaModal');
            if (m) m.style.display = m.style.display === 'flex' ? 'none' : 'flex';
        }

        async function openAddRowModal(tableName) {
            document.getElementById('rowModalTitle').innerText = `Thêm Bản Ghi Mới Vào [${tableName}]`;
            document.getElementById('rowFormTable').value = tableName;
            document.getElementById('rowFormPkCol').value = '';
            document.getElementById('rowFormPkVal').value = '';

            const res = await fetch(`/admin/databaseconsole/getcolumns?table=${tableName}`);
            const columns = await res.json();

            const container = document.getElementById('rowFormFields');
            container.innerHTML = '';

            columns.forEach(col => {
                if (col.isIdentity) return; // Skip identity auto-increment

                const div = document.createElement('div');
                div.innerHTML = `
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 4px; color: var(--text-secondary);">
                        ${col.columnName} <span style="font-size: 0.72rem; color: var(--gold-primary);">(${col.dataType})</span> ${col.isNullable ? '' : '<span style="color: #E63946;">*</span>'}
                    </label>
                    <input type="text" name="${col.columnName}" style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 8px 12px; border-radius: var(--radius-sm); outline: none; font-size: 0.88rem;" />
                `;
                container.appendChild(div);
            });

            document.getElementById('rowModal').style.display = 'flex';
        }

        async function openEditRowModal(tableName, pkCol, pkVal) {
            document.getElementById('rowModalTitle').innerText = `Chỉnh Sửa Bản Ghi [${tableName}] (${pkCol} = ${pkVal})`;
            document.getElementById('rowFormTable').value = tableName;
            document.getElementById('rowFormPkCol').value = pkCol;
            document.getElementById('rowFormPkVal').value = pkVal;

            const [colsRes, rowRes] = await Promise.all([
                fetch(`/admin/databaseconsole/getcolumns?table=${tableName}`),
                fetch(`/admin/databaseconsole/getrow?table=${tableName}&pkCol=${pkCol}&pkVal=${encodeURIComponent(pkVal)}`)
            ]);

            const columns = await colsRes.json();
            const rowData = await rowRes.json();

            const container = document.getElementById('rowFormFields');
            container.innerHTML = '';

            columns.forEach(col => {
                const val = rowData[col.columnName.toLowerCase()] ?? rowData[col.columnName] ?? '';
                const isReadOnly = col.isPrimaryKey || col.isIdentity;

                const div = document.createElement('div');
                div.innerHTML = `
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 4px; color: var(--text-secondary);">
                        ${col.columnName} <span style="font-size: 0.72rem; color: var(--gold-primary);">(${col.dataType})</span>
                    </label>
                    <input type="text" name="${col.columnName}" value="${val ?? ''}" ${isReadOnly ? 'readonly style="opacity: 0.6;"' : ''} style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 8px 12px; border-radius: var(--radius-sm); outline: none; font-size: 0.88rem;" />
                `;
                container.appendChild(div);
            });

            document.getElementById('rowModal').style.display = 'flex';
        }

        function closeRowModal() {
            document.getElementById('rowModal').style.display = 'none';
        }

        async function runCustomQuery() {
            const sql = document.getElementById('sqlQueryInput').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const timing = document.getElementById('queryTimingInfo');
            const wrapper = document.getElementById('queryResultsWrapper');

            timing.innerText = 'Đang thực thi...';

            try {
                const res = await fetch('/admin/databaseconsole/executequery', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ sql })
                });
                const data = await res.json();

                if (!data.success) {
                    timing.innerText = `Lỗi (${data.elapsedMilliseconds} ms)`;
                    wrapper.innerHTML = `<div style="color: #E63946; padding: 16px;"><i class="fa-solid fa-triangle-exclamation"></i> Lỗi: ${data.errorMessage}</div>`;
                    return;
                }

                timing.innerText = `Thành công trong ${data.elapsedMilliseconds} ms &bull; ${data.rowsAffected} dòng ảnh hưởng/kết quả`;

                if (!data.columnNames || data.columnNames.length === 0) {
                    wrapper.innerHTML = `<div style="color: #52B788; padding: 16px;"><i class="fa-solid fa-circle-check"></i> Câu lệnh đã chạy thành công. Không có tập kết quả trả về.</div>`;
                    return;
                }

                let html = '<table class="data-table-custom"><thead><tr>';
                data.columnNames.forEach(col => {
                    html += `<th>${col}</th>`;
                });
                html += '</tr></thead><tbody>';

                data.rows.forEach(r => {
                    html += '<tr>';
                    data.columnNames.forEach(col => {
                        const val = r[col.toLowerCase()] ?? r[col];
                        html += `<td>${val === null ? '<span style="color:var(--text-muted); font-style:italic;">NULL</span>' : val}</td>`;
                    });
                    html += '</tr>';
                });
                html += '</tbody></table>';

                wrapper.innerHTML = html;
            } catch (err) {
                timing.innerText = 'Lỗi kết nối';
                wrapper.innerHTML = `<div style="color: #E63946; padding: 16px;">${err.message}</div>`;
            }
        }

        function clearQueryInput() {
            document.getElementById('sqlQueryInput').value = '';
        }

        async function executeDefaultSeed() {
            const btn = document.getElementById('btnExecuteSeed');
            const box = document.getElementById('seedStatusBox');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang nạp dữ liệu từ file SQL...';
            box.style.display = 'block';
            box.innerHTML = '<div style="color: var(--gold-primary);"><i class="fa-solid fa-spinner fa-spin"></i> Đang đọc và thực thi scripts/seed_perfume_data.sql...</div>';

            try {
                const res = await fetch('/admin/databaseconsole/loaddefaultseedscript', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                const data = await res.json();

                if (data.success) {
                    box.innerHTML = `
                        <div style="background: rgba(82, 183, 136, 0.15); border: 1px solid rgba(82, 183, 136, 0.4); color: #52B788; padding: 16px; border-radius: var(--radius-sm);">
                            <h4 style="margin-bottom: 4px;"><i class="fa-solid fa-circle-check"></i> Nạp Dữ Liệu Thành Công Rực Rỡ!</h4>
                            <p style="font-size: 0.85rem;">Thời gian: ${data.elapsed} ms &bull; Đã nạp thành công bộ sưu tập nước hoa, thương hiệu, nốt hương và vouchers.</p>
                            <a href="/admin/databaseconsole" class="btn-luxe" style="display: inline-block; margin-top: 10px; padding: 8px 18px; font-size: 0.8rem;">Làm Mới Bảng Dữ Liệu</a>
                        </div>`;
                } else {
                    box.innerHTML = `
                        <div style="background: rgba(230, 57, 70, 0.15); border: 1px solid rgba(230, 57, 70, 0.4); color: #E63946; padding: 16px; border-radius: var(--radius-sm);">
                            <i class="fa-solid fa-triangle-exclamation"></i> Lỗi: ${data.errorMessage}
                        </div>`;
                }
            } catch (err) {
                box.innerHTML = `<div style="color: #E63946;">Lỗi mạng: ${err.message}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-bolt"></i> Nạp Ngay Bộ Dữ Liệu Nước Hoa Mẫu';
            }
        }
    </script>
}
