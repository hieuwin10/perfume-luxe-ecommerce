@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}

<section style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px; background: var(--bg-page);">
    <div style="width: 100%; max-width: 480px;">

        <!-- Logo -->
        <div style="text-align: center; margin-bottom: 36px;">
            <a href="/" style="text-decoration: none;">
                <div class="text-gold-gradient" style="font-size: 1.9rem; font-weight: 900; letter-spacing: 0.12em; font-family: 'Georgia', serif;">PERFUME LUXE</div>
                <div style="font-size: 0.72rem; color: var(--text-muted); letter-spacing: 0.25em; text-transform: uppercase; margin-top: 2px;">Haute Parfumerie Paris</div>
            </a>
            <h1 style="font-size: 1.5rem; font-weight: 700; margin: 24px 0 8px; color: var(--text-primary);">Tạo tài khoản mới</h1>
            <p style="color: var(--text-secondary); font-size: 0.9rem;">Tham gia cộng đồng yêu mùi hương cao cấp</p>
        </div>

        <div id="registerError" role="alert" hidden="@(ViewBag.Error == null ? "hidden" : null)" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; color: #f87171; font-size: 0.88rem;">
            @if (ViewBag.Error != null) { <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.Error }
        </div>

        <div class="luxury-card" style="padding: 36px;">
            <form method="post" action="/account/register" id="customerRegisterForm">
                @Html.AntiForgeryToken()

                <!-- Full Name -->
                <div style="margin-bottom: 18px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; letter-spacing: 0.05em; text-transform: uppercase;">Họ Và Tên</label>
                    <div style="position: relative;">
                        <i class="fa-solid fa-user" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;"></i>
                        <input type="text" name="fullName" id="regFullName" placeholder="Nguyễn Văn A" required
                               style="width: 100%; padding: 13px 14px 13px 40px; background: var(--bg-input, rgba(255,255,255,0.06)); border: 1px solid var(--border-card); border-radius: 10px; color: var(--text-primary); font-size: 0.95rem; outline: none; box-sizing: border-box; transition: border-color 0.2s;"
                               onfocus="this.style.borderColor='var(--gold-primary)'" onblur="this.style.borderColor='var(--border-card)'" />
                    </div>
                    <span class="field-validation-error text-danger" id="nameValError" style="display: none; color: #f87171; font-size: 0.8rem; margin-top: 6px;">Vui lòng nhập họ và tên của bạn.</span>
                </div>

                <!-- Email -->
                <div style="margin-bottom: 18px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; letter-spacing: 0.05em; text-transform: uppercase;">Email</label>
                    <div style="position: relative;">
                        <i class="fa-solid fa-envelope" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;"></i>
                        <input type="email" name="email" id="regEmail" placeholder="example@email.com" required
                               style="width: 100%; padding: 13px 14px 13px 40px; background: var(--bg-input, rgba(255,255,255,0.06)); border: 1px solid var(--border-card); border-radius: 10px; color: var(--text-primary); font-size: 0.95rem; outline: none; box-sizing: border-box; transition: border-color 0.2s;"
                               onfocus="this.style.borderColor='var(--gold-primary)'" onblur="this.style.borderColor='var(--border-card)'" />
                    </div>
                    <span class="field-validation-error text-danger" id="emailValError" style="display: none; color: #f87171; font-size: 0.8rem; margin-top: 6px;">Vui lòng nhập địa chỉ email hợp lệ.</span>
                </div>

                <!-- Password -->
                <div style="margin-bottom: 18px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; letter-spacing: 0.05em; text-transform: uppercase;">Mật Khẩu</label>
                    <div style="position: relative;">
                        <i class="fa-solid fa-lock" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;"></i>
                        <input type="password" name="password" id="regPassword" placeholder="Tối thiểu 10 ký tự, có chữ hoa, số và ký tự đặc biệt" minlength="10" autocomplete="new-password" required
                               style="width: 100%; padding: 13px 44px 13px 40px; background: var(--bg-input, rgba(255,255,255,0.06)); border: 1px solid var(--border-card); border-radius: 10px; color: var(--text-primary); font-size: 0.95rem; outline: none; box-sizing: border-box; transition: border-color 0.2s;"
                               onfocus="this.style.borderColor='var(--gold-primary)'" onblur="this.style.borderColor='var(--border-card)'" />
                        <button type="button" onclick="togglePass('regPassword', 'eyeReg1')" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 4px;">
                            <i id="eyeReg1" class="fa-solid fa-eye-slash"></i>
                        </button>
                    </div>
                    <span class="field-validation-error text-danger" id="passValError" style="display: none; color: #f87171; font-size: 0.8rem; margin-top: 6px;">Mật khẩu tối thiểu 10 ký tự, bao gồm chữ hoa, thường, số và ký tự đặc biệt.</span>
                </div>

                <!-- Confirm Password -->
                <div style="margin-bottom: 28px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; letter-spacing: 0.05em; text-transform: uppercase;">Xác Nhận Mật Khẩu</label>
                    <div style="position: relative;">
                        <i class="fa-solid fa-lock" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;"></i>
                        <input type="password" name="confirmPassword" id="regConfirmPassword" placeholder="Nhập lại mật khẩu" minlength="10" autocomplete="new-password" required
                               style="width: 100%; padding: 13px 44px 13px 40px; background: var(--bg-input, rgba(255,255,255,0.06)); border: 1px solid var(--border-card); border-radius: 10px; color: var(--text-primary); font-size: 0.95rem; outline: none; box-sizing: border-box; transition: border-color 0.2s;"
                               onfocus="this.style.borderColor='var(--gold-primary)'" onblur="this.style.borderColor='var(--border-card)'" />
                        <button type="button" onclick="togglePass('regConfirmPassword', 'eyeReg2')" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 4px;">
                            <i id="eyeReg2" class="fa-solid fa-eye-slash"></i>
                        </button>
                    </div>
                    <span class="field-validation-error text-danger" id="confirmValError" style="display: none; color: #f87171; font-size: 0.8rem; margin-top: 6px;">Mật khẩu xác nhận không khớp với mật khẩu đã nhập.</span>
                </div>

                <button type="submit" class="btn-luxe" style="width: 100%; padding: 14px; font-size: 1rem; font-weight: 700; letter-spacing: 0.05em;">
                    <i class="fa-solid fa-user-plus" style="margin-right: 8px;"></i> Tạo Tài Khoản
                </button>
            </form>

            <div style="display: flex; align-items: center; gap: 12px; margin: 24px 0;">
                <div style="flex: 1; height: 1px; background: var(--border-card);"></div>
                <span style="color: var(--text-muted); font-size: 0.8rem;">hoặc</span>
                <div style="flex: 1; height: 1px; background: var(--border-card);"></div>
            </div>

            <div style="text-align: center;">
                <span style="color: var(--text-secondary); font-size: 0.9rem;">Đã có tài khoản? </span>
                <a href="/account/login" style="color: var(--gold-primary); font-weight: 600; text-decoration: none;">Đăng Nhập</a>
            </div>
        </div>

        <!-- Membership perks -->
        <div style="margin-top: 24px; background: rgba(212,175,55,0.07); border: 1px solid rgba(212,175,55,0.2); border-radius: 12px; padding: 18px 20px;">
            <div style="font-size: 0.82rem; font-weight: 700; color: var(--gold-primary); margin-bottom: 10px; letter-spacing: 0.08em; text-transform: uppercase;">
                <i class="fa-solid fa-crown" style="margin-right: 6px;"></i> Quyền lợi thành viên
            </div>
            <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px;">
                <li style="font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-check" style="color: var(--gold-primary); font-size: 0.75rem;"></i> Theo dõi đơn hàng realtime
                </li>
                <li style="font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-check" style="color: var(--gold-primary); font-size: 0.75rem;"></i> Nhận voucher ưu đãi độc quyền thành viên
                </li>
                <li style="font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-check" style="color: var(--gold-primary); font-size: 0.75rem;"></i> Tích lũy điểm Loyalty, đổi quà cao cấp
                </li>
            </ul>
        </div>
    </div>
</section>

@section Scripts {
<script>
    function togglePass(id, iconId) {
        const input = document.getElementById(id);
        const icon = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'fa-solid fa-eye';
        } else {
            input.type = 'password';
            icon.className = 'fa-solid fa-eye-slash';
        }
    }

    const regFullName = document.getElementById('regFullName');
    const regEmail = document.getElementById('regEmail');
    const regPassword = document.getElementById('regPassword');
    const regConfirmPassword = document.getElementById('regConfirmPassword');

    const nameValError = document.getElementById('nameValError');
    const emailValError = document.getElementById('emailValError');
    const passValError = document.getElementById('passValError');
    const confirmValError = document.getElementById('confirmValError');

    regFullName?.addEventListener('input', () => {
        nameValError.style.display = 'none';
        regFullName.style.borderColor = 'var(--border-card)';
    });
    regEmail?.addEventListener('input', () => {
        emailValError.style.display = 'none';
        regEmail.style.borderColor = 'var(--border-card)';
    });
    regPassword?.addEventListener('input', () => {
        passValError.style.display = 'none';
        regPassword.style.borderColor = 'var(--border-card)';
    });
    regConfirmPassword?.addEventListener('input', () => {
        confirmValError.style.display = 'none';
        regConfirmPassword.style.borderColor = 'var(--border-card)';
    });

    document.getElementById('customerRegisterForm')?.addEventListener('submit', async event => {
        event.preventDefault();
        const form = event.currentTarget;
        const button = form.querySelector('button[type="submit"]');
        const error = document.getElementById('registerError');

        let isValid = true;
        if (!regFullName.value.trim()) {
            nameValError.style.display = 'block';
            regFullName.style.borderColor = '#f87171';
            isValid = false;
        }

        const emailVal = regEmail.value.trim();
        if (!emailVal || !emailVal.includes('@@') || !emailVal.includes('.')) {
            emailValError.style.display = 'block';
            regEmail.style.borderColor = '#f87171';
            isValid = false;
        }

        const passVal = regPassword.value;
        if (!passVal || passVal.length < 10) {
            passValError.style.display = 'block';
            regPassword.style.borderColor = '#f87171';
            isValid = false;
        }

        const confirmVal = regConfirmPassword.value;
        if (!confirmVal || confirmVal !== passVal) {
            confirmValError.style.display = 'block';
            regConfirmPassword.style.borderColor = '#f87171';
            isValid = false;
        }

        if (!isValid) return;

        const fields = new FormData(form);
        error.hidden = true;
        button.disabled = true;
        try {
            const result = await CustomerApi.post('/api/v1/auth/register', {
                fullName: fields.get('fullName'), email: fields.get('email'),
                password: fields.get('password'), confirmPassword: fields.get('confirmPassword')
            });
            window.location.assign(result.redirectUrl || '/account/profile');
        } catch (failure) {
            error.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> ${failure.message || 'Chưa tạo được tài khoản.'}`;
            error.hidden = false;
        } finally { button.disabled = false; }
    });
</script>
}
