@model List<Perfume.Domain.Entities.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<div style="max-width:1100px;margin:40px auto;padding:0 20px">
    <h1>Đơn hàng của tôi</h1>
    @if (Model.Count == 0) { <div class="luxury-card" style="padding:24px">Bạn chưa có đơn hàng nào.</div> }
    @foreach (var order in Model)
    {
        <article class="luxury-card" style="padding:18px;margin:14px 0;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap">
            <div><strong>@order.OrderCode</strong><p>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @order.OrderStatus · @order.PaymentStatus</p></div>
            <div><strong>@order.TotalAmount.ToString("N0") ₫</strong><p>@order.Items.Count sản phẩm</p></div>
            <a href="/account/orderdetails/@order.Id">Xem chi tiết</a>
        </article>
    }
</div>