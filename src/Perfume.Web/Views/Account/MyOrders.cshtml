@model List<Perfume.Domain.Entities.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<main class="customer-page customer-orders-page" style="max-width:1100px;margin:42px auto;padding:0 20px">
    <div style="display:flex;justify-content:space-between;align-items:end;gap:18px;flex-wrap:wrap;margin-bottom:24px">
        <div><p class="eyebrow">Tài khoản khách hàng</p><h1 style="margin:4px 0">Đơn hàng của tôi</h1><p style="color:var(--text-secondary);margin:6px 0 0">Theo dõi tình trạng giao hàng và thông tin thanh toán.</p></div>
        <a href="/bo-suu-tap" class="btn-luxe-outline">Tiếp tục mua sắm</a>
    </div>
    <div id="ordersMessage" role="status" style="padding:18px;border:1px solid var(--border-card);border-radius:12px;color:var(--text-secondary)">Đang tải đơn hàng…</div>
    <div id="ordersList" style="display:grid;gap:14px"></div>
</main>
@section Styles {
<style>
.customer-order-card{padding:20px 22px;border:1px solid var(--border-card);border-radius:14px;background:var(--bg-surface);display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center}
.customer-order-card p{margin:7px 0;color:var(--text-secondary);font-size:.88rem}
.customer-order-status{display:inline-flex;padding:5px 10px;border-radius:99px;background:rgba(212,175,55,.12);color:var(--gold-primary);font-size:.78rem;font-weight:700}
@@media(max-width:620px){.customer-order-card{grid-template-columns:1fr}.customer-order-card>a{justify-self:start}}
</style>
}
@section Scripts {
<script>
const statusNames = { Pending:'Chờ xác nhận', Confirmed:'Đã xác nhận', Shipping:'Đang giao', Delivered:'Đã giao', Cancelled:'Đã hủy' };
const payNames = { Pending:'Chờ thu COD', Completed:'Đã thanh toán', Failed:'Thanh toán lỗi', Refunded:'Đã hoàn tiền' };
const moneyOrder = value => new Intl.NumberFormat('vi-VN',{style:'currency',currency:'VND'}).format(value||0);
(async function loadOrders(){
    const message=document.getElementById('ordersMessage'), list=document.getElementById('ordersList');
    try {
        const orders=await CustomerApi.get('/api/v1/customer/orders');
        if(!orders.length){message.innerHTML='<strong>Bạn chưa có đơn hàng.</strong><p style="margin:8px 0 0">Những đơn bạn đặt sẽ xuất hiện tại đây.</p>';return;}
        message.hidden=true;
        list.innerHTML=orders.map(order=>`<article class="customer-order-card">
            <div><strong>${CustomerApi.escapeHtml(order.orderCode)}</strong><p>${new Date(order.createdAt).toLocaleString('vi-VN')} · ${order.items.length} sản phẩm · ${payNames[order.paymentStatus]||CustomerApi.escapeHtml(order.paymentStatus)}</p><span class="customer-order-status">${statusNames[order.orderStatus]||CustomerApi.escapeHtml(order.orderStatus)}</span></div>
            <div style="text-align:right"><strong style="color:var(--gold-primary);font-size:1.05rem">${moneyOrder(order.totalAmount)}</strong><p><a href="/account/orderdetails/${order.id}" style="color:var(--gold-primary)">Xem chi tiết <i class="fa-solid fa-arrow-right"></i></a></p></div>
        </article>`).join('');
    } catch(error){message.textContent=error.message||'Chưa tải được đơn hàng. Vui lòng thử lại.';}
})();
</script>
}
