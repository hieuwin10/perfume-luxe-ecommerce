@{
    ViewData["Title"] = "Tạo mật khẩu mới";
}
<section style="min-height:65vh;display:flex;align-items:center;justify-content:center;padding:48px 20px;background:var(--bg-page)">
    <div class="luxury-card" style="width:100%;max-width:520px;padding:32px">
        <a href="/" class="text-gold-gradient" style="font-weight:900;letter-spacing:.12em">PERFUME LUXE</a>
        <h1 style="margin:22px 0 8px">Tạo mật khẩu mới</h1>
        <p style="color:var(--text-secondary)">Đặt mật khẩu mới cho tài khoản của bạn.</p>
        <div id="resetMessage" role="status" hidden style="margin:16px 0;padding:12px;border-radius:8px"></div>
        <form id="resetPasswordForm" style="display:grid;gap:16px;margin-top:22px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <label>Mật khẩu mới
                <input type="password" name="newPassword" required minlength="10" maxlength="100" autocomplete="new-password" style="width:100%;margin-top:6px;padding:12px;background:var(--bg-surface-elevated);border:1px solid var(--border-card);border-radius:8px;color:var(--text-primary)" />
            </label>
            <label>Xác nhận mật khẩu
                <input type="password" name="confirmPassword" required minlength="10" maxlength="100" autocomplete="new-password" style="width:100%;margin-top:6px;padding:12px;background:var(--bg-surface-elevated);border:1px solid var(--border-card);border-radius:8px;color:var(--text-primary)" />
            </label>
            <button class="btn-luxe" type="submit">Đổi mật khẩu</button>
        </form>
    </div>
</section>
@section Scripts {
<script>
document.getElementById('resetPasswordForm')?.addEventListener('submit', async event => {
    event.preventDefault();
    const form = event.currentTarget;
    const values = new FormData(form);
    const message = document.getElementById('resetMessage');
    const button = form.querySelector('button[type="submit"]');
    if (values.get('newPassword') !== values.get('confirmPassword')) {
        message.textContent = 'Mật khẩu xác nhận không khớp.';
        message.style.cssText = 'margin:16px 0;padding:12px;border-radius:8px;color:#f87171;background:rgba(239,68,68,.12)';
        message.hidden = false;
        return;
    }
    button.disabled = true;
    try {
        const result = await CustomerApi.post('/api/v1/auth/password/reset', {
            email: values.get('email'), token: values.get('token'),
            newPassword: values.get('newPassword'), confirmPassword: values.get('confirmPassword')
        });
        message.textContent = result.message;
        message.style.cssText = 'margin:16px 0;padding:12px;border-radius:8px;color:#52b788;background:rgba(82,183,136,.12)';
        form.hidden = true;
        setTimeout(() => window.location.assign('/account/login'), 1200);
    } catch (error) {
        message.textContent = error.message || 'Chưa đổi được mật khẩu.';
        message.style.cssText = 'margin:16px 0;padding:12px;border-radius:8px;color:#f87171;background:rgba(239,68,68,.12)';
    } finally { message.hidden = false; button.disabled = false; }
});
</script>
}
