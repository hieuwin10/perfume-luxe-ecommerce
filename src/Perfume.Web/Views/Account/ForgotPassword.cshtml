@{
    ViewData["Title"] = "Quên mật khẩu";
}
<section style="min-height:65vh;display:flex;align-items:center;justify-content:center;padding:48px 20px;background:var(--bg-page)">
    <div class="luxury-card" style="width:100%;max-width:520px;padding:32px">
        <a href="/" class="text-gold-gradient" style="font-weight:900;letter-spacing:.12em">PERFUME LUXE</a>
        <h1 style="margin:22px 0 8px">Đặt lại mật khẩu</h1>
        <p style="color:var(--text-secondary)">Nhập email tài khoản. Nếu email hợp lệ, hướng dẫn đặt lại sẽ được gửi đến hộp thư của bạn.</p>
        <div id="forgotMessage" role="status" hidden style="margin:16px 0;padding:12px;border-radius:8px"></div>
        <form id="forgotPasswordForm" style="display:grid;gap:16px;margin-top:22px">
            @Html.AntiForgeryToken()
            <label>Email
                <input type="email" name="email" required maxlength="254" autocomplete="email" style="width:100%;margin-top:6px;padding:12px;background:var(--bg-surface-elevated);border:1px solid var(--border-card);border-radius:8px;color:var(--text-primary)" />
            </label>
            <button class="btn-luxe" type="submit">Gửi hướng dẫn</button>
        </form>
        <a href="/account/login" style="display:inline-block;margin-top:18px;color:var(--gold-primary)">Quay lại đăng nhập</a>
    </div>
</section>
@section Scripts {
<script>
document.getElementById('forgotPasswordForm')?.addEventListener('submit', async event => {
    event.preventDefault();
    const form = event.currentTarget;
    const button = form.querySelector('button[type="submit"]');
    const message = document.getElementById('forgotMessage');
    button.disabled = true;
    try {
        const result = await CustomerApi.post('/api/v1/auth/password/forgot', { email: new FormData(form).get('email') });
        message.textContent = result.message;
        message.style.cssText = 'margin:16px 0;padding:12px;border-radius:8px;color:#52b788;background:rgba(82,183,136,.12)';
    } catch (error) {
        message.textContent = error.message || 'Chưa gửi được yêu cầu.';
        message.style.cssText = 'margin:16px 0;padding:12px;border-radius:8px;color:#f87171;background:rgba(239,68,68,.12)';
    } finally { message.hidden = false; button.disabled = false; }
});
</script>
}
