@{
    ViewData["Title"] = "Truy Cập Bị Từ Chối";
}

<section style="min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 60px 20px;">
    <div style="text-align: center; max-width: 480px;">
        <div style="font-size: 5rem; margin-bottom: 20px; color: var(--gold-primary); opacity: 0.7;">
            <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h1 style="font-size: 2rem; font-weight: 800; color: var(--text-primary); margin-bottom: 12px;">Truy Cập Bị Từ Chối</h1>
        <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.6; margin-bottom: 32px;">
            Bạn không có quyền truy cập vào trang này. Vui lòng đăng nhập bằng tài khoản có quyền phù hợp.
        </p>
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="/account/login" class="btn-luxe" style="padding: 12px 28px;">
                <i class="fa-solid fa-right-to-bracket" style="margin-right: 8px;"></i> Đăng Nhập
            </a>
            <a href="/" class="btn-luxe-outline" style="padding: 12px 28px;">
                <i class="fa-solid fa-house" style="margin-right: 8px;"></i> Về Trang Chủ
            </a>
        </div>
    </div>
</section>
