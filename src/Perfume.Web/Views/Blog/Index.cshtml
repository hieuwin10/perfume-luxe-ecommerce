@model List<BlogPost>
@{
    ViewData["Title"] ??= "Tạp Chí Mùi Hương & Cẩm Nang Haute Parfumerie";
    ViewData["MetaDescription"] ??= "Khám phá nghệ thuật nước hoa, cách chọn hương theo phong cách và những gợi ý tinh tế giúp bạn tìm mùi hương phù hợp.";
    var categories = ViewBag.Categories as List<BlogCategory> ?? new List<BlogCategory>();
    var currentCat = ViewBag.CurrentCategory as string;
    var heroPost = ViewBag.HeroPost as BlogPost;
    var gridPosts = heroPost != null ? Model.Where(p => p.Id != heroPost.Id).ToList() : Model;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<style>
    .blog-hero-card {
        background: linear-gradient(135deg, rgba(26,26,26,0.95), rgba(15,15,15,0.95));
        border: 1px solid rgba(212, 175, 55, 0.35);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        transition: transform 0.3s ease, border-color 0.3s ease;
        margin-bottom: 50px;
    }
    .blog-hero-card:hover {
        border-color: var(--gold-primary);
        transform: translateY(-3px);
    }
    .blog-cat-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 18px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
        border: 1px solid var(--border-card);
        color: var(--text-secondary);
        background: var(--bg-surface);
    }
    .blog-cat-pill:hover, .blog-cat-pill.active {
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.2), rgba(212, 175, 55, 0.05));
        border-color: var(--gold-primary);
        color: var(--gold-primary);
        box-shadow: 0 0 15px rgba(212, 175, 55, 0.25);
    }
    .blog-grid-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-card);
        border-radius: var(--radius-md);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all 0.35s ease;
    }
    .blog-grid-card:hover {
        transform: translateY(-6px);
        border-color: var(--gold-primary);
        box-shadow: 0 15px 30px rgba(0,0,0,0.4);
    }
    .blog-grid-card:hover .blog-thumb {
        transform: scale(1.06);
    }
    .blog-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .pagination-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-card);
        background: var(--bg-surface);
        color: var(--text-primary);
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .pagination-link.active, .pagination-link:hover {
        background: var(--gold-primary);
        color: #000;
        border-color: var(--gold-primary);
    }
</style>

<div style="max-width: 1240px; margin: 40px auto; padding: 0 24px;">
    <!-- Header Gazette -->
    <div style="text-align: center; margin-bottom: 40px;">
        <span style="display: inline-block; padding: 4px 16px; background: rgba(212,175,55,0.12); border: 1px solid rgba(212,175,55,0.3); border-radius: 20px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.25em; color: var(--gold-primary); font-weight: 700; margin-bottom: 12px;">
            <i class="fa-solid fa-feather-pointed" style="margin-right: 6px;"></i>Haute Parfumerie Gazette
        </span>
        <h1 style="font-size: 3rem; margin: 0 0 16px; font-family: var(--font-serif); font-weight: 700; letter-spacing: -0.02em;">
            Tạp Chí Nghệ Thuật Mùi Hương
        </h1>
        <p style="color: var(--text-secondary); max-width: 700px; margin: 0 auto; font-size: 1rem; line-height: 1.8;">
            Khám phá những bí mật chế tác đằng sau các kiệt tác nước hoa kinh điển thế giới, triết lý hương thơm Niche độc bản và cẩm nang định hình thần thái quý tộc.
        </p>
    </div>

    <!-- Category Filter Tabs -->
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-bottom: 45px;">
        <a href="/blog" class="blog-cat-pill @(string.IsNullOrWhiteSpace(currentCat) ? "active" : "")">
            <i class="fa-solid fa-layer-group"></i> Tất Cả Chủ Đề
            <span style="font-size: 0.75rem; opacity: 0.75;">(@(ViewBag.TotalCount ?? Model.Count))</span>
        </a>
        @foreach (var cat in categories)
        {
            <a href="/blog?category=@cat.Slug" class="blog-cat-pill @(currentCat == cat.Slug ? "active" : "")">
                <i class="fa-solid fa-bookmark"></i> @cat.Name
                <span style="font-size: 0.75rem; opacity: 0.75;">(@cat.Posts.Count)</span>
            </a>
        }
    </div>

    <!-- Hero Article (Khi trang 1 và không filter) -->
    @if (heroPost != null)
    {
        <div class="blog-hero-card">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));">
                <div style="position: relative; min-height: 380px; overflow: hidden;">
                    <img src="@(heroPost.ThumbnailUrl ?? "https://images.unsplash.com/photo-1547887537-6158d64c35b3?auto=format&fit=crop&w=1200&q=80")" 
                         alt="@heroPost.Title" 
                         style="width: 100%; height: 100%; object-fit: cover;" />
                    <div style="position: absolute; top: 20px; left: 20px; background: rgba(0,0,0,0.75); backdrop-filter: blur(8px); border: 1px solid var(--gold-primary); color: var(--gold-primary); padding: 5px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;">
                        <i class="fa-solid fa-star" style="margin-right: 5px;"></i>Tâm Điểm Tuần Này
                    </div>
                </div>
                <div style="padding: 40px 48px; display: flex; flex-direction: column; justify-content: center;">
                    <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 16px; font-size: 0.8rem; color: var(--text-muted);">
                        <span style="color: var(--gold-primary); text-transform: uppercase; font-weight: 700; letter-spacing: 0.1em;">
                            @(heroPost.Category?.Name ?? "Chuyên Sâu")
                        </span>
                        <span>•</span>
                        <span><i class="fa-regular fa-clock" style="margin-right: 4px;"></i>@heroPost.CreatedAt.ToString("dd/MM/yyyy")</span>
                        <span>•</span>
                        <span><i class="fa-solid fa-eye" style="margin-right: 4px;"></i>@heroPost.ViewCount lượt đọc</span>
                    </div>
                    <h2 style="font-size: 2rem; line-height: 1.35; margin-bottom: 16px; font-family: var(--font-serif);">
                        <a href="/blog/@heroPost.Slug" style="color: var(--text-primary); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--gold-primary)'" onmouseout="this.style.color='var(--text-primary)'">
                            @heroPost.Title
                        </a>
                    </h2>
                    <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.8; margin-bottom: 28px;">
                        @heroPost.Summary
                    </p>
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <div style="width: 38px; height: 38px; border-radius: 50%; background: rgba(212,175,55,0.2); border: 1px solid var(--gold-primary); display: flex; align-items: center; justify-content: center; color: var(--gold-primary); font-size: 0.9rem;">
                                <i class="fa-solid fa-pen-nib"></i>
                            </div>
                            <div>
                                <div style="font-size: 0.85rem; font-weight: 600; color: var(--text-primary);">@heroPost.AuthorName</div>
                                <div style="font-size: 0.72rem; color: var(--text-muted);">Biên Tập Viên Cao Cấp</div>
                            </div>
                        </div>
                        <a href="/blog/@heroPost.Slug" class="btn-luxe-primary" style="padding: 10px 24px; font-size: 0.85rem;">
                            Đọc Bài Viết <i class="fa-solid fa-arrow-right" style="margin-left: 8px;"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Articles Grid -->
    @if (gridPosts.Any())
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 32px; margin-bottom: 50px;">
            @foreach (var post in gridPosts)
            {
                <article class="blog-grid-card">
                    <a href="/blog/@post.Slug" style="display: block; width: 100%; height: 230px; overflow: hidden; position: relative;">
                        <img class="blog-thumb" src="@(post.ThumbnailUrl ?? "https://images.unsplash.com/photo-1547887537-6158d64c35b3?auto=format&fit=crop&w=800&q=80")" alt="@post.Title" />
                        <span style="position: absolute; bottom: 12px; left: 12px; background: rgba(0,0,0,0.7); backdrop-filter: blur(6px); color: var(--gold-primary); padding: 4px 10px; border-radius: 12px; font-size: 0.72rem; font-weight: 600; text-transform: uppercase;">
                            @(post.Category?.Name ?? "Kiến Thức")
                        </span>
                    </a>
                    <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-size: 0.75rem; color: var(--text-muted);">
                            <span><i class="fa-regular fa-calendar" style="margin-right: 4px;"></i>@post.CreatedAt.ToString("dd/MM/yyyy")</span>
                            <span><i class="fa-solid fa-eye" style="margin-right: 4px;"></i>@post.ViewCount lượt đọc</span>
                        </div>
                        <h2 style="font-size: 1.25rem; margin-bottom: 12px; line-height: 1.4; font-family: var(--font-serif); flex-grow: 0;">
                            <a href="/blog/@post.Slug" style="color: var(--text-primary); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--gold-primary)'" onmouseout="this.style.color='var(--text-primary)'">
                                @post.Title
                            </a>
                        </h2>
                        <p style="color: var(--text-secondary); font-size: 0.88rem; line-height: 1.65; margin-bottom: 22px; flex-grow: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @post.Summary
                        </p>
                        <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-card); padding-top: 14px; margin-top: auto;">
                            <span style="font-size: 0.78rem; color: var(--text-muted);">
                                <i class="fa-solid fa-user-pen" style="margin-right: 4px; color: var(--gold-primary);"></i>@post.AuthorName
                            </span>
                            <a href="/blog/@post.Slug" style="font-size: 0.82rem; color: var(--gold-primary); text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                Khám phá <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div style="display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 40px;">
                @if (currentPage > 1)
                {
                    <a href="/blog?page=@(currentPage - 1)@(string.IsNullOrWhiteSpace(currentCat) ? "" : $"&category={currentCat}")" class="pagination-link">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="/blog?page=@i@(string.IsNullOrWhiteSpace(currentCat) ? "" : $"&category={currentCat}")" class="pagination-link @(i == currentPage ? "active" : "")">
                        @i
                    </a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="/blog?page=@(currentPage + 1)@(string.IsNullOrWhiteSpace(currentCat) ? "" : $"&category={currentCat}")" class="pagination-link">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div style="text-align: center; padding: 70px 20px; background: var(--bg-surface); border-radius: var(--radius-md); border: 1px solid var(--border-card);">
            <i class="fa-solid fa-newspaper" style="font-size: 3rem; color: var(--gold-primary); opacity: 0.5; margin-bottom: 16px;"></i>
            <h3 style="font-size: 1.3rem; margin-bottom: 8px;">Chưa có bài viết nào trong chuyên mục này</h3>
            <p style="color: var(--text-muted); margin-bottom: 20px;">Vui lòng quay lại chuyên mục khác hoặc xem toàn bộ bài viết.</p>
            <a href="/blog" class="btn-luxe-primary">Xem Tất Cả Bài Viết</a>
        </div>
    }
</div>

<!-- GOOGLE STRUCTURED DATA (JSON-LD) -->
@{
    var pageUrl = ViewData["CanonicalUrl"]?.ToString() ?? $"{Context.Request.Scheme}://{Context.Request.Host}/blog";
    var siteBaseUrl = ViewData["SeoSiteBaseUrl"]?.ToString() ?? $"{Context.Request.Scheme}://{Context.Request.Host}";
    var blogJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Blog",
        ["name"] = "Tạp Chí Nghệ Thuật Mùi Hương - PERFUME LUXE",
        ["description"] = ViewData["MetaDescription"]?.ToString(),
        ["url"] = pageUrl,
        ["publisher"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = "PERFUME LUXE" },
        ["blogPost"] = Model.Select(post => new Dictionary<string, object?>
        {
            ["@type"] = "BlogPosting",
            ["headline"] = post.Title,
            ["url"] = $"{siteBaseUrl}/blog/{Uri.EscapeDataString(post.Slug)}",
            ["datePublished"] = DateTime.SpecifyKind(post.CreatedAt, DateTimeKind.Utc).ToString("O"),
            ["author"] = new Dictionary<string, object?> { ["@type"] = "Person", ["name"] = post.AuthorName }
        }).ToArray()
    });
    var breadcrumbJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Trang Chủ", ["item"] = $"{siteBaseUrl}/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Tạp Chí Mùi Hương", ["item"] = pageUrl }
        }
    });
}
<script type="application/ld+json">@Html.Raw(blogJsonLd)</script>
<script type="application/ld+json">@Html.Raw(breadcrumbJsonLd)</script>
