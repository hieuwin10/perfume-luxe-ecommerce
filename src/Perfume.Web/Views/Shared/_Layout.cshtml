@using Microsoft.AspNetCore.Identity
@inject SignInManager<Perfume.Infrastructure.Identity.AppUser> SignInManager
@inject UserManager<Perfume.Infrastructure.Identity.AppUser> UserManager
<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | PERFUME LUXE" : "PERFUME LUXE - Haute Parfumerie | Nước Hoa Cao Cấp Chính Hãng")</title>
    
    <!-- Meta SEO Google & Social Cards -->
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Thế giới nước hoa cao cấp chính hãng từ các thương hiệu xa xỉ bậc nhất thế giới: Dior, Chanel, Creed, Tom Ford, Le Labo, Kilian. Bảo đảm 100% xuất xứ.")" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "PERFUME LUXE - Nước Hoa Xa Xỉ Chính Hãng")" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Bộ sưu tập nước hoa cao cấp, chiết 10ml và fullbox với 3 tầng hương độc bản.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=1200&q=80")" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Luxury Theme Stylesheet -->
    <link rel="stylesheet" href="~/css/luxury-perfume.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dark-theme">
    <div hidden aria-hidden="true">@Html.AntiForgeryToken()</div>
    <!-- Top Announcement Bar -->
    <div style="background: var(--bg-surface-elevated); border-bottom: 1px solid var(--border-card); font-size: 0.78rem; padding: 6px 16px; text-align: center; color: var(--text-secondary); display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap;">
        <div><i class="fa-solid fa-crown text-gold-gradient" style="margin-right: 6px;"></i> Cam kết 100% Nước Hoa Chính Hãng Nhập Khẩu</div>
        <div style="display: none; @@media(min-width: 768px){display: block;}"><i class="fa-solid fa-truck-fast" style="color: var(--gold-primary); margin-right: 6px;"></i> Miễn phí giao hàng toàn quốc đơn từ 2.000.000₫</div>
        <div><i class="fa-solid fa-shield-halved" style="color: var(--gold-primary); margin-right: 6px;"></i> Đổi trả 7 ngày nếu lỗi niêm phong</div>
    </div>

    <!-- Header Navigation -->
    <header class="luxe-header">
        <div class="header-inner">
            <a href="/" class="brand-logo">
                <span class="brand-title text-gold-gradient">PERFUME LUXE</span>
                <span class="brand-sub">Haute Parfumerie Paris</span>
            </a>

            <nav>
                <ul class="nav-links">
                    <li><a href="/" class="nav-link">Trang Chủ</a></li>
                    <li><a href="/bo-suu-tap" class="nav-link">Bộ Sưu Tập</a></li>
                    <li><a href="/bo-suu-tap?gender=Men" class="nav-link">Nước Hoa Nam</a></li>
                    <li><a href="/bo-suu-tap?gender=Women" class="nav-link">Nước Hoa Nữ</a></li>
                    <li><a href="/catalog/quiz" class="nav-link" style="color: var(--gold-primary);"><i class="fa-solid fa-wand-magic-sparkles" style="margin-right: 4px;"></i> Trắc Nghiệm Mùi</a></li>
                    <li><a href="/blog" class="nav-link">Cẩm Nang</a></li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a href="/admin/admindashboard" class="nav-link" style="background: rgba(212,175,55,0.12); padding: 5px 12px; border-radius: 6px; border: 1px solid var(--border-subtle); color: var(--gold-primary); font-size: 0.82rem;"><i class="fa-solid fa-gauge-high" style="margin-right: 4px;"></i> Quản trị</a></li>
                        }
                        else if (User.IsInRole("StoreManager"))
                        {
                            <li><a href="/admin/storemanager" class="nav-link" style="background: rgba(212,175,55,0.12); padding: 5px 12px; border-radius: 6px; border: 1px solid var(--border-subtle); color: var(--gold-primary); font-size: 0.82rem;"><i class="fa-solid fa-chart-line" style="margin-right: 4px;"></i> Quản lý cửa hàng</a></li>
                        }
                    }
                </ul>
            </nav>

            <div class="header-actions">
                <!-- Theme Toggle Button (Dark / Light) -->
                <button type="button" class="icon-btn" id="themeToggleBtn" title="Chuyển đổi Sáng / Tối" aria-label="Toggle Theme">
                    <i class="fa-solid fa-moon" id="themeIcon"></i>
                </button>

                <!-- Mini Cart Trigger -->
                <button type="button" class="icon-btn" id="cartDrawerBtn" title="Giỏ hàng" aria-label="Open Cart">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span class="badge-count" id="headerCartCount">0</span>
                </button>

                <!-- User Account Button -->
                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    <div class="user-avatar-dropdown" id="userDropdown">
                        <button type="button" id="userAvatarBtn" class="icon-btn" title="Tài khoản của bạn" style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--gold-primary), #8B6914); font-weight: 700; font-size: 0.85rem; color: #000;">
                            @((currentUser?.FullName ?? "U").Substring(0, 1).ToUpper())
                        </button>
                        <div class="user-dropdown-menu" id="userDropdownMenu">
                            <div style="padding: 14px 16px; border-bottom: 1px solid var(--border-card);">
                                <div style="font-weight: 700; font-size: 0.92rem; color: var(--text-primary); margin-bottom: 2px;">@currentUser?.FullName</div>
                                <div style="font-size: 0.78rem; color: var(--text-muted);">@currentUser?.Email</div>
                                @if (User.IsInRole("Admin")) { <span class="role-badge-admin">Admin</span> }
                                else if (User.IsInRole("StoreManager")) { <span class="role-badge-manager">Cửa hàng trưởng</span> }
                                else { <span class="role-badge-customer">Khách hàng</span> }
                            </div>
                            <a href="/account/profile" class="dropdown-item-luxe">
                                <i class="fa-solid fa-user-circle"></i> Tài Khoản Của Tôi
                            </a>
                            <a href="/account/myorders" class="dropdown-item-luxe"><i class="fa-solid fa-box"></i> Đơn hàng của tôi</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/admin/admindashboard" class="dropdown-item-luxe"><i class="fa-solid fa-gauge-high"></i> Admin Dashboard</a>
                                <a href="/admin/databaseconsole" class="dropdown-item-luxe"><i class="fa-solid fa-database"></i> Database Console</a>
                            }
                            else if (User.IsInRole("StoreManager"))
                            {
                                <a href="/admin/storemanager" class="dropdown-item-luxe"><i class="fa-solid fa-chart-line"></i> Thống kê cửa hàng</a>
                            }
                            <div style="border-top: 1px solid var(--border-card); margin: 4px 0;"></div>
                            <form method="post" action="/account/logout" style="margin: 0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item-luxe" style="width: 100%; text-align: left; background: none; border: none; cursor: pointer; color: #f87171;">
                                    <i class="fa-solid fa-right-from-bracket"></i> Đăng Xuất
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/account/login" class="icon-btn" title="Đăng nhập" style="width: 38px; height: 38px;">
                        <i class="fa-solid fa-user"></i>
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Mini Cart Drawer & Overlay -->
    <div class="drawer-overlay" id="cartOverlay"></div>
    <div class="mini-cart-drawer" id="cartDrawer">
        <div class="drawer-header">
            <h4 style="font-size: 1.3rem; margin: 0;"><i class="fa-solid fa-bag-shopping" style="color: var(--gold-primary); margin-right: 8px;"></i> Giỏ Hàng Của Bạn</h4>
            <button type="button" class="icon-btn" id="closeCartBtn" style="width: 32px; height: 32px;"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="drawer-body" id="cartDrawerItems">
            <div style="text-align: center; padding: 40px 0; color: var(--text-muted);">
                <i class="fa-solid fa-bag-shopping" style="font-size: 3rem; margin-bottom: 12px; opacity: 0.3;"></i>
                <p>Giỏ hàng đang trống.</p>
            </div>
        </div>
        <div class="drawer-footer">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <span style="color: var(--text-secondary); font-size: 0.95rem;">Tạm tính:</span>
                <span style="font-size: 1.3rem; font-weight: 700; color: var(--gold-primary);" id="cartDrawerSubtotal">0₫</span>
            </div>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <a href="/checkout" class="btn-luxe" style="width: 100%; text-align: center;"><i class="fa-solid fa-lock" style="margin-right: 6px;"></i> Tiến Hành Thanh Toán</a>
                <a href="/cart" class="btn-luxe-outline" style="width: 100%; text-align: center;">Xem Chi Tiết Giỏ Hàng</a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Luxury Footer -->
    <footer style="background: var(--bg-surface); border-top: 1px solid var(--border-subtle); padding: 60px 24px 24px; margin-top: 80px;">
        <div style="max-width: 1360px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 40px; margin-bottom: 40px;">
            <div>
                <span class="brand-title text-gold-gradient" style="font-size: 1.6rem; display: block; margin-bottom: 4px;">PERFUME LUXE</span>
                <span class="brand-sub" style="margin-bottom: 16px; display: block;">Haute Parfumerie Paris</span>
                <p style="color: var(--text-secondary); font-size: 0.88rem; line-height: 1.7; margin-bottom: 20px;">
                    Điểm đến hàng đầu cho những người yêu thích nghệ thuật mùi hương xa xỉ. Mỗi giọt hương là một tác phẩm bất hủ nâng tầm phong cách sống.
                </p>
                <div style="display: flex; gap: 12px;">
                    <a href="#" class="icon-btn" style="width: 36px; height: 36px;"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="icon-btn" style="width: 36px; height: 36px;"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="icon-btn" style="width: 36px; height: 36px;"><i class="fa-brands fa-tiktok"></i></a>
                </div>
            </div>

            <div>
                <h4 style="font-size: 1.15rem; margin-bottom: 20px; color: var(--gold-primary);">Danh Mục Nổi Bật</h4>
                <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.9rem; color: var(--text-secondary);">
                    <li><a href="/bo-suu-tap" class="nav-link">Tất Cả Sản Phẩm</a></li>
                    <li><a href="/bo-suu-tap?gender=Men" class="nav-link">Nước Hoa Nam Lịch Lãm</a></li>
                    <li><a href="/bo-suu-tap?gender=Women" class="nav-link">Nước Hoa Nữ Quyến Rũ</a></li>
                    <li><a href="/bo-suu-tap?familySlug=huong-go-woody" class="nav-link">Hương Gỗ Trầm Ấm (Woody)</a></li>
                    <li><a href="/catalog/quiz" class="nav-link">Trắc Nghiệm Tìm Mùi Hương</a></li>
                </ul>
            </div>

            <div>
                <h4 style="font-size: 1.15rem; margin-bottom: 20px; color: var(--gold-primary);">Hỗ Trợ Khách Hàng</h4>
                <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.9rem; color: var(--text-secondary);">
                    <li><i class="fa-solid fa-phone" style="width: 20px; color: var(--gold-primary);"></i> Hotline: 1900 8888 (8:00 - 22:00)</li>
                    <li><i class="fa-solid fa-envelope" style="width: 20px; color: var(--gold-primary);"></i> Email: concierge@perfumeluxe.vn</li>
                    <li><i class="fa-solid fa-location-dot" style="width: 20px; color: var(--gold-primary);"></i> Boutique: 88 Đồng Khởi, Quận 1, TP. HCM</li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a href="/admin/databaseconsole" class="nav-link" style="color: var(--gold-primary);"><i class="fa-solid fa-terminal" style="width: 20px;"></i> Console Quản Trị CSDL (AWS Style)</a></li>
                    }
                </ul>
            </div>

            <div>
                <h4 style="font-size: 1.15rem; margin-bottom: 20px; color: var(--gold-primary);">Đặc Quyền Thành Viên</h4>
                <p style="color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 14px;">Đăng ký nhận mã giảm giá 10% cho đơn hàng đầu tiên:</p>
                <div style="display: flex; gap: 8px;">
                    <input type="email" placeholder="Email của bạn..." style="background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 10px 14px; border-radius: var(--radius-sm); flex-grow: 1; outline: none; font-size: 0.85rem;" />
                    <button class="btn-luxe" style="padding: 10px 18px; font-size: 0.8rem;">Gửi</button>
                </div>
            </div>
        </div>

        <div style="max-width: 1360px; margin: 0 auto; border-top: 1px solid var(--border-card); padding-top: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; font-size: 0.8rem; color: var(--text-muted);">
            <div>&copy; @DateTime.UtcNow.Year PERFUME LUXE. Haute Parfumerie Enterprise System. All rights reserved.</div>
            <div style="display: flex; gap: 16px;">
                <span>Thanh toán:</span>
                <span><i class="fa-solid fa-money-bill-wave" style="color: #2A9D8F;"></i> COD (Thanh toán khi nhận hàng)</span>
            </div>
        </div>
    </footer>

    <!-- Toast Notifications -->
    <div class="toast-container-luxe" id="toastContainer"></div>

    <!-- Scripts -->
    <script>
        // 1. Theme Management (Dark / Light + Cốc Cốc / Chrome system auto-detection)
        (function() {
            const savedTheme = localStorage.getItem('perfume_luxe_theme');
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = savedTheme ? savedTheme : (prefersDark ? 'dark' : 'dark'); // Default luxury dark
            applyTheme(theme);

            // Listen for system theme change (Cốc Cốc, Chrome, Windows)
            if (window.matchMedia) {
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
                    if (!localStorage.getItem('perfume_luxe_theme')) {
                        applyTheme(e.matches ? 'dark' : 'light');
                    }
                });
            }
        })();

        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            document.body.className = theme === 'dark' ? 'dark-theme' : 'light-theme';
            const icon = document.getElementById('themeIcon');
            if (icon) {
                icon.className = theme === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
            }
        }

        document.getElementById('themeToggleBtn')?.addEventListener('click', function() {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            localStorage.setItem('perfume_luxe_theme', next);
            applyTheme(next);
        });

        // 2. Mini Cart Drawer Management
        const cartDrawer = document.getElementById('cartDrawer');
        const cartOverlay = document.getElementById('cartOverlay');
        const cartDrawerBtn = document.getElementById('cartDrawerBtn');
        const closeCartBtn = document.getElementById('closeCartBtn');

        function openCart() {
            cartDrawer?.classList.add('active');
            cartOverlay?.classList.add('active');
            refreshCartState();
        }

        function closeCart() {
            cartDrawer?.classList.remove('active');
            cartOverlay?.classList.remove('active');
        }

        cartDrawerBtn?.addEventListener('click', openCart);
        closeCartBtn?.addEventListener('click', closeCart);
        cartOverlay?.addEventListener('click', closeCart);

        function antiForgeryHeaders() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            return token ? { 'RequestVerificationToken': token } : {};
        }

        async function refreshCartState() {
            try {
                const res = await fetch('/Cart/GetCartState');
                const data = await res.json();
                
                // Update badge
                const badge = document.getElementById('headerCartCount');
                if (badge) badge.innerText = data.totalCount;

                // Update subtotal
                const subtotal = document.getElementById('cartDrawerSubtotal');
                if (subtotal) subtotal.innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(data.totalAmount);

                // Update items in drawer
                const container = document.getElementById('cartDrawerItems');
                if (!container) return;

                if (!data.items || data.items.length === 0) {
                    container.innerHTML = `
                        <div style="text-align: center; padding: 40px 0; color: var(--text-muted);">
                            <i class="fa-solid fa-bag-shopping" style="font-size: 3rem; margin-bottom: 12px; opacity: 0.3;"></i>
                            <p>Giỏ hàng đang trống.</p>
                        </div>`;
                    return;
                }

                container.innerHTML = data.items.map(item => `
                    <div style="display: flex; gap: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--border-card); align-items: center;">
                        <img src="${item.productImageUrl || 'https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=150&q=80'}" style="width: 64px; height: 64px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--border-card);" alt="${item.productName}" />
                        <div style="flex-grow: 1;">
                            <div style="font-size: 0.9rem; font-weight: 600; line-height: 1.2; margin-bottom: 2px;">${item.productName}</div>
                            <div style="font-size: 0.75rem; color: var(--gold-primary); margin-bottom: 4px;">${item.variantLabel}</div>
                            <div style="font-size: 0.85rem; font-weight: 700;">${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.unitPrice)} x ${item.quantity}</div>
                        </div>
                        <button onclick="removeCartItem(${item.productId}, ${item.variantId})" style="background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 6px;"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                `).join('');
            } catch (err) {
                console.error(err);
            }
        }

        async function addToCart(slug, variantId = null, quantity = 1) {
            try {
                const res = await fetch('/Cart/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...antiForgeryHeaders() },
                    body: JSON.stringify({ productSlug: slug, variantId: variantId, quantity: quantity })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Đã thêm sản phẩm vào giỏ hàng!', 'success');
                    openCart();
                }
            } catch (err) {
                showToast('Không thể thêm vào giỏ hàng.', 'error');
            }
        }

        async function removeCartItem(productId, variantId) {
            try {
                const res = await fetch('/Cart/RemoveItem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...antiForgeryHeaders() },
                    body: JSON.stringify({ productId, variantId })
                });
                refreshCartState();
                showToast('Đã xóa sản phẩm khỏi giỏ hàng.', 'info');
            } catch (err) {
                console.error(err);
            }
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = 'toast-luxe';
            let icon = type === 'success' ? 'fa-circle-check text-gold-gradient' : 'fa-circle-info text-gold-gradient';
            toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Initialize cart count on load
        refreshCartState();
    </script>

    <script>
        // User avatar dropdown toggle
        const userDropdown = document.getElementById('userDropdown');
        const userAvatarBtn = document.getElementById('userAvatarBtn');

        if (userAvatarBtn && userDropdown) {
            userAvatarBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('open');
            });
            document.addEventListener('click', (e) => {
                if (!userDropdown.contains(e.target)) {
                    userDropdown.classList.remove('open');
                }
            });
        }

        // Show TempData success toast
        @if (TempData["Success"] != null)
        {
            <text>
            setTimeout(() => showToast('@Html.Raw(TempData["Success"])', 'success'), 300);
            </text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
