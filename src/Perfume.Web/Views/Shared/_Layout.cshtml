    <script src="~/js/customer-api.js" asp-append-version="true" defer></script>
    <script>
        // 1. Theme Management (Dark / Light + Cốc Cốc / Chrome system auto-detection)
        (function() {
            const savedTheme = localStorage.getItem('perfume_luxe_theme');
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = savedTheme ? savedTheme : (prefersDark ? 'dark' : 'dark'); // Default luxury dark
            applyTheme(theme);

            // Listen for system theme change (Cốc Cốc, Chrome, Windows)
            if (window.matchMedia) {
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
                    if (!localStorage.getItem('perfume_luxe_theme')) {
                        applyTheme(e.matches ? 'dark' : 'light');
                    }
                });
            }
        })();

        function applyTheme(theme) {
            if (document.documentElement.getAttribute('data-theme') !== theme) {
                document.documentElement.setAttribute('data-theme', theme);
            }
            const desiredClass = theme === 'dark' ? 'dark-theme' : 'light-theme';
            if (document.body.className !== desiredClass) {
                document.body.className = desiredClass;
            }
            const icon = document.getElementById('themeIcon');
            if (icon) {
                const desiredIcon = theme === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
                if (icon.className !== desiredIcon) {
                    icon.className = desiredIcon;
                }
            }
        }

        document.getElementById('themeToggleBtn')?.addEventListener('click', function() {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            localStorage.setItem('perfume_luxe_theme', next);
            applyTheme(next);
        });

        // 2. Mini Cart Drawer Management
        const cartDrawer = document.getElementById('cartDrawer');
        const cartOverlay = document.getElementById('cartOverlay');
        const cartDrawerBtn = document.getElementById('cartDrawerBtn');
        const closeCartBtn = document.getElementById('closeCartBtn');

        function openCart() {
            cartDrawer?.classList.add('active');
            cartOverlay?.classList.add('active');
            refreshCartState();
        }

        function closeCart() {
            cartDrawer?.classList.remove('active');
            cartOverlay?.classList.remove('active');
        }

        cartDrawerBtn?.addEventListener('click', openCart);
        closeCartBtn?.addEventListener('click', closeCart);
        cartOverlay?.addEventListener('click', closeCart);

        const money = value => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value || 0);

        async function refreshCartState() {
            try {
                const data = await CustomerApi.get('/api/v1/cart');
                
                // Update badge
                const badge = document.getElementById('headerCartCount');
                if (badge) badge.innerText = data.totalCount;
                const bottomBadge = document.getElementById('mobileBottomCartBadge');
                if (bottomBadge) {
                    bottomBadge.innerText = data.totalCount;
                    bottomBadge.style.display = data.totalCount > 0 ? 'flex' : 'none';
                }

                // Update subtotal
                const subtotal = document.getElementById('cartDrawerSubtotal');
                if (subtotal) subtotal.innerText = money(data.subTotal);

                // Update items in drawer
                const container = document.getElementById('cartDrawerItems');
                if (!container) return;

                if (!data.items || data.items.length === 0) {
                    container.innerHTML = `
                        <div style="text-align: center; padding: 40px 0; color: var(--text-muted);">
                            <i class="fa-solid fa-bag-shopping" style="font-size: 3rem; margin-bottom: 12px; opacity: 0.3;"></i>
                            <p>Giỏ hàng đang trống.</p>
                        </div>`;
                    return;
                }

                container.innerHTML = data.items.map(item => `
                    <div style="display: flex; gap: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--border-card); align-items: center;">
                        <img src="${CustomerApi.escapeHtml(item.productImageUrl || 'https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=150&q=80')}" style="width: 64px; height: 64px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--border-card);" alt="${CustomerApi.escapeHtml(item.productName)}" />
                        <div style="flex-grow: 1;">
                            <div style="font-size: 0.9rem; font-weight: 600; line-height: 1.2; margin-bottom: 2px;">${CustomerApi.escapeHtml(item.productName)}</div>
                            <div style="font-size: 0.75rem; color: var(--gold-primary); margin-bottom: 4px;">${CustomerApi.escapeHtml(item.variantLabel)}</div>
                            <div style="font-size: 0.85rem; font-weight: 700;">${money(item.unitPrice)} x ${item.quantity}</div>
                        </div>
                        <button onclick="removeCartItem(${item.productId}, ${item.variantId ?? 'null'})" aria-label="Xóa ${CustomerApi.escapeHtml(item.productName)}" style="background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 6px;"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                `).join('');
            } catch (err) {
                console.error(err);
                const badge = document.getElementById('headerCartCount');
                if (badge) badge.innerText = '–';
            }
        }

        async function addToCart(slug, variantId = null, quantity = 1) {
            try {
                await CustomerApi.post('/api/v1/cart/items', { productSlug: slug, variantId, quantity });
                showToast('Đã thêm sản phẩm vào giỏ hàng!', 'success');
                openCart();
            } catch (err) {
                showToast(err.message || 'Không thể thêm vào giỏ hàng.', 'error');
            }
        }

        async function removeCartItem(productId, variantId) {
            try {
                await CustomerApi.delete(`/api/v1/cart/items/${productId}?variantId=${variantId ?? ''}`);
                await refreshCartState();
                showToast('Đã xóa sản phẩm khỏi giỏ hàng.', 'info');
            } catch (err) {
                showToast(err.message || 'Chưa xóa được sản phẩm.', 'error');
            }
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = 'toast-luxe';
            let icon = type === 'success' ? 'fa-circle-check text-gold-gradient' : 'fa-circle-info text-gold-gradient';
            toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${CustomerApi.escapeHtml(message)}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        document.getElementById('customerLogoutForm')?.addEventListener('submit', async event => {
            event.preventDefault();
            try { await CustomerApi.post('/api/v1/auth/logout', {}); }
            finally { window.location.assign('/'); }
        });

        // Load cart data only after the page's load event so its API request
        // cannot compete with the hero image and other LCP resources.
        window.addEventListener('load', function initializeCartWhenIdle() {
            if ('requestIdleCallback' in window) {
                requestIdleCallback(refreshCartState, { timeout: 3000 });
            } else {
                setTimeout(refreshCartState, 2000);
            }
        }, { once: true });
    </script>

    <script>
        // Mobile Navigation Drawer Toggle
        const mobileNavToggleBtn = document.getElementById('mobileNavToggleBtn');
        const mobileNavDrawer = document.getElementById('mobileNavDrawer');
        const mobileNavOverlay = document.getElementById('mobileNavOverlay');
        const closeMobileNavBtn = document.getElementById('closeMobileNavBtn');

        function openMobileNav() {
            if (mobileNavDrawer) mobileNavDrawer.classList.add('active');
            if (mobileNavOverlay) mobileNavOverlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeMobileNav() {
            if (mobileNavDrawer) mobileNavDrawer.classList.remove('active');
            if (mobileNavOverlay) mobileNavOverlay.classList.remove('active');
            document.body.style.overflow = '';
        }

        if (mobileNavToggleBtn) mobileNavToggleBtn.addEventListener('click', openMobileNav);
        if (closeMobileNavBtn) closeMobileNavBtn.addEventListener('click', closeMobileNav);
        if (mobileNavOverlay) mobileNavOverlay.addEventListener('click', closeMobileNav);

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeMobileNav();
                closeCart();
            }
        });

        // User avatar dropdown toggle with Click Outside
        const userDropdown = document.getElementById('userDropdown');
        const userAvatarBtn = document.getElementById('userAvatarBtn');

        if (userAvatarBtn && userDropdown) {
            userAvatarBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('open');
            });
            document.addEventListener('click', (e) => {
                if (!userDropdown.contains(e.target)) {
                    userDropdown.classList.remove('open');
                }
            });
        }

        // Show TempData success toast
        @if (TempData["Success"] != null)
        {
            var successMsg = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Success"]?.ToString() ?? "");
            <text>
            setTimeout(() => showToast('@successMsg', 'success'), 300);
            </text>
        }

        // Newsletter subscription AJAX
        async function handleNewsletterSubscribe() {
            const input = document.getElementById('footerNewsletterEmail');
            const notice = document.getElementById('newsletterNotice');
            if (!input || !notice) return;
            const email = input.value.trim();

            if (!email || !email.includes('@@') || !email.includes('.')) {
                notice.style.display = 'block';
                notice.style.background = 'rgba(239, 68, 68, 0.15)';
                notice.style.color = '#f87171';
                notice.style.border = '1px solid #ef4444';
                notice.innerText = 'Vui lòng nhập địa chỉ email hợp lệ.';
                return;
            }

            try {
                const res = await fetch('/api/newsletter/subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });
                const data = await res.json();
                notice.style.display = 'block';
                if (data.success) {
                    notice.style.background = 'rgba(46, 204, 113, 0.15)';
                    notice.style.color = '#2ecc71';
                    notice.style.border = '1px solid #2ecc71';
                    notice.textContent = ' ' + data.message;
                    const giftIcon = document.createElement('i');
                    giftIcon.className = 'fa-solid fa-gift';
                    giftIcon.style.marginRight = '6px';
                    notice.prepend(giftIcon);
                    input.value = '';
                    if (typeof showToast === 'function') {
                        showToast(`Mã ưu đãi LUXE2026 đã kích hoạt cho ${email}!`, 'success');
                    }
                } else {
                    notice.style.background = 'rgba(239, 68, 68, 0.15)';
                    notice.style.color = '#f87171';
                    notice.style.border = '1px solid #ef4444';
                    notice.innerText = data.message;
                }
            } catch (err) {
                console.error(err);
                notice.style.display = 'block';
                notice.style.background = 'rgba(239, 68, 68, 0.15)';
                notice.style.color = '#f87171';
                notice.style.border = '1px solid #ef4444';
                notice.innerText = 'Có lỗi xảy ra, vui lòng thử lại sau.';
            }
        }
    </script>

    <!-- Mobile Bottom Navigation Bar -->
    <nav class="mobile-bottom-nav" aria-label="Thanh điều hướng di động">
        <a href="/" class="mobile-bottom-nav-item @(requestPath == "/" ? "active" : "")">
            <i class="fa-solid fa-house"></i>
            <span>Trang Chủ</span>
        </a>
        <a href="/bo-suu-tap" class="mobile-bottom-nav-item @(requestPath.StartsWithSegments("/bo-suu-tap") ? "active" : "")">
            <i class="fa-solid fa-gem"></i>
            <span>Bộ Sưu Tập</span>
        </a>
        <a href="/catalog/quiz" class="mobile-bottom-nav-item highlight @(requestPath.StartsWithSegments("/catalog/quiz") ? "active" : "")">
            <div class="bottom-nav-quiz-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
            <span>Tìm Mùi</span>
        </a>
        <a href="/cart" class="mobile-bottom-nav-item @(requestPath.StartsWithSegments("/cart") ? "active" : "")" style="position: relative;">
            <i class="fa-solid fa-bag-shopping"></i>
            <span class="badge-count cart-count-badge" id="mobileBottomCartBadge" style="display: none; top: 4px; right: 20%;">0</span>
            <span>Giỏ Hàng</span>
        </a>
        <a href="@(SignInManager.IsSignedIn(User) ? "/account/profile" : "/account/login")" class="mobile-bottom-nav-item @(requestPath.StartsWithSegments("/account") ? "active" : "")">
            <i class="fa-solid fa-user"></i>
            <span>@(SignInManager.IsSignedIn(User) ? "Tài Khoản" : "Đăng Nhập")</span>
        </a>
    </nav>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
