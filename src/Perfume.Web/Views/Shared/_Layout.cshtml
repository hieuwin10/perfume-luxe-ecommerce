@using Microsoft.AspNetCore.Identity
@inject SignInManager<Perfume.Infrastructure.Identity.AppUser> SignInManager
@inject UserManager<Perfume.Infrastructure.Identity.AppUser> UserManager
@inject IConfiguration Configuration
@{
    var canonicalUrl = ViewData["CanonicalUrl"]?.ToString()
        ?? Perfume.Web.Seo.SeoUrlBuilder.AbsoluteUrl(Context.Request, Configuration, Context.Request.Path);
    var ogUrl = ViewData["OgUrl"]?.ToString() ?? canonicalUrl;
    var requestPath = Context.Request.Path;
    var isPrivatePage = requestPath.StartsWithSegments("/account", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWithSegments("/cart", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWithSegments("/checkout", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWithSegments("/admin", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWithSegments("/tra-cuu-don-hang", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWithSegments("/order-tracking", StringComparison.OrdinalIgnoreCase);
    var robotsContent = ViewData["Robots"]?.ToString() ?? (isPrivatePage ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1");
    var pageTitle = ViewData["Title"]?.ToString()?.Trim();
    var documentTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "PERFUME LUXE - Haute Parfumerie | Nước Hoa Cao Cấp Chính Hãng"
        : pageTitle.EndsWith("PERFUME LUXE", StringComparison.OrdinalIgnoreCase)
            ? pageTitle
            : $"{pageTitle} | PERFUME LUXE";
}
<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@documentTitle</title>

    @if (ViewData["LcpImage"] != null)
    {
        var lcpDesktop = ViewData["LcpImage"]?.ToString();
        var lcpMobile = ViewData["LcpImageMobile"]?.ToString();
        if (!string.IsNullOrEmpty(lcpMobile) && lcpMobile != lcpDesktop)
        {
            <!-- Ultra-High Priority Responsive Preload for LCP Hero Element -->
            <link rel="preload" as="image" href="@lcpMobile" media="(max-width: 768px)" fetchpriority="high" />
            <link rel="preload" as="image" href="@lcpDesktop" media="(min-width: 769px)" fetchpriority="high" />
        }
        else
        {
            <link rel="preload" as="image" href="@lcpDesktop" fetchpriority="high" />
        }
    }

    <!-- Performance Preconnect & DNS-Prefetch -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin="anonymous" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />

    <!-- Google Fonts (display=optional guarantees 0 CLS and instant initial paint) -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;600&display=optional" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;600&display=optional" /></noscript>
    
    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="Qh9rEGR7zfGddcqbtlF1p2H9s544wnJg2TOfQeLgNJs" />

    <!-- Google Analytics 4 (GA4) - Deferred for Maximum Web Vitals -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        (function() {
            var gaInitialized = false;
            function loadGA4() {
                if (gaInitialized) return;
                gaInitialized = true;
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KCWE7ENDEJ';
                document.head.appendChild(s);
                gtag('js', new Date());
                gtag('config', 'G-KCWE7ENDEJ');
            }
            if (window.addEventListener) {
                window.addEventListener('load', function() {
                    setTimeout(function() {
                        if ('requestIdleCallback' in window) {
                            requestIdleCallback(loadGA4, { timeout: 4000 });
                        } else {
                            loadGA4();
                        }
                    }, 8000);
                });
                ['click', 'keydown'].forEach(function(evt) {
                    window.addEventListener(evt, loadGA4, { once: true, passive: true });
                });
            }
        })();
    </script>

    <!-- Meta SEO Google & Social Cards -->
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Thế giới nước hoa cao cấp chính hãng từ các thương hiệu xa xỉ bậc nhất thế giới: Dior, Chanel, Creed, Tom Ford, Le Labo, Kilian. Bảo đảm 100% xuất xứ.")" />
    <meta name="robots" content="@robotsContent" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="PERFUME LUXE" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "PERFUME LUXE - Nước Hoa Xa Xỉ Chính Hãng")" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Bộ sưu tập nước hoa cao cấp, chiết 10ml và fullbox với 3 tầng hương độc bản.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=1200&q=80")" />
    <meta property="og:url" content="@ogUrl" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] ?? "PERFUME LUXE - Nước Hoa Xa Xỉ Chính Hãng")" />
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "Bộ sưu tập nước hoa cao cấp, chiết 10ml và fullbox với 3 tầng hương độc bản.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=1200&q=80")" />

    <!-- Favicon & Brand Theme -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💎</text></svg>" />
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💎</text></svg>" />
    <meta name="theme-color" content="#0B0B0E" />
    <link rel="manifest" href="~/manifest.webmanifest" />

    <!-- Font Awesome Icons (Non-render-blocking) -->
    <link rel="preload" href="~/css/font-awesome-subset.css" asp-append-version="true" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="~/css/font-awesome-subset.css" asp-append-version="true" /></noscript>

    <!-- Luxury Theme Stylesheet -->
    @if (string.IsNullOrEmpty(requestPath.Value) || string.Equals(requestPath.Value, "/", StringComparison.Ordinal) || requestPath.StartsWithSegments("/Home", StringComparison.OrdinalIgnoreCase))
    {
        <!-- Keep the mobile first viewport styled while the full theme stylesheet loads without blocking first paint. -->
        <style>
            :root {
                --gold-primary: #D4AF37;
                --gold-light: #F3E5AB;
                --gold-gradient: linear-gradient(135deg, #ECC86E 0%, #D4AF37 50%, #997A15 100%);
                --font-heading: 'Cormorant Garamond', Garamond, 'Times New Roman', Georgia, serif;
                --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                --radius-sm: 6px;
                --radius-md: 12px;
                --radius-full: 9999px;
                --transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
                --bg-main: #0B0B0E;
                --bg-surface: #141419;
                --bg-surface-elevated: #1D1D24;
                --bg-glass: rgba(20, 20, 25, 0.85);
                --text-primary: #F8F7F5;
                --text-secondary: #C4C4CF;
                --text-muted: #A1A1B2;
                --border-subtle: rgba(212, 175, 55, 0.15);
                --border-focus: rgba(212, 175, 55, 0.5);
                --border-card: rgba(255, 255, 255, 0.08);
            }
            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
            body { margin: 0; background: var(--bg-main); color: var(--text-primary); font-family: var(--font-body); line-height: 1.6; overflow-x: hidden; }
            h1, h2, h3, h4 { font-family: var(--font-heading); letter-spacing: 0.02em; }
            a { color: inherit; text-decoration: none; }
            .text-gold-gradient { background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
            .btn-luxe, .btn-luxe-outline { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: var(--radius-full); font-weight: 600; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: var(--transition); }
            .btn-luxe { border: 0; background: var(--gold-gradient); color: #0B0B0E !important; box-shadow: 0 4px 15px rgba(212,175,55,.25); }
            .btn-luxe-outline { border: 1px solid var(--gold-primary); background: transparent; color: var(--gold-primary) !important; }
            .luxe-header { position: sticky; top: 0; z-index: 1000; background: var(--bg-glass); border-bottom: 1px solid var(--border-subtle); }
            .header-inner { max-width: 1360px; margin: 0 auto; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; }
            .brand-logo { display: flex; flex-direction: column; align-items: flex-start; }
            .brand-title { font-size: 1.85rem; font-family: var(--font-heading); letter-spacing: .12em; font-weight: 700; }
            .brand-sub { color: var(--gold-primary); font-size: .65rem; letter-spacing: .25em; text-transform: uppercase; }
            .nav-links { display: flex; align-items: center; gap: 28px; list-style: none; }
            .nav-link { position: relative; padding: 6px 0; color: var(--text-secondary); font-size: .9rem; font-weight: 500; }
            .header-actions { display: flex; align-items: center; gap: 16px; }
            .icon-btn { position: relative; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-card); border-radius: 50%; background: var(--bg-surface); color: var(--text-primary); cursor: pointer; transition: var(--transition); }
            .badge-count { position: absolute; top: -4px; right: -4px; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--gold-primary); color: #0B0B0E; font-size: .7rem; font-weight: 700; }
            .mobile-nav-toggle { display: none; width: 42px; height: 42px; align-items: center; justify-content: center; border: 1px solid var(--border-card); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-primary); cursor: pointer; }
            .mobile-nav-overlay { position: fixed; inset: 0; z-index: 2090; background: rgba(0,0,0,.75); opacity: 0; visibility: hidden; transition: opacity .3s cubic-bezier(.16,1,.3,1), visibility .3s; }
            .mobile-nav-overlay.active { opacity: 1; visibility: visible; }
            .mobile-nav-drawer { position: fixed; top: 0; left: 0; z-index: 2100; display: flex; flex-direction: column; width: 320px; max-width: 86vw; height: 100vh; overflow-y: auto; border-right: 1px solid var(--border-subtle); background: var(--bg-surface); transform: translateX(-100%); transition: transform .35s cubic-bezier(.16,1,.3,1); }
            .mobile-nav-drawer.active { transform: translateX(0); }
            .mobile-nav-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid var(--border-card); background: var(--bg-surface-elevated); }
            .mobile-nav-body { display: flex; flex: 1; flex-direction: column; gap: 4px; padding: 20px 16px; }
            .mobile-nav-item { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: var(--radius-sm); color: var(--text-secondary); font-size: .95rem; font-weight: 500; }
            .mobile-nav-item i { width: 22px; color: var(--gold-primary); text-align: center; }
            .mobile-nav-footer { display: flex; flex-direction: column; gap: 12px; padding: 20px 24px; border-top: 1px solid var(--border-card); background: var(--bg-surface-elevated); }
            
            /* Mobile-First Base Rules (Guarantees zero layout shifts on mobile) */
            .announcement-bar { min-height: 32px; background: var(--bg-surface-elevated); border-bottom: 1px solid var(--border-card); font-size: 0.78rem; padding: 6px 16px; text-align: center; color: var(--text-secondary); display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap; gap: 8px; }
            .announcement-desktop-only { display: none; }
            .luxe-hero-banner { position: relative; width: 100%; height: 580px; min-height: 580px; max-height: 580px; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 50px 16px; text-align: center; border-bottom: 1px solid var(--border-subtle); contain: layout size paint; }
            .mobile-bottom-nav { display: flex; position: fixed; bottom: 0; left: 0; right: 0; height: calc(56px + env(safe-area-inset-bottom, 0px)); padding-bottom: env(safe-area-inset-bottom, 0px); background: rgba(14, 14, 18, 0.95); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-top: 1px solid var(--border-subtle); z-index: 2000; justify-content: space-around; align-items: center; }
            .mobile-bottom-nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; flex: 1; height: 100%; color: var(--text-muted); font-size: 0.65rem; font-weight: 500; text-decoration: none; -webkit-tap-highlight-color: transparent; }
            .mobile-bottom-nav-item i { font-size: 1.1rem; }
            .mobile-bottom-nav-item.active { color: var(--gold-primary); font-weight: 700; }
            .mobile-bottom-nav-item.highlight .bottom-nav-quiz-icon { width: 36px; height: 36px; border-radius: 50%; background: var(--gold-gradient); color: #0B0B0E; display: flex; align-items: center; justify-content: center; margin-top: -12px; box-shadow: 0 4px 14px rgba(212, 175, 55, 0.4); }
            .mobile-bottom-nav-item.highlight .bottom-nav-quiz-icon i { font-size: 0.95rem; }

            /* Desktop Expansion (>= 769px) */
            @@media (min-width: 769px) {
                .announcement-desktop-only { display: block !important; }
                .luxe-hero-banner { height: 720px; min-height: 720px; max-height: 720px; padding: 80px 20px; }
                .mobile-bottom-nav { display: none !important; }
            }
            @@media (max-width: 1024px) {
                .nav-links { display: none !important; }
                .mobile-nav-toggle { display: flex; }
            }
            @@media (max-width: 768px) {
                body { padding-bottom: calc(60px + env(safe-area-inset-bottom, 0px)); }
                input, select, textarea { font-size: 16px !important; }
                .brand-title { font-size: 1.45rem; }
                .brand-sub { font-size: .58rem; }
                .header-inner { padding: 12px 16px; }
            }
        </style>
        <link rel="preload" href="~/css/luxury-perfume.min.css" asp-append-version="true" as="style" onload="this.onload=null;this.rel='stylesheet'" />
        <noscript><link rel="stylesheet" href="~/css/luxury-perfume.min.css" asp-append-version="true" /></noscript>
    }
    else
    {
        <link rel="stylesheet" href="~/css/luxury-perfume.min.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dark-theme">
    <div hidden aria-hidden="true">@Html.AntiForgeryToken()</div>
    <!-- Top Announcement Bar -->
    <div class="announcement-bar" style="min-height: 32px; background: var(--bg-surface-elevated); border-bottom: 1px solid var(--border-card); font-size: 0.78rem; padding: 6px 16px; text-align: center; color: var(--text-secondary); display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap; gap: 8px;">
        <div><i class="fa-solid fa-crown text-gold-gradient" style="margin-right: 6px;"></i> Cam kết 100% Nước Hoa Chính Hãng</div>
        <div class="announcement-desktop-only" style="display: none;"><i class="fa-solid fa-truck-fast" style="color: var(--gold-primary); margin-right: 6px;"></i> Miễn phí giao hàng toàn quốc từ 2.000.000₫</div>
        <div><i class="fa-solid fa-shield-halved" style="color: var(--gold-primary); margin-right: 6px;"></i> Đổi trả 7 ngày nếu lỗi niêm phong</div>
    </div>

    <!-- Mobile Nav Overlay & Drawer -->
    <div class="mobile-nav-overlay" id="mobileNavOverlay"></div>
    <aside class="mobile-nav-drawer" id="mobileNavDrawer" aria-label="Menu di động">
        <div class="mobile-nav-header">
            <a href="/" class="brand-logo" onclick="closeMobileNav()">
                <span class="brand-title text-gold-gradient" style="font-size: 1.35rem;">PERFUME LUXE</span>
                <span class="brand-sub" style="font-size: 0.58rem;">Haute Parfumerie</span>
            </a>
            <button type="button" class="icon-btn" id="closeMobileNavBtn" aria-label="Đóng menu" style="width: 38px; height: 38px;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="mobile-nav-body">
            <a href="/" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-house"></i> Trang Chủ</a>
            <a href="/bo-suu-tap" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-gem"></i> Bộ Sưu Tập Nước Hoa</a>
            <a href="/catalog/quiz" class="mobile-nav-item" onclick="closeMobileNav()" style="color: var(--gold-primary);"><i class="fa-solid fa-wand-magic-sparkles"></i> AI Trắc Nghiệm Tìm Mùi</a>
            <a href="/discovery-box" class="mobile-nav-item" onclick="closeMobileNav()" style="color: var(--gold-primary);"><i class="fa-solid fa-gift"></i> Hộp Quà Discovery Box</a>
            <a href="/so-sanh" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-scale-balanced"></i> So Sánh Mùi Hương</a>
            <a href="/dat-lich-trai-nghiem" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-crown"></i> Thử Mùi VIP Concierge</a>
            <a href="/tra-cuu-don-hang" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-truck-fast"></i> Tra Cứu Đơn Hàng</a>
            <a href="/blog" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-newspaper"></i> Tạp Chí Mùi Hương</a>
            <a href="/ve-chung-toi" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-circle-info"></i> Về Chúng Tôi</a>

            <div class="mobile-nav-divider"></div>

            @if (SignInManager.IsSignedIn(User))
            {
                var mobileUser = await UserManager.GetUserAsync(User);
                <div style="padding: 6px 14px 10px; font-size: 0.82rem; color: var(--text-muted);">
                    <div style="font-weight: 700; color: var(--text-primary); font-size: 0.9rem;">@mobileUser?.FullName</div>
                    <div>@mobileUser?.Email</div>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin/admindashboard" class="mobile-nav-item" style="color: #f87171;"><i class="fa-solid fa-gauge-high"></i> Admin Dashboard</a>
                }
                else if (User.IsInRole("StoreManager"))
                {
                    <a href="/admin/storemanager" class="mobile-nav-item" style="color: var(--gold-primary);"><i class="fa-solid fa-chart-line"></i> Quản Lý Cửa Hàng</a>
                }
                <a href="/account/profile" class="mobile-nav-item"><i class="fa-solid fa-user"></i> Tài Khoản Của Tôi</a>
                <a href="/account/myorders" class="mobile-nav-item"><i class="fa-solid fa-box"></i> Đơn Hàng Của Tôi</a>
                <form method="post" action="/account/logout" style="margin: 4px 0 0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="mobile-nav-item" style="width: 100%; border: none; background: none; cursor: pointer; color: #f87171; text-align: left;">
                        <i class="fa-solid fa-right-from-bracket" style="color: #f87171;"></i> Đăng Xuất
                    </button>
                </form>
            }
            else
            {
                <a href="/account/login" class="mobile-nav-item" style="color: var(--gold-primary); font-weight: 600;"><i class="fa-solid fa-right-to-bracket"></i> Đăng Nhập / Đăng Ký</a>
            }
        </div>
        <div class="mobile-nav-footer">
            <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem;">
                <span style="color: var(--text-muted);"><i class="fa-solid fa-phone" style="color: var(--gold-primary); margin-right: 6px;"></i> Hotline VIP:</span>
                <strong style="color: var(--text-primary);">024.3828.9999</strong>
            </div>
        </div>
    </aside>

    <!-- Header Navigation -->
    <header class="luxe-header">
        <div class="header-inner">
            <div style="display: flex; align-items: center; gap: 12px;">
                <!-- Hamburger Button on Mobile -->
                <button type="button" class="mobile-nav-toggle" id="mobileNavToggleBtn" aria-label="Mở Menu điều hướng" title="Mở danh mục">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <a href="/" class="brand-logo">
                    <span class="brand-title text-gold-gradient">PERFUME LUXE</span>
                    <span class="brand-sub">Haute Parfumerie Paris</span>
                </a>
            </div>

            <nav>
                <ul class="nav-links">
                    <li><a href="/" class="nav-link">Trang Chủ</a></li>
                    <li><a href="/bo-suu-tap" class="nav-link">Bộ Sưu Tập</a></li>
                    <li><a href="/catalog/quiz" class="nav-link" style="color: var(--gold-primary);"><i class="fa-solid fa-wand-magic-sparkles" style="margin-right: 4px;"></i> Trắc Nghiệm Mùi</a></li>
                    <li><a href="/blog" class="nav-link">Tạp Chí Mùi Hương</a></li>
                    <li><a href="/ve-chung-toi" class="nav-link">Về Chúng Tôi</a></li>
                    <li><a href="/discovery-box" class="nav-link" style="color: var(--gold-primary);"><i class="fa-solid fa-gift" style="margin-right: 4px;"></i> Discovery Box</a></li>
                    <li><a href="/so-sanh" class="nav-link"><i class="fa-solid fa-scale-balanced" style="margin-right: 4px;"></i> So Sánh</a></li>
                    <li><a href="/dat-lich-trai-nghiem" class="nav-link"><i class="fa-solid fa-crown" style="margin-right: 4px; color: var(--gold-primary);"></i> Thử Mùi VIP</a></li>
                    <li><a href="/tra-cuu-don-hang" class="nav-link" style="color: var(--gold-primary);"><i class="fa-solid fa-truck-fast" style="margin-right: 4px;"></i> Tra Cứu Đơn</a></li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        @if (User.IsInRole("Admin"))
                        {
