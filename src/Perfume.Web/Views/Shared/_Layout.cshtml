            <div>
                <div class="footer-title" style="font-size: 1.15rem; font-weight: 700; margin-bottom: 20px; color: var(--gold-primary);">Đặc Quyền Thành Viên</div>
                <p style="color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 14px;">Đăng ký gia nhập Haute Parfumerie Club để nhận voucher <strong style="color: var(--gold-primary);">LUXE2026</strong> giảm 10%:</p>
                <div style="display: flex; gap: 8px; margin-bottom: 12px;">
                    <input type="email" id="footerNewsletterEmail" aria-label="Địa chỉ email đăng ký nhận ưu đãi" placeholder="Nhập địa chỉ email..." style="background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 10px 14px; border-radius: var(--radius-sm); flex-grow: 1; outline: none; font-size: 0.85rem;" />
                    <button type="button" onclick="handleNewsletterSubscribe()" class="btn-luxe-primary" style="padding: 10px 18px; font-size: 0.82rem; white-space: nowrap;">Đăng Ký</button>
