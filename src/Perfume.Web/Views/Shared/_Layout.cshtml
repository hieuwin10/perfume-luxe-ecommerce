    <!-- Scripts (Non-render-blocking) -->
    <script src="~/js/customer-api.js" asp-append-version="true"></script>
    <script>
        // 1. Theme Management (Dark / Light + Cốc Cốc / Chrome system auto-detection)
        (function() {
            const savedTheme = localStorage.getItem('perfume_luxe_theme');
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = savedTheme ? savedTheme : (prefersDark ? 'dark' : 'dark'); // Default luxury dark
            applyTheme(theme);

            // Listen for system theme change (Cốc Cốc, Chrome, Windows)
            if (window.matchMedia) {
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
                    if (!localStorage.getItem('perfume_luxe_theme')) {
                        applyTheme(e.matches ? 'dark' : 'light');
                    }
                });
            }
        })();

        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            document.body.className = theme === 'dark' ? 'dark-theme' : 'light-theme';
            const icon = document.getElementById('themeIcon');
            if (icon) {
                icon.className = theme === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
            }
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            localStorage.setItem('perfume_luxe_theme', newTheme);
            applyTheme(newTheme);
        }

        // Mini Cart Drawer Logic
        const cartDrawer = document.getElementById('cartDrawer');
        const cartOverlay = document.getElementById('cartOverlay');
        const cartDrawerBtn = document.getElementById('cartDrawerBtn');
        const closeCartBtn = document.getElementById('closeCartBtn');

        function openCart() {
            if (cartDrawer) cartDrawer.style.right = '0';
            if (cartOverlay) cartOverlay.style.display = 'block';
            document.body.style.overflow = 'hidden';
            refreshCartState();
        }

        function closeCart() {
            if (cartDrawer) cartDrawer.style.right = '-420px';
            if (cartOverlay) cartOverlay.style.display = 'none';
            document.body.style.overflow = '';
        }

        if (cartDrawerBtn) cartDrawerBtn.addEventListener('click', openCart);
        if (closeCartBtn) closeCartBtn.addEventListener('click', closeCart);
        if (cartOverlay) cartOverlay.addEventListener('click', closeCart);

        async function refreshCartState() {
            try {
                const res = await CustomerApi.get('/api/v1/cart');
                const cart = res && res.data ? res.data : res;
                const totalCount = cart?.totalCount ?? cart?.totalItems ?? (cart?.items ? cart.items.length : 0);

                const badges = document.querySelectorAll('.cart-count, .badge-count, #headerCartCount, #mobileBottomCartBadge, .cart-count-badge');
                badges.forEach(b => {
                    b.textContent = totalCount;
                    if (b.id === 'mobileBottomCartBadge') {
                        b.style.display = totalCount > 0 ? 'flex' : 'none';
                    }
                });

                const subtotalEl = document.getElementById('cartDrawerSubtotal');
                if (subtotalEl) {
                    subtotalEl.textContent = CustomerApi.formatVnd(cart?.subTotal ?? cart?.finalTotal ?? 0);
                }

                const itemsContainer = document.getElementById('cartDrawerItems');
                if (itemsContainer) {
                    if (!cart || !cart.items || cart.items.length === 0) {
                        itemsContainer.innerHTML = `
                            <div style="text-align: center; padding: 40px 0; color: var(--text-muted);">
                                <i class="fa-solid fa-bag-shopping" style="font-size: 3rem; margin-bottom: 12px; opacity: 0.3;"></i>
                                <p>Giỏ hàng đang trống.</p>
                            </div>`;
                    } else {
                        itemsContainer.innerHTML = cart.items.map(item => `
                            <div class="cart-item-row" style="display: flex; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--border-card);">
                                <img src="${CustomerApi.escapeHtml(item.productImageUrl || '/images/placeholder-perfume.jpg')}" alt="${CustomerApi.escapeHtml(item.productName)}" style="width: 60px; height: 60px; object-fit: contain; background: var(--bg-surface-elevated); border-radius: var(--radius-sm); padding: 4px;" />
                                <div style="flex-grow: 1;">
                                    <div style="font-weight: 600; font-size: 0.88rem; color: var(--text-primary); margin-bottom: 2px;">${CustomerApi.escapeHtml(item.productName)}</div>
                                    <div style="font-size: 0.75rem; color: var(--gold-primary); margin-bottom: 4px;">${CustomerApi.escapeHtml(item.variantLabel || item.variantName || 'Fullbox')} &bull; x${item.quantity}</div>
                                    <div style="font-weight: 700; font-size: 0.85rem; color: var(--text-primary);">${CustomerApi.formatVnd(item.totalPrice ?? item.subTotal ?? (item.unitPrice * item.quantity))}</div>
                                </div>
                                <button type="button" onclick="removeCartItem(${item.productId}, ${item.variantId ?? 'null'})" class="icon-btn" style="width: 28px; height: 28px; color: #ef4444;" aria-label="Xóa"><i class="fa-solid fa-trash-can" style="font-size: 0.75rem;"></i></button>
                            </div>
                        `).join('');
                    }
                }

                // Phát sự kiện toàn cục để các trang như /cart tự động đồng bộ mượt mà không cần F5 reload
                window.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
                return cart;
            } catch (err) {
                console.warn('Could not refresh cart state:', err);
                return null;
            }
        }

        async function addToCart(slug, variantId, qty = 1) {
            try {
                await CustomerApi.post('/api/v1/cart/items', {
                    productSlug: slug,
                    slug: slug,
                    variantId: variantId,
                    quantity: qty
                });
                await refreshCartState();
                openCart();
                showToast('Đã thêm nước hoa vào giỏ hàng!', 'success');
            } catch (err) {
                showToast(err.message || 'Không thể thêm vào giỏ hàng.', 'error');
            }
        }

        async function removeCartItem(productId, variantId) {
            try {
                await CustomerApi.delete(`/api/v1/cart/items/${productId}?variantId=${variantId ?? ''}`);
                const updatedCart = await refreshCartState();
                showToast('Đã xóa sản phẩm khỏi giỏ hàng.', 'info');
                if (window.location.pathname.toLowerCase().startsWith('/checkout')) {
                    if (!updatedCart || !updatedCart.items || updatedCart.items.length === 0) {
                        window.location.assign('/cart');
                    }
                }
            } catch (err) {
                showToast(err.message || 'Chưa xóa được sản phẩm.', 'error');
            }
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = 'toast-luxe';
            let icon = type === 'success' ? 'fa-circle-check text-gold-gradient' : 'fa-circle-info text-gold-gradient';
            toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${CustomerApi.escapeHtml(message)}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        document.getElementById('customerLogoutForm')?.addEventListener('submit', async event => {
            event.preventDefault();
            try { await CustomerApi.post('/api/v1/auth/logout', {}); }
            finally { window.location.assign('/'); }
        });

        // Load cart data only after the page's load event so its API request
        // cannot compete with the hero image and other LCP resources.
        window.addEventListener('load', function initializeCartWhenIdle() {
            if ('requestIdleCallback' in window) {
                requestIdleCallback(refreshCartState, { timeout: 3000 });
            } else {
                setTimeout(refreshCartState, 2000);
            }
        }, { once: true });
    </script>

    <script>
        // Mobile Navigation Drawer Toggle
        const mobileNavToggleBtn = document.getElementById('mobileNavToggleBtn');
        const mobileNavDrawer = document.getElementById('mobileNavDrawer');
        const mobileNavOverlay = document.getElementById('mobileNavOverlay');
        const closeMobileNavBtn = document.getElementById('closeMobileNavBtn');

        function openMobileNav() {
            if (mobileNavDrawer) mobileNavDrawer.classList.add('active');
            if (mobileNavOverlay) mobileNavOverlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeMobileNav() {
            if (mobileNavDrawer) mobileNavDrawer.classList.remove('active');
            if (mobileNavOverlay) mobileNavOverlay.classList.remove('active');
            document.body.style.overflow = '';
        }

        if (mobileNavToggleBtn) mobileNavToggleBtn.addEventListener('click', openMobileNav);
        if (closeMobileNavBtn) closeMobileNavBtn.addEventListener('click', closeMobileNav);
        if (mobileNavOverlay) mobileNavOverlay.addEventListener('click', closeMobileNav);

        // Quick Search Modal Handlers
        const openSearchBtn = document.getElementById('openSearchBtn');
        const searchModalOverlay = document.getElementById('searchModalOverlay');
        const closeSearchModalBtn = document.getElementById('closeSearchModalBtn');
        const globalSearchInput = document.getElementById('globalSearchInput');

        function openSearch() {
            if (searchModalOverlay) {
                searchModalOverlay.style.display = 'flex';
                setTimeout(() => globalSearchInput?.focus(), 100);
                document.body.style.overflow = 'hidden';
            }
        }

        function closeSearch() {
            if (searchModalOverlay) {
                searchModalOverlay.style.display = 'none';
                document.body.style.overflow = '';
            }
        }

        if (openSearchBtn) openSearchBtn.addEventListener('click', openSearch);
        if (closeSearchModalBtn) closeSearchModalBtn.addEventListener('click', closeSearch);
        if (searchModalOverlay) {
            searchModalOverlay.addEventListener('click', (e) => {
                if (e.target === searchModalOverlay) closeSearch();
            });
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeMobileNav();
                closeCart();
                closeSearch();
            }
        });

        // User avatar dropdown toggle with Click Outside
        const userDropdown = document.getElementById('userDropdown');
        const userAvatarBtn = document.getElementById('userAvatarBtn');

        if (userAvatarBtn && userDropdown) {
            userAvatarBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('open');
            });
            document.addEventListener('click', (e) => {
                if (!userDropdown.contains(e.target)) {
                    userDropdown.classList.remove('open');
                }
            });
        }

        // Show TempData success toast
        @if (TempData["Success"] != null)
        {
            var successMsg = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Success"]?.ToString() ?? "");
            <text>
            setTimeout(() => showToast('@successMsg', 'success'), 300);
            </text>
        }

        // Newsletter subscription AJAX
        async function handleNewsletterSubscribe() {
            const input = document.getElementById('footerNewsletterEmail');
            const notice = document.getElementById('newsletterNotice');
            if (!input || !notice) return;
            const email = input.value.trim();

            if (!email || !email.includes('@@') || !email.includes('.')) {
                notice.style.display = 'block';
                notice.style.background = 'rgba(239, 68, 68, 0.15)';
                notice.style.color = '#f87171';
                notice.style.border = '1px solid #ef4444';
                notice.innerText = 'Vui lòng nhập địa chỉ email hợp lệ.';
                return;
            }

            try {
                const res = await fetch('/api/newsletter/subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });
                const data = await res.json();
                notice.style.display = 'block';
                if (data.success) {
                    notice.style.background = 'rgba(46, 204, 113, 0.15)';
                    notice.style.color = '#2ecc71';
                    notice.style.border = '1px solid #2ecc71';
                    notice.textContent = ' ' + data.message;
                    const giftIcon = document.createElement('i');
                    giftIcon.className = 'fa-solid fa-gift';
                    giftIcon.style.marginRight = '6px';
                    notice.prepend(giftIcon);
                    input.value = '';
                    if (typeof showToast === 'function') {
                        showToast(`Mã ưu đãi LUXE2026 đã kích hoạt cho ${email}!`, 'success');
                    }
                } else {
                    notice.style.background = 'rgba(239, 68, 68, 0.15)';
                    notice.style.color = '#f87171';
                    notice.style.border = '1px solid #ef4444';
                    notice.innerText = data.message;
                }
            } catch (err) {
                console.error(err);
                notice.style.display = 'block';
                notice.style.background = 'rgba(239, 68, 68, 0.15)';
                notice.style.color = '#f87171';
                notice.style.border = '1px solid #ef4444';
                notice.innerText = 'Có lỗi xảy ra, vui lòng thử lại sau.';
            }
        }
    </script>

    <!-- Deferred GA4 Analytics -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        (function() {
            var gaInitialized = false;
            function loadGA4() {
                if (gaInitialized) return;
                gaInitialized = true;
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KCWE7ENDEJ';
                document.head.appendChild(s);
                gtag('js', new Date());
                gtag('config', 'G-KCWE7ENDEJ');
            }
            if (window.addEventListener) {
                window.addEventListener('load', function() {
                    setTimeout(function() {
                        if ('requestIdleCallback' in window) {
                            requestIdleCallback(loadGA4, { timeout: 4000 });
                        } else {
                            loadGA4();
                        }
                    }, 5000);
                });
                ['click', 'keydown', 'touchstart'].forEach(function(evt) {
                    window.addEventListener(evt, loadGA4, { once: true, passive: true });
                });
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
