@using Microsoft.AspNetCore.Identity
@inject SignInManager<Perfume.Infrastructure.Identity.AppUser> SignInManager
@inject UserManager<Perfume.Infrastructure.Identity.AppUser> UserManager
@inject IConfiguration Configuration
@{
    var canonicalUrl = ViewData["CanonicalUrl"]?.ToString()
        ?? Perfume.Web.Seo.SeoUrlBuilder.AbsoluteUrl(Context.Request, Configuration, Context.Request.Path);
    var ogUrl = ViewData["OgUrl"]?.ToString() ?? canonicalUrl;
    var requestPath = Context.Request.Path;
    var isPrivatePage = requestPath.StartsWithSegments("/account", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWithSegments("/cart", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWithSegments("/checkout", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWithSegments("/admin", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWithSegments("/tra-cuu-don-hang", StringComparison.OrdinalIgnoreCase)
        || requestPath.StartsWithSegments("/order-tracking", StringComparison.OrdinalIgnoreCase);
    var robotsContent = ViewData["Robots"]?.ToString() ?? (isPrivatePage ? "noindex, nofollow" : "index, follow");
    var pageTitle = ViewData["Title"]?.ToString()?.Trim();
    var documentTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "PERFUME LUXE - Haute Parfumerie | Nước Hoa Cao Cấp Chính Hãng"
        : pageTitle.EndsWith("PERFUME LUXE", StringComparison.OrdinalIgnoreCase)
            ? pageTitle
            : $"{pageTitle} | PERFUME LUXE";
}
<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@documentTitle</title>
    
    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="Qh9rEGR7zfGddcqbtlF1p2H9s544wnJg2TOfQeLgNJs" />

    <!-- Google Analytics 4 (GA4) - Deferred on Idle/Interaction for Maximum Web Vitals -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        (function() {
            var gaInitialized = false;
            function loadGA4() {
                if (gaInitialized) return;
                gaInitialized = true;
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KCWE7ENDEJ';
                document.head.appendChild(s);
                gtag('js', new Date());
                gtag('config', 'G-KCWE7ENDEJ');
            }
            if (window.addEventListener) {
                window.addEventListener('load', function() {
                    if ('requestIdleCallback' in window) {
                        requestIdleCallback(function() { setTimeout(loadGA4, 1500); });
                    } else {
                        setTimeout(loadGA4, 2500);
                    }
                });
                ['scroll', 'touchstart', 'mousemove', 'click', 'keydown'].forEach(function(evt) {
                    window.addEventListener(evt, loadGA4, { once: true, passive: true });
                });
            }
        })();
    </script>

    <!-- Performance Preconnect & DNS-Prefetch -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />

    <!-- Google Fonts (Non-blocking HTML link with preconnect - Essential weights only) -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" /></noscript>
    
    <!-- Meta SEO Google & Social Cards -->
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Thế giới nước hoa cao cấp chính hãng từ các thương hiệu xa xỉ bậc nhất thế giới: Dior, Chanel, Creed, Tom Ford, Le Labo, Kilian. Bảo đảm 100% xuất xứ.")" />
    <meta name="robots" content="@robotsContent" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="PERFUME LUXE" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "PERFUME LUXE - Nước Hoa Xa Xỉ Chính Hãng")" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Bộ sưu tập nước hoa cao cấp, chiết 10ml và fullbox với 3 tầng hương độc bản.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=1200&q=80")" />
    <meta property="og:url" content="@ogUrl" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] ?? "PERFUME LUXE - Nước Hoa Xa Xỉ Chính Hãng")" />
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "Bộ sưu tập nước hoa cao cấp, chiết 10ml và fullbox với 3 tầng hương độc bản.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=1200&q=80")" />

    <!-- Favicon & Brand Theme -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💎</text></svg>" />
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💎</text></svg>" />
    <meta name="theme-color" content="#0B0B0E" />

    @if (ViewData["LcpImage"] != null)
    {
        var lcpDesktop = ViewData["LcpImage"]?.ToString();
        var lcpMobile = ViewData["LcpImageMobile"]?.ToString();
        if (!string.IsNullOrEmpty(lcpMobile) && lcpMobile != lcpDesktop)
        {
            <!-- Responsive preload for LCP image: lightweight WebP for mobile, high-res for desktop -->
            <link rel="preload" as="image" href="@lcpMobile" media="(max-width: 768px)" fetchpriority="high" />
            <link rel="preload" as="image" href="@lcpDesktop" media="(min-width: 769px)" fetchpriority="high" />
        }
        else
        {
            <!-- Preload the actual hero or product image chosen by this page. -->
            <link rel="preload" as="image" href="@lcpDesktop" fetchpriority="high" />
        }
    }

    <!-- Font Awesome Icons (Non-render-blocking) -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" /></noscript>

    <!-- Luxury Theme Stylesheet -->
    <link rel="stylesheet" href="~/css/luxury-perfume.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dark-theme">
    <div hidden aria-hidden="true">@Html.AntiForgeryToken()</div>
    <!-- Top Announcement Bar -->
    <div style="background: var(--bg-surface-elevated); border-bottom: 1px solid var(--border-card); font-size: 0.78rem; padding: 6px 16px; text-align: center; color: var(--text-secondary); display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap; gap: 8px;">
        <div><i class="fa-solid fa-crown text-gold-gradient" style="margin-right: 6px;"></i> Cam kết 100% Nước Hoa Chính Hãng</div>
        <div class="announcement-desktop-only"><i class="fa-solid fa-truck-fast" style="color: var(--gold-primary); margin-right: 6px;"></i> Miễn phí giao hàng toàn quốc từ 2.000.000₫</div>
        <div><i class="fa-solid fa-shield-halved" style="color: var(--gold-primary); margin-right: 6px;"></i> Đổi trả 7 ngày nếu lỗi niêm phong</div>
    </div>

    <!-- Mobile Nav Overlay & Drawer -->
    <div class="mobile-nav-overlay" id="mobileNavOverlay"></div>
    <aside class="mobile-nav-drawer" id="mobileNavDrawer" aria-label="Menu di động">
        <div class="mobile-nav-header">
            <a href="/" class="brand-logo" onclick="closeMobileNav()">
                <span class="brand-title text-gold-gradient" style="font-size: 1.35rem;">PERFUME LUXE</span>
                <span class="brand-sub" style="font-size: 0.58rem;">Haute Parfumerie</span>
            </a>
            <button type="button" class="icon-btn" id="closeMobileNavBtn" aria-label="Đóng menu" style="width: 38px; height: 38px;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="mobile-nav-body">
            <a href="/" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-house"></i> Trang Chủ</a>
            <a href="/bo-suu-tap" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-gem"></i> Bộ Sưu Tập Nước Hoa</a>
            <a href="/catalog/quiz" class="mobile-nav-item" onclick="closeMobileNav()" style="color: var(--gold-primary);"><i class="fa-solid fa-wand-magic-sparkles"></i> AI Trắc Nghiệm Tìm Mùi</a>
            <a href="/discovery-box" class="mobile-nav-item" onclick="closeMobileNav()" style="color: var(--gold-primary);"><i class="fa-solid fa-gift"></i> Hộp Quà Discovery Box</a>
            <a href="/so-sanh" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-scale-balanced"></i> So Sánh Mùi Hương</a>
            <a href="/dat-lich-trai-nghiem" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-crown"></i> Thử Mùi VIP Concierge</a>
            <a href="/tra-cuu-don-hang" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-truck-fast"></i> Tra Cứu Đơn Hàng</a>
            <a href="/blog" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-newspaper"></i> Tạp Chí Mùi Hương</a>
            <a href="/ve-chung-toi" class="mobile-nav-item" onclick="closeMobileNav()"><i class="fa-solid fa-circle-info"></i> Về Chúng Tôi</a>

            <div class="mobile-nav-divider"></div>

            @if (SignInManager.IsSignedIn(User))
            {
                var mobileUser = await UserManager.GetUserAsync(User);
                <div style="padding: 6px 14px 10px; font-size: 0.82rem; color: var(--text-muted);">
                    <div style="font-weight: 700; color: var(--text-primary); font-size: 0.9rem;">@mobileUser?.FullName</div>
                    <div>@mobileUser?.Email</div>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin/admindashboard" class="mobile-nav-item" style="color: #f87171;"><i class="fa-solid fa-gauge-high"></i> Admin Dashboard</a>
                }
                else if (User.IsInRole("StoreManager"))
                {
                    <a href="/admin/storemanager" class="mobile-nav-item" style="color: var(--gold-primary);"><i class="fa-solid fa-chart-line"></i> Quản Lý Cửa Hàng</a>
                }
                <a href="/account/profile" class="mobile-nav-item"><i class="fa-solid fa-user"></i> Tài Khoản Của Tôi</a>
                <a href="/account/myorders" class="mobile-nav-item"><i class="fa-solid fa-box"></i> Đơn Hàng Của Tôi</a>
                <form method="post" action="/account/logout" style="margin: 4px 0 0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="mobile-nav-item" style="width: 100%; border: none; background: none; cursor: pointer; color: #f87171; text-align: left;">
                        <i class="fa-solid fa-right-from-bracket" style="color: #f87171;"></i> Đăng Xuất
                    </button>
                </form>
            }
            else
            {
                <a href="/account/login" class="mobile-nav-item" style="color: var(--gold-primary); font-weight: 600;"><i class="fa-solid fa-right-to-bracket"></i> Đăng Nhập / Đăng Ký</a>
            }
        </div>
        <div class="mobile-nav-footer">
            <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem;">
                <span style="color: var(--text-muted);"><i class="fa-solid fa-phone" style="color: var(--gold-primary); margin-right: 6px;"></i> Hotline VIP:</span>
                <strong style="color: var(--text-primary);">024.3828.9999</strong>
            </div>
        </div>
    </aside>

    <!-- Header Navigation -->
    <header class="luxe-header">
        <div class="header-inner">
            <div style="display: flex; align-items: center; gap: 12px;">
                <!-- Hamburger Button on Mobile -->
                <button type="button" class="mobile-nav-toggle" id="mobileNavToggleBtn" aria-label="Mở Menu điều hướng" title="Mở danh mục">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <a href="/" class="brand-logo">
                    <span class="brand-title text-gold-gradient">PERFUME LUXE</span>
                    <span class="brand-sub">Haute Parfumerie Paris</span>
                </a>
            </div>

            <nav>
                <ul class="nav-links">
                    <li><a href="/" class="nav-link">Trang Chủ</a></li>
                    <li><a href="/bo-suu-tap" class="nav-link">Bộ Sưu Tập</a></li>
                    <li><a href="/catalog/quiz" class="nav-link" style="color: var(--gold-primary);"><i class="fa-solid fa-wand-magic-sparkles" style="margin-right: 4px;"></i> Trắc Nghiệm Mùi</a></li>
                    <li><a href="/blog" class="nav-link">Tạp Chí Mùi Hương</a></li>
                    <li><a href="/ve-chung-toi" class="nav-link">Về Chúng Tôi</a></li>
                    <li><a href="/discovery-box" class="nav-link" style="color: var(--gold-primary);"><i class="fa-solid fa-gift" style="margin-right: 4px;"></i> Discovery Box</a></li>
                    <li><a href="/so-sanh" class="nav-link"><i class="fa-solid fa-scale-balanced" style="margin-right: 4px;"></i> So Sánh</a></li>
                    <li><a href="/dat-lich-trai-nghiem" class="nav-link"><i class="fa-solid fa-crown" style="margin-right: 4px; color: var(--gold-primary);"></i> Thử Mùi VIP</a></li>
                    <li><a href="/tra-cuu-don-hang" class="nav-link" style="color: var(--gold-primary);"><i class="fa-solid fa-truck-fast" style="margin-right: 4px;"></i> Tra Cứu Đơn</a></li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a href="/admin/admindashboard" class="nav-link" style="background: rgba(212,175,55,0.12); padding: 5px 12px; border-radius: 6px; border: 1px solid var(--border-subtle); color: var(--gold-primary); font-size: 0.82rem;"><i class="fa-solid fa-gauge-high" style="margin-right: 4px;"></i> Quản trị</a></li>
                        }
                        else if (User.IsInRole("StoreManager"))
                        {
                            <li><a href="/admin/storemanager" class="nav-link" style="background: rgba(212,175,55,0.12); padding: 5px 12px; border-radius: 6px; border: 1px solid var(--border-subtle); color: var(--gold-primary); font-size: 0.82rem;"><i class="fa-solid fa-chart-line" style="margin-right: 4px;"></i> Quản lý cửa hàng</a></li>
                        }
                    }
                </ul>
            </nav>

            <div class="header-actions">
                <!-- Theme Toggle Button (Dark / Light) -->
                <button type="button" class="icon-btn" id="themeToggleBtn" title="Chuyển đổi Sáng / Tối" aria-label="Chuyển đổi giao diện sáng tối">
                    <i class="fa-solid fa-moon" id="themeIcon"></i>
                </button>

                <!-- Mini Cart Trigger -->
                <button type="button" class="icon-btn" id="cartDrawerBtn" title="Giỏ hàng" aria-label="Xem giỏ hàng của bạn">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span class="badge-count" id="headerCartCount">0</span>
                </button>

                <!-- User Account Button -->
                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    <div class="user-avatar-dropdown" id="userDropdown">
                        <button type="button" id="userAvatarBtn" class="icon-btn" title="Tài khoản của bạn" aria-label="Tài khoản cá nhân" style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--gold-primary), #8B6914); font-weight: 700; font-size: 0.85rem; color: #000;">
                            @((currentUser?.FullName ?? "U").Substring(0, 1).ToUpper())
                        </button>
                        <div class="user-dropdown-menu" id="userDropdownMenu">
                            <div style="padding: 14px 16px; border-bottom: 1px solid var(--border-card);">
                                <div style="font-weight: 700; font-size: 0.92rem; color: var(--text-primary); margin-bottom: 2px;">@currentUser?.FullName</div>
                                <div style="font-size: 0.78rem; color: var(--text-muted);">@currentUser?.Email</div>
                                @if (User.IsInRole("Admin")) { <span class="role-badge-admin">Admin</span> }
                                else if (User.IsInRole("StoreManager")) { <span class="role-badge-manager">Cửa hàng trưởng</span> }
                                else { <span class="role-badge-customer">Khách hàng</span> }
                            </div>
                            <a href="/account/profile" class="dropdown-item-luxe">
                                <i class="fa-solid fa-user-circle"></i> Tài Khoản Của Tôi
                            </a>
                            <a href="/account/myorders" class="dropdown-item-luxe"><i class="fa-solid fa-box"></i> Đơn hàng của tôi</a>
                            <a href="/tra-cuu-don-hang" class="dropdown-item-luxe"><i class="fa-solid fa-truck-fast"></i> Tra Cứu Đơn Hàng</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/admin/admindashboard" class="dropdown-item-luxe"><i class="fa-solid fa-gauge-high"></i> Admin Dashboard</a>
                                <a href="/admin/databaseconsole" class="dropdown-item-luxe"><i class="fa-solid fa-database"></i> Database Console</a>
                            }
                            else if (User.IsInRole("StoreManager"))
                            {
                                <a href="/admin/storemanager" class="dropdown-item-luxe"><i class="fa-solid fa-chart-line"></i> Thống kê cửa hàng</a>
                            }
                            <div style="border-top: 1px solid var(--border-card); margin: 4px 0;"></div>
                            <form method="post" action="/account/logout" id="customerLogoutForm" style="margin: 0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item-luxe" style="width: 100%; text-align: left; background: none; border: none; cursor: pointer; color: #f87171;">
                                    <i class="fa-solid fa-right-from-bracket"></i> Đăng Xuất
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/account/login" class="icon-btn" title="Đăng nhập" aria-label="Đăng nhập tài khoản" style="width: 38px; height: 38px;">
                        <i class="fa-solid fa-user"></i>
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Mini Cart Drawer & Overlay -->
    <div class="drawer-overlay" id="cartOverlay"></div>
    <div class="mini-cart-drawer" id="cartDrawer">
        <div class="drawer-header">
            <div class="drawer-title" style="font-size: 1.3rem; font-weight: 700; margin: 0; color: var(--text-primary);"><i class="fa-solid fa-bag-shopping" style="color: var(--gold-primary); margin-right: 8px;"></i> Giỏ Hàng Của Bạn</div>
            <button type="button" class="icon-btn" id="closeCartBtn" aria-label="Đóng giỏ hàng" style="width: 36px; height: 36px;"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="drawer-body" id="cartDrawerItems">
            <div style="text-align: center; padding: 40px 0; color: var(--text-muted);">
                <i class="fa-solid fa-bag-shopping" style="font-size: 3rem; margin-bottom: 12px; opacity: 0.3;"></i>
                <p>Giỏ hàng đang trống.</p>
            </div>
        </div>
        <div class="drawer-footer">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <span style="color: var(--text-secondary); font-size: 0.95rem;">Tạm tính:</span>
                <span style="font-size: 1.3rem; font-weight: 700; color: var(--gold-primary);" id="cartDrawerSubtotal">0₫</span>
            </div>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <a href="/checkout" class="btn-luxe" style="width: 100%; text-align: center;"><i class="fa-solid fa-lock" style="margin-right: 6px;"></i> Tiến Hành Thanh Toán</a>
                <a href="/cart" class="btn-luxe-outline" style="width: 100%; text-align: center;">Xem Chi Tiết Giỏ Hàng</a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Luxury Footer -->
    <footer style="background: var(--bg-surface); border-top: 1px solid var(--border-subtle); padding: 60px 24px 24px; margin-top: 80px;">
        <div style="max-width: 1360px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 40px; margin-bottom: 40px;">
            <div>
                <span class="brand-title text-gold-gradient" style="font-size: 1.6rem; display: block; margin-bottom: 4px;">PERFUME LUXE</span>
                <span class="brand-sub" style="margin-bottom: 16px; display: block;">Haute Parfumerie Paris</span>
                <p style="color: var(--text-secondary); font-size: 0.88rem; line-height: 1.7; margin-bottom: 20px;">
                    Điểm đến hàng đầu cho những người yêu thích nghệ thuật mùi hương xa xỉ. Mỗi giọt hương là một tác phẩm bất hủ nâng tầm phong cách sống.
                </p>
                <div style="display: flex; gap: 12px; margin-bottom: 20px;">
                    <a href="https://facebook.com/perfumeluxe.vn" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Theo dõi PERFUME LUXE trên Facebook" style="width: 36px; height: 36px;"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="https://instagram.com/perfumeluxe.vn" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Theo dõi PERFUME LUXE trên Instagram" style="width: 36px; height: 36px;"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://tiktok.com/@@perfumeluxe.vn" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Theo dõi PERFUME LUXE trên TikTok" style="width: 36px; height: 36px;"><i class="fa-brands fa-tiktok"></i></a>
