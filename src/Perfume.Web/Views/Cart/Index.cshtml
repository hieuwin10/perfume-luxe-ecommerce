@model CartStateDto
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
    ViewData["Robots"] = "noindex, nofollow";
    decimal subTotal = Model.SubTotal;
    bool hasItems = Model.Items.Any();
}

<div style="max-width: 1100px; margin: 40px auto; padding: 0 24px;">
    <h1 style="font-size: 2.4rem; margin-bottom: 24px;"><i class="fa-solid fa-bag-shopping text-gold-gradient" style="margin-right: 10px;"></i> Giỏ Hàng Của Bạn</h1>

    <!-- ACTIVE CART SECTION (Shown when cart has items) -->
    <div id="cartActiveSection" class="cart-layout-grid" style="display: @(hasItems ? "grid" : "none");">
        <!-- Cart Items Container -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); overflow-x: auto; padding: 20px;">
            <!-- Desktop Table View -->
            <table class="data-table-custom cart-table-desktop">
                <thead>
                    <tr>
                        <th>Sản Phẩm</th>
                        <th>Đơn Giá</th>
                        <th style="text-align: center;">Số Lượng</th>
                        <th>Thành Tiền</th>
                        <th style="width: 40px;"></th>
                    </tr>
                </thead>
                <tbody id="cartTableBody">
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; gap: 14px; align-items: center;">
                                    <img src="@(item.ProductImageUrl ?? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=100&q=80")" style="width: 60px; height: 60px; object-fit: cover; border-radius: var(--radius-sm);" alt="@item.ProductName" />
                                    <div>
                                        <a href="/nuoc-hoa/@item.ProductSlug" style="font-weight: 600; font-size: 0.95rem; display: block;">@item.ProductName</a>
                                        <span style="font-size: 0.78rem; color: var(--gold-primary);">@item.VariantLabel</span>
                                        @if (item.ProductName.Contains("Discovery Box", StringComparison.OrdinalIgnoreCase) || item.VariantLabel.Contains("ống mẫu", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div style="margin-top: 4px;">
                                                <span style="display: inline-block; background: linear-gradient(135deg, rgba(212,175,55,0.22), rgba(212,175,55,0.08)); border: 1px solid var(--gold-primary); color: var(--gold-primary); font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 99px; letter-spacing: 0.04em;">
                                                    <i class="fa-solid fa-gift" style="margin-right: 4px;"></i> HỘP QUÀ DISCOVERY TÙY CHỈNH
                                                </span>
                                            </div>
                                        }
                                        @if (!item.IsAvailable)
                                        {
                                            <span style="display:block;color:#f87171;font-size:.76rem;margin-top:5px">Sản phẩm tạm hết hàng hoặc số lượng đã thay đổi.</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>@item.UnitPrice.ToString("N0")₫</td>
                            <td style="text-align: center;">
                                <div style="display: inline-flex; align-items: center; border: 1px solid var(--border-card); border-radius: 4px;">
                                    <button type="button" onclick="updateItemQty(@item.ProductId, @(item.VariantId?.ToString() ?? "null"), @(item.Quantity - 1))" style="background:none; border:none; color:var(--text-primary); padding: 4px 8px; cursor:pointer;" aria-label="Giảm"><i class="fa-solid fa-minus" style="font-size: 0.7rem;"></i></button>
                                    <span style="padding: 0 8px; font-weight: 600; font-size: 0.85rem;">@item.Quantity</span>
                                    <button type="button" onclick="updateItemQty(@item.ProductId, @(item.VariantId?.ToString() ?? "null"), @(item.Quantity + 1))" style="background:none; border:none; color:var(--text-primary); padding: 4px 8px; cursor:pointer;" aria-label="Tăng"><i class="fa-solid fa-plus" style="font-size: 0.7rem;"></i></button>
                                </div>
                            </td>
                            <td style="font-weight: 700; color: var(--gold-primary);">@item.TotalPrice.ToString("N0")₫</td>
                            <td>
                                <button type="button" onclick="removeCartItem(@item.ProductId, @(item.VariantId?.ToString() ?? "null"))" style="background:none; border:none; color: #E63946; cursor:pointer;" aria-label="Xóa">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Mobile Card List View -->
            <div id="cartCardsMobile" class="cart-cards-mobile">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-card-item">
                        <img src="@(item.ProductImageUrl ?? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=150&q=80")" alt="@item.ProductName" />
                        <div class="cart-card-info">
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                    <a href="/nuoc-hoa/@item.ProductSlug" style="font-weight: 700; font-size: 0.95rem; line-height: 1.3;">@item.ProductName</a>
                                    <button type="button" onclick="removeCartItem(@item.ProductId, @(item.VariantId?.ToString() ?? "null"))" aria-label="Xóa @item.ProductName" style="background: none; border: none; color: #E63946; cursor: pointer; padding: 4px 6px;">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                                <span style="font-size: 0.78rem; color: var(--gold-primary); display: block; margin-top: 2px;">@item.VariantLabel</span>
                                @if (!item.IsAvailable)
                                {
                                    <span style="display:block;color:#f87171;font-size:.76rem;margin-top:4px">Sản phẩm tạm hết hàng.</span>
                                }
                            </div>

                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
                                <div class="cart-card-stepper">
                                    <button type="button" onclick="updateItemQty(@item.ProductId, @(item.VariantId?.ToString() ?? "null"), @(item.Quantity - 1))" aria-label="Giảm"><i class="fa-solid fa-minus" style="font-size: 0.7rem;"></i></button>
                                    <span>@item.Quantity</span>
                                    <button type="button" onclick="updateItemQty(@item.ProductId, @(item.VariantId?.ToString() ?? "null"), @(item.Quantity + 1))" aria-label="Tăng"><i class="fa-solid fa-plus" style="font-size: 0.7rem;"></i></button>
                                </div>
                                <strong style="color: var(--gold-primary); font-size: 1.1rem;">@item.TotalPrice.ToString("N0")₫</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Bespoke Discovery Box Configuration Card (if configured in session/localStorage) -->
            <div id="customDiscoveryCartBanner" style="display: none; margin-top: 18px; padding: 16px; border-radius: 10px; border: 1px solid var(--gold-primary); background: linear-gradient(135deg, rgba(212,175,55,0.12) 0%, rgba(20,20,26,0.92) 100%);"></div>
        </div>

        <!-- Order Summary Card -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 24px; box-shadow: var(--shadow-luxury);">
            <h3 style="font-size: 1.25rem; margin-bottom: 18px; color: var(--gold-primary);">Tóm Tắt Đơn Hàng</h3>
            <div style="display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 0.9rem;">
                <span style="color: var(--text-secondary);">Tạm tính:</span>
                <span id="cartSubtotalText" style="font-weight: 600;">@subTotal.ToString("N0")₫</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 16px; font-size: 0.9rem;">
                <span style="color: var(--text-secondary);">Phí giao hàng:</span>
                <span id="cartShippingFeeText" style="color: #52B788; font-weight: 600;">@(subTotal >= 2000000 ? "Miễn Phí" : "35.000₫")</span>
            </div>
            <div style="border-top: 1px solid var(--border-card); padding-top: 16px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: baseline;">
                <span style="font-weight: 700;">Tổng cộng:</span>
                <span id="cartTotalText" style="font-size: 1.5rem; font-weight: 700; color: var(--gold-primary);">
                    @((subTotal + (subTotal >= 2000000 ? 0 : 35000)).ToString("N0"))₫
                </span>
            </div>
            <a href="/checkout" class="btn-luxe" style="width: 100%; text-align: center; margin-bottom: 12px;">
                <i class="fa-solid fa-lock" style="margin-right: 6px;"></i> Tiến Hành Thanh Toán
            </a>
            <a href="/discovery-box" class="btn-luxe-outline" style="width: 100%; text-align: center; margin-bottom: 10px;">
                <i class="fa-solid fa-gift" style="margin-right: 6px;"></i> Thiết Kế Discovery Box
            </a>
            <a href="/bo-suu-tap" class="btn-luxe-outline" style="width: 100%; text-align: center;">
                Tiếp Tục Chọn Nước Hoa
            </a>
        </div>
    </div>

    <!-- EMPTY CART SECTION (Shown when cart has 0 items) -->
    <div id="cartEmptySection" style="display: @(hasItems ? "none" : "block"); text-align: center; padding: 80px 20px; background: var(--bg-surface); border-radius: var(--radius-md); border: 1px dashed var(--border-card);">
        <i class="fa-solid fa-bag-shopping" style="font-size: 3.5rem; color: var(--gold-primary); margin-bottom: 16px; opacity: 0.4;"></i>
        <h2 style="font-size: 1.6rem; margin-bottom: 8px;">Giỏ Hàng Của Bạn Đang Trống</h2>
        <p style="color: var(--text-secondary); margin-bottom: 24px; font-size: 0.95rem;">Hãy khám phá các tác phẩm mùi hương kinh điển để bắt đầu hành trình khứu giác.</p>
        <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
            <a href="/bo-suu-tap" class="btn-luxe">Khám Phá Nước Hoa Ngay</a>
            <a href="/discovery-box" class="btn-luxe-outline"><i class="fa-solid fa-gift" style="margin-right: 6px;"></i> Tạo Hộp Quà Discovery Box</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function updateItemQty(productId, variantId, qty) {
            try {
                if (qty <= 0) {
                    await removeCartItem(productId, variantId);
                    return;
                }
                await CustomerApi.put('/api/v1/cart/items', { productId, variantId, quantity: qty });
                await refreshCartState();
                showToast('Đã cập nhật số lượng.', 'success');
            } catch (error) {
                showToast(error.message || 'Chưa cập nhật được số lượng.', 'error');
            }
        }

        function renderCartPage(cart) {
            const activeSec = document.getElementById('cartActiveSection');
            const emptySec = document.getElementById('cartEmptySection');
            if (!activeSec || !emptySec) return;

            const items = cart?.items || [];
            if (items.length === 0) {
                activeSec.style.display = 'none';
                emptySec.style.display = 'block';
                return;
            }

            activeSec.style.display = 'grid';
            emptySec.style.display = 'none';

            // 1. Render Desktop Table Body
            const tbody = document.getElementById('cartTableBody');
            if (tbody) {
                tbody.innerHTML = items.map(item => {
                    const isDiscovery = (item.productName || '').toLowerCase().includes('discovery box') ||
                                        (item.variantLabel || '').toLowerCase().includes('ống mẫu');
                    const imgUrl = item.productImageUrl || 'https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=100&q=80';
                    const variantParam = item.variantId !== null && item.variantId !== undefined ? item.variantId : 'null';

                    return `
                        <tr>
                            <td>
                                <div style="display: flex; gap: 14px; align-items: center;">
                                    <img src="${CustomerApi.escapeHtml(imgUrl)}" style="width: 60px; height: 60px; object-fit: cover; border-radius: var(--radius-sm);" alt="${CustomerApi.escapeHtml(item.productName)}" />
                                    <div>
                                        <a href="/nuoc-hoa/${CustomerApi.escapeHtml(item.productSlug)}" style="font-weight: 600; font-size: 0.95rem; display: block;">${CustomerApi.escapeHtml(item.productName)}</a>
                                        <span style="font-size: 0.78rem; color: var(--gold-primary);">${CustomerApi.escapeHtml(item.variantLabel || 'Fullbox')}</span>
                                        ${isDiscovery ? `
                                            <div style="margin-top: 4px;">
                                                <span style="display: inline-block; background: linear-gradient(135deg, rgba(212,175,55,0.22), rgba(212,175,55,0.08)); border: 1px solid var(--gold-primary); color: var(--gold-primary); font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 99px; letter-spacing: 0.04em;">
                                                    <i class="fa-solid fa-gift" style="margin-right: 4px;"></i> HỘP QUÀ DISCOVERY TÙY CHỈNH
                                                </span>
                                            </div>
                                        ` : ''}
                                        ${!item.isAvailable ? '<span style="display:block;color:#f87171;font-size:.76rem;margin-top:5px">Sản phẩm tạm hết hàng hoặc số lượng đã thay đổi.</span>' : ''}
                                    </div>
                                </div>
                            </td>
                            <td>${CustomerApi.formatVnd(item.unitPrice)}</td>
                            <td style="text-align: center;">
                                <div style="display: inline-flex; align-items: center; border: 1px solid var(--border-card); border-radius: 4px;">
                                    <button type="button" onclick="updateItemQty(${item.productId}, ${variantParam}, ${item.quantity - 1})" style="background:none; border:none; color:var(--text-primary); padding: 4px 8px; cursor:pointer;" aria-label="Giảm"><i class="fa-solid fa-minus" style="font-size: 0.7rem;"></i></button>
                                    <span style="padding: 0 8px; font-weight: 600; font-size: 0.85rem;">${item.quantity}</span>
                                    <button type="button" onclick="updateItemQty(${item.productId}, ${variantParam}, ${item.quantity + 1})" style="background:none; border:none; color:var(--text-primary); padding: 4px 8px; cursor:pointer;" aria-label="Tăng"><i class="fa-solid fa-plus" style="font-size: 0.7rem;"></i></button>
                                </div>
                            </td>
                            <td style="font-weight: 700; color: var(--gold-primary);">${CustomerApi.formatVnd(item.totalPrice)}</td>
                            <td>
                                <button type="button" onclick="removeCartItem(${item.productId}, ${variantParam})" style="background:none; border:none; color: #E63946; cursor:pointer;" aria-label="Xóa">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            // 2. Render Mobile Cards View
            const mobileContainer = document.getElementById('cartCardsMobile');
            if (mobileContainer) {
                mobileContainer.innerHTML = items.map(item => {
                    const imgUrl = item.productImageUrl || 'https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=150&q=80';
                    const variantParam = item.variantId !== null && item.variantId !== undefined ? item.variantId : 'null';

                    return `
                        <div class="cart-card-item">
                            <img src="${CustomerApi.escapeHtml(imgUrl)}" alt="${CustomerApi.escapeHtml(item.productName)}" />
                            <div class="cart-card-info">
                                <div>
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                        <a href="/nuoc-hoa/${CustomerApi.escapeHtml(item.productSlug)}" style="font-weight: 700; font-size: 0.95rem; line-height: 1.3;">${CustomerApi.escapeHtml(item.productName)}</a>
                                        <button type="button" onclick="removeCartItem(${item.productId}, ${variantParam})" aria-label="Xóa ${CustomerApi.escapeHtml(item.productName)}" style="background: none; border: none; color: #E63946; cursor: pointer; padding: 4px 6px;">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                    <span style="font-size: 0.78rem; color: var(--gold-primary); display: block; margin-top: 2px;">${CustomerApi.escapeHtml(item.variantLabel || 'Fullbox')}</span>
                                    ${!item.isAvailable ? '<span style="display:block;color:#f87171;font-size:.76rem;margin-top:4px">Sản phẩm tạm hết hàng.</span>' : ''}
                                </div>

                                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
                                    <div class="cart-card-stepper">
                                        <button type="button" onclick="updateItemQty(${item.productId}, ${variantParam}, ${item.quantity - 1})" aria-label="Giảm"><i class="fa-solid fa-minus" style="font-size: 0.7rem;"></i></button>
                                        <span>${item.quantity}</span>
                                        <button type="button" onclick="updateItemQty(${item.productId}, ${variantParam}, ${item.quantity + 1})" aria-label="Tăng"><i class="fa-solid fa-plus" style="font-size: 0.7rem;"></i></button>
                                    </div>
                                    <strong style="color: var(--gold-primary); font-size: 1.1rem;">${CustomerApi.formatVnd(item.totalPrice)}</strong>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            // 3. Update Order Summary
            const subTotal = cart.subTotal || 0;
            const isFreeShipping = subTotal >= 2000000;
            const shippingFee = isFreeShipping ? 0 : 35000;
            const total = subTotal + shippingFee;

            const subTotalEl = document.getElementById('cartSubtotalText');
            if (subTotalEl) subTotalEl.textContent = CustomerApi.formatVnd(subTotal);

            const shippingEl = document.getElementById('cartShippingFeeText');
            if (shippingEl) {
                shippingEl.textContent = isFreeShipping ? 'Miễn Phí' : '35.000₫';
                shippingEl.style.color = isFreeShipping ? '#52B788' : 'var(--text-secondary)';
            }

            const totalEl = document.getElementById('cartTotalText');
            if (totalEl) totalEl.textContent = CustomerApi.formatVnd(total);
        }

        // Lắng nghe sự kiện cart:updated để đồng bộ dữ liệu mượt mà không bao giờ cần F5
        window.addEventListener('cart:updated', (e) => {
            if (e.detail) {
                renderCartPage(e.detail);
            }
        });

        (function renderSavedDiscoveryBoxSummary() {
            const banner = document.getElementById('customDiscoveryCartBanner');
            if (!banner) return;
            try {
                const raw = localStorage.getItem('plx_last_discovery_box');
                if (!raw) return;
                const dbox = JSON.parse(raw);
                if (!dbox || !Array.isArray(dbox.vials) || dbox.vials.length === 0) return;

                const vialsText = dbox.vials.map(v => `${CustomerApi.escapeHtml(v.productName)} (${CustomerApi.escapeHtml(v.volumeMl)}ml)`).join(' + ');
                banner.style.display = 'block';
                banner.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
                        <span style="background: var(--gold-primary); color: #000; font-size: 0.72rem; font-weight: 800; padding: 3px 10px; border-radius: 99px; letter-spacing: 0.05em;">
                            <i class="fa-solid fa-crown"></i> HỘP QUÀ DISCOVERY TÙY CHỈNH
                        </span>
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <a href="/discovery-box" style="font-size: 0.78rem; color: var(--gold-primary); text-decoration: underline;">Tùy chỉnh lại</a>
                            <button type="button" onclick="clearDiscoveryBox()" style="background: none; border: none; color: #f87171; font-size: 0.78rem; cursor: pointer; text-decoration: underline;"><i class="fa-solid fa-trash-can"></i> Xóa</button>
                        </div>
                    </div>
                    <div style="font-size: 0.85rem; color: var(--text-primary); line-height: 1.55;">
                        <div><strong>Vỏ hộp:</strong> ${CustomerApi.escapeHtml(dbox.boxStyleName || 'Hộp Gỗ Sơn Mài Hoàng Gia')}</div>
                        <div><strong>Bộ ống chiết (${dbox.vials.length}):</strong> ${vialsText}</div>
                        ${dbox.greetingMessage ? `<div><strong>Thiệp ép kim (${CustomerApi.escapeHtml(dbox.greetingFont || 'Playfair Display')}):</strong> “${CustomerApi.escapeHtml(dbox.greetingMessage)}”</div>` : ''}
                    </div>
                `;
            } catch (_) { }
        })();

        function clearDiscoveryBox() {
            localStorage.removeItem('plx_last_discovery_box');
            const b = document.getElementById('customDiscoveryCartBanner');
            if (b) b.style.display = 'none';
            showToast('Đã xóa hộp quà Discovery.', 'info');
        }
    </script>
}
@section Styles {
<style>@@media(max-width:850px){#cartActiveSection{grid-template-columns:1fr!important;gap:20px!important}}@@media(max-width:560px){.data-table-custom{min-width:650px}}</style>
}
