@model List<ProductCardDto>
@functions {
    public static string OptimizeThumbnail(string? url, int width = 360, int quality = 75)
    {
        if (string.IsNullOrWhiteSpace(url)) return "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=360&q=75&fm=webp";
        if (!url.Contains("images.unsplash.com")) return url;
        var cleanUrl = System.Text.RegularExpressions.Regex.Replace(url, @"([?&])w=\d+", "$1");
        cleanUrl = System.Text.RegularExpressions.Regex.Replace(cleanUrl, @"([?&])q=\d+", "$1");
        cleanUrl = System.Text.RegularExpressions.Regex.Replace(cleanUrl, @"([?&])fm=\w+", "$1");
        cleanUrl = cleanUrl.Replace("?&", "?").Replace("&&", "&").TrimEnd('&').TrimEnd('?');
        var separator = cleanUrl.Contains("?") ? "&" : "?";
        return $"{cleanUrl}{separator}auto=format&fit=crop&w={width}&q={quality}&fm=webp";
    }
}
@{
    ViewData["Title"] = "Bộ Sưu Tập Nước Hoa Cao Cấp";
    ViewData["MetaDescription"] = "Khám phá danh mục nước hoa cao cấp chính hãng từ các thương hiệu hàng đầu: Dior, Chanel, Creed, Tom Ford, Le Labo, Kilian. Đầy đủ phiên bản chiết 10ml và fullbox.";
    ViewData["OgType"] = "website";
    var filter = ViewBag.Filter as ProductFilterParams ?? new ProductFilterParams();
    var brands = ViewBag.Brands as List<Brand> ?? new List<Brand>();
    var families = ViewBag.Families as List<FragranceFamily> ?? new List<FragranceFamily>();
    var totalCount = ViewBag.TotalCount as int? ?? Model.Count;
}

<div style="max-width: 1360px; margin: 40px auto; padding: 0 24px;">
    <!-- Breadcrumb & Title -->
    <div style="margin-bottom: 30px;">
        <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 8px;">
            <a href="/">Trang Chủ</a> &bull; <span style="color: var(--gold-primary);">Bộ Sưu Tập Nước Hoa</span>
        </div>
        <h1 style="font-size: 2.5rem; margin-bottom: 6px;">Bộ Sưu Tập Nước Hoa Cao Cấp</h1>
        <p style="color: var(--text-secondary); font-size: 0.95rem;">Khám phá @totalCount kiệt tác mùi hương từ các nhà chế tác danh tiếng thế giới.</p>
    </div>

    <!-- Mobile Filter Toggle Button -->
    <button type="button" class="catalog-filter-mobile-trigger" onclick="toggleCatalogFilter()">
        <span><i class="fa-solid fa-filter" style="margin-right: 6px;"></i> Bộ Lọc &amp; Sắp Xếp (@totalCount sản phẩm)</span>
        <span><i class="fa-solid fa-chevron-down" id="catalogFilterArrow"></i></span>
    </button>

    <div class="catalog-layout-grid">
        <!-- Filter Sidebar -->
        <aside class="catalog-filter-sidebar" id="catalogFilterSidebar" style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 24px; position: sticky; top: 100px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="font-size: 1.15rem; color: var(--gold-primary); margin: 0;"><i class="fa-solid fa-filter" style="margin-right: 6px;"></i> Bộ Lọc Tìm Kiếm</h2>
                <a href="/bo-suu-tap" style="font-size: 0.78rem; color: var(--text-muted);">Xóa Lọc</a>
            </div>

            <form method="get" action="/bo-suu-tap" id="filterForm">
                <!-- Search Keyword -->
                <div style="margin-bottom: 20px;">
                    <label for="filterKeyword" style="display: block; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; margin-bottom: 6px; color: var(--text-secondary);">Từ Khóa</label>
                    <input type="text" id="filterKeyword" name="keyword" value="@filter.Keyword" aria-label="Tìm kiếm theo từ khóa" placeholder="Tìm tên, thương hiệu..." style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 8px 12px; border-radius: var(--radius-sm); font-size: 0.85rem; outline: none;" />
                </div>

                <!-- Gender -->
                <div style="margin-bottom: 24px;">
                    <label for="filterGender" style="display: block; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; color: var(--text-secondary);">Giới Tính</label>
                    <select id="filterGender" name="gender" aria-label="Lọc theo giới tính" onchange="this.form.submit()" style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 8px 12px; border-radius: var(--radius-sm); font-size: 0.85rem; outline: none;">
                        <option value="">Tất cả giới tính</option>
                        <option value="Men" selected="@(filter.Gender == GenderTarget.Men)">Nước hoa Nam</option>
                        <option value="Women" selected="@(filter.Gender == GenderTarget.Women)">Nước hoa Nữ</option>
                        <option value="Unisex" selected="@(filter.Gender == GenderTarget.Unisex)">Unisex (Phi giới tính)</option>
                    </select>
                </div>

                <!-- Brands -->
                <div style="margin-bottom: 24px;">
                    <label for="filterBrand" style="display: block; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; color: var(--text-secondary);">Thương Hiệu</label>
                    <select id="filterBrand" name="brandSlug" aria-label="Lọc theo thương hiệu" onchange="this.form.submit()" style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 8px 12px; border-radius: var(--radius-sm); font-size: 0.85rem; outline: none;">
                        <option value="">Tất cả thương hiệu</option>
                        @foreach (var b in brands)
                        {
                            <option value="@b.Slug" selected="@(filter.BrandSlug == b.Slug)">@b.Name</option>
                        }
                    </select>
                </div>

                <!-- Fragrance Family -->
                <div style="margin-bottom: 24px;">
                    <label for="filterFamily" style="display: block; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; color: var(--text-secondary);">Nhóm Hương (Family)</label>
                    <select id="filterFamily" name="familySlug" aria-label="Lọc theo nhóm hương" onchange="this.form.submit()" style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 8px 12px; border-radius: var(--radius-sm); font-size: 0.85rem; outline: none;">
                        <option value="">Tất cả nhóm hương</option>
                        @foreach (var f in families)
                        {
                            <option value="@f.Slug" selected="@(filter.FamilySlug == f.Slug)">@f.Name</option>
                        }
                    </select>
                </div>

                <!-- Sort By -->
                <div style="margin-bottom: 24px;">
                    <label for="filterSortBy" style="display: block; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; color: var(--text-secondary);">Sắp Xếp Theo</label>
                    <select id="filterSortBy" name="sortBy" aria-label="Sắp xếp sản phẩm" onchange="this.form.submit()" style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 8px 12px; border-radius: var(--radius-sm); font-size: 0.85rem; outline: none;">
                        <option value="" selected="@(string.IsNullOrEmpty(filter.SortBy))">Mới nhất</option>
                        <option value="price_asc" selected="@(filter.SortBy == "price_asc")">Giá tăng dần</option>
                        <option value="price_desc" selected="@(filter.SortBy == "price_desc")">Giá giảm dần</option>
                        <option value="rating" selected="@(filter.SortBy == "rating")">Đánh giá cao nhất</option>
                    </select>
                </div>

                <button type="submit" class="btn-luxe" style="width: 100%; padding: 10px; font-size: 0.85rem;">
                    Áp Dụng Bộ Lọc
                </button>
            </form>
        </aside>

        <!-- Product Grid -->
        <div>
            <h2 class="visually-hidden" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;">Danh Sách Nước Hoa Cao Cấp</h2>
            @if (Model.Any())
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px;">
                    @foreach (var p in Model)
                    {
                        <div class="perfume-card">
                            <div class="card-badges">
                                @if (p.IsFlashSale)
                                {
                                    <span class="badge-tag" style="background: linear-gradient(135deg, #ef4444, #f59e0b); color: #FFF; font-weight: 700;"><i class="fa-solid fa-bolt"></i> Flash Sale -@p.FlashSaleDiscountPercent%</span>
                                }
                                @if (p.IsBestSeller)
                                {
                                    <span class="badge-tag tag-hot">Best Seller</span>
                                }
                                @if (p.IsNewArrival)
                                {
                                    <span class="badge-tag tag-new">Mới Về</span>
                                }
                            </div>

                            <a href="/nuoc-hoa/@p.Slug" class="card-img-wrapper">
                                <img src="@OptimizeThumbnail(p.MainImageUrl, 360, 75)" alt="@p.Name" width="300" height="300" loading="lazy" decoding="async" style="aspect-ratio: 1/1; object-fit: contain;" />
                            </a>

                            <div class="card-body">
                                <div class="card-brand">@p.BrandName</div>
                                <h3 class="card-title">
                                    <a href="/nuoc-hoa/@p.Slug">@p.Name</a>
                                </h3>

                                <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 12px;">
                                    <div style="color: var(--gold-primary); font-size: 0.8rem;">
                                        <i class="fa-solid fa-star"></i> @p.RatingAverage.ToString("0.0")
                                    </div>
                                    <span style="font-size: 0.75rem; color: var(--text-muted);">(@p.RatingCount đánh giá)</span>
                                </div>

                                @if (p.TopNotes.Any())
                                {
                                    <div class="card-notes">
                                        @foreach (var note in p.TopNotes)
                                        {
                                            <span class="note-pill"><i class="fa-solid fa-leaf" style="font-size: 0.65rem; color: var(--gold-primary);"></i> @note</span>
                                        }
                                    </div>
                                }

                                <div class="card-footer">
                                    <div>
                                        @if (p.IsFlashSale && p.FlashSalePrice.HasValue)
                                        {
                                            <span style="font-size: 0.7rem; color: #f59e0b; display: block; font-weight: 600;"><i class="fa-solid fa-bolt"></i> Flash Sale</span>
                                            <span class="card-price" style="color: #f59e0b;">@p.FlashSalePrice.Value.ToString("N0")₫</span>
                                            <span style="font-size: 0.7rem; text-decoration: line-through; color: var(--text-muted); display: block;">@p.BasePrice.ToString("N0")₫</span>
                                        }
                                        else
                                        {
                                            <span style="font-size: 0.7rem; color: var(--text-muted); display: block;">Từ</span>
                                            <span class="card-price">@p.BasePrice.ToString("N0")₫</span>
                                        }
                                    </div>
                                    <button type="button" class="btn-luxe" onclick="addToCart('@p.Slug', null, 1)" style="padding: 8px 16px; font-size: 0.78rem;">
                                        <i class="fa-solid fa-bag-shopping"></i> Thêm
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 80px 20px; background: var(--bg-surface); border-radius: var(--radius-md); border: 1px dashed var(--border-card);">
                    <i class="fa-solid fa-magnifying-glass" style="font-size: 3rem; color: var(--gold-primary); margin-bottom: 16px; opacity: 0.5;"></i>
                    <h2 style="font-size: 1.4rem; margin-bottom: 8px;">Không Tìm Thấy Sản Phẩm Phù Hợp</h2>
                    <p style="color: var(--text-secondary); margin-bottom: 20px; font-size: 0.9rem;">Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm của bạn.</p>
                    <a href="/bo-suu-tap" class="btn-luxe-outline">Xóa Bộ Lọc</a>
                </div>
            }
        </div>
    </div>

    <!-- Editorial & FAQ Section for Category SEO Authority -->
    <div style="margin-top: 60px; padding: 40px; background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-lg);">
        <h2 style="font-size: 1.8rem; font-family: var(--font-serif); margin-bottom: 20px; color: var(--gold-primary);">
            Nghệ Thuật Lựa Chọn Nước Hoa Haute Parfumerie Độc Bản
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.8;">
            <div>
                <h3 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 10px;">
                    <i class="fa-solid fa-gem" style="color: var(--gold-primary); margin-right: 8px;"></i>1. Tiêu Chuẩn Nước Hoa Niche Chính Hãng
                </h3>
                <p>Khác biệt hoàn toàn với các dòng nước hoa thương mại đại chúng, nước hoa Niche và Haute Parfumerie tại PERFUME LUXE được sáng tạo bởi các bậc thầy chế tác hương (Master Perfumers) hàng đầu thế giới như Roja Dove, Francis Kurkdjian, Kilian Hennessy. Từng giọt hương chứa đựng hàm lượng tinh dầu tự nhiên quý hiếm bậc nhất như trầm hương Oud hoàng gia, hoa hồng xứ Grasse, long diên hương và diên vĩ Iris Pallida.</p>
            </div>
            <div>
                <h3 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 10px;">
                    <i class="fa-solid fa-flask" style="margin-right: 8px; color: var(--gold-primary);"></i>2. Trải Nghiệm Chiết 10ml & Chai Fullbox
                </h3>
                <p>Để quý khách dễ dàng khám phá và thẩm định độ bám tỏa trên da thật trước khi sở hữu chai nguyên bản, PERFUME LUXE cung cấp quy cách chiết vô trùng 10ml chuẩn hãng với vòi xịt phun sương siêu mịn, cùng chính sách bảo hành vòi xịt và bảo quản hương thơm chuẩn điều kiện nhiệt độ phòng VIP.</p>
            </div>
            <div>
                <h3 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 10px;">
                    <i class="fa-solid fa-shield-halved" style="margin-right: 8px; color: var(--gold-primary);"></i>3. Cam Kết Chất Lượng Tuyệt Đối
                </h3>
                <p>100% sản phẩm có tem chống hàng giả điện tử và mã QR truy xuất lô xuất xưởng từ Pháp, Ý và Anh Quốc. Cam kết hoàn tiền 200% nếu phát hiện sai lệch xuất xứ. Hỗ trợ đổi mùi hương trong vòng 7 ngày và giao hàng hỏa tốc 2H tại nội thành Hà Nội & TP. Hồ Chí Minh.</p>
            </div>
        </div>
    </div>
</div>

<!-- GOOGLE STRUCTURED DATA (JSON-LD) FOR COLLECTION PAGE SEO -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "CollectionPage",
      "@@id": "@($"{Context.Request.Scheme}://{Context.Request.Host}/bo-suu-tap")",
      "name": "Bộ Sưu Tập Nước Hoa Cao Cấp - PERFUME LUXE",
      "description": "Danh mục nước hoa Haute Parfumerie & Niche chính hãng với các phiên bản chiết 10ml và fullbox 100ml.",
      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/bo-suu-tap")",
      "inLanguage": "vi-VN"
    },
    {
      "@@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@@type": "ListItem",
          "position": 1,
          "name": "Trang Chủ",
          "item": "@($"{Context.Request.Scheme}://{Context.Request.Host}")"
        },
        {
          "@@type": "ListItem",
          "position": 2,
          "name": "Bộ Sưu Tập",
          "item": "@($"{Context.Request.Scheme}://{Context.Request.Host}/bo-suu-tap")"
        }
      ]
    },
    {
      "@@type": "ItemList",
      "name": "Danh Sách Nước Hoa Chính Hãng",
      "numberOfItems": @Model.Count,
      "itemListElement": [
      @for (int i = 0; i < Model.Count; i++)
      {
          var p = Model[i];
          <text>
          {
            "@@type": "ListItem",
            "position": @(i + 1),
            "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/nuoc-hoa/{p.Slug}")",
            "name": "@p.Name"
          }@(i < Model.Count - 1 ? "," : "")
          </text>
      }
      ]
    }
  ]
}
</script>

<script>
    function toggleCatalogFilter() {
        const sidebar = document.getElementById('catalogFilterSidebar');
        const arrow = document.getElementById('catalogFilterArrow');
        if (sidebar) {
            sidebar.classList.toggle('open-mobile');
            const isOpen = sidebar.classList.contains('open-mobile');
            if (arrow) {
                arrow.className = isOpen ? 'fa-solid fa-chevron-up' : 'fa-solid fa-chevron-down';
            }
        }
    }
</script>
