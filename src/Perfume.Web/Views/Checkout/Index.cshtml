@model CheckoutRequestDto
@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
    ViewData["Robots"] = "noindex, nofollow";
    var cart = ViewBag.Cart as List<CartItemDto> ?? new List<CartItemDto>();
    decimal subTotal = ViewBag.SubTotal as decimal? ?? cart.Sum(i => i.TotalPrice);
    var loyalty = ViewBag.LoyaltyStatus as LoyaltyStatusDto;
    decimal vipDiscountPercent = loyalty?.DiscountPercent ?? 0m;
    decimal vipDiscountAmount = Math.Round(subTotal * (vipDiscountPercent / 100m), 0, MidpointRounding.AwayFromZero);
    decimal shippingFee = subTotal >= 2000000 ? 0m : 35000m;
    decimal initialFinalTotal = Math.Max(0m, subTotal - vipDiscountAmount + shippingFee);
}

<div style="max-width: 1200px; margin: 40px auto; padding: 0 24px;">
    <h1 style="font-size: 2.4rem; margin-bottom: 24px;">
        <i class="fa-solid fa-lock text-gold-gradient" style="margin-right: 10px;"></i> Thanh Toán Đơn Hàng
    </h1>

    <div id="checkoutApiError" role="alert" hidden="@(ViewBag.Error == null ? "hidden" : null)" style="background: rgba(230, 57, 70, 0.15); border: 1px solid rgba(230, 57, 70, 0.4); color: #E63946; padding: 12px 18px; border-radius: var(--radius-sm); margin-bottom: 24px;">
        @if (ViewBag.Error != null) { <i class="fa-solid fa-triangle-exclamation"></i> @ViewBag.Error }
    </div>

    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        <div id="checkoutGrid" class="checkout-grid-container">
            <!-- Left: Customer Information & Payment -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <!-- Section 1: Customer Details -->
                <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 24px;">
                    <h3 style="font-size: 1.25rem; margin-bottom: 18px; color: var(--gold-primary);"><i class="fa-solid fa-user" style="margin-right: 8px;"></i> Thông Tin Giao Hàng</h3>
                    <div class="form-grid-2col">
                        <div>
                            <label asp-for="CustomerName" style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:var(--text-secondary)">Họ &amp; Tên *</label>
                            <input asp-for="CustomerName" autocomplete="name" required maxlength="120" placeholder="Nguyễn Văn A" style="width:100%;background:var(--bg-surface-elevated);border:1px solid var(--border-card);color:var(--text-primary);padding:10px 14px;border-radius:var(--radius-sm);outline:none;font-size:.88rem" />
                            <span asp-validation-for="CustomerName" style="color:#E63946;font-size:.78rem"></span>
                        </div>
                        <div>
                            <label asp-for="CustomerPhone" style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:var(--text-secondary)">Số điện thoại *</label>
                            <input asp-for="CustomerPhone" type="tel" autocomplete="tel" required maxlength="32" placeholder="0912 345 678" style="width:100%;background:var(--bg-surface-elevated);border:1px solid var(--border-card);color:var(--text-primary);padding:10px 14px;border-radius:var(--radius-sm);outline:none;font-size:.88rem" />
                            <span asp-validation-for="CustomerPhone" style="color:#E63946;font-size:.78rem"></span>
                        </div>
                    </div>
                    <div class="form-grid-2col">
                        <div>
                            <label asp-for="CustomerEmail" style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:var(--text-secondary)">Email nhận xác nhận *</label>
                            <input asp-for="CustomerEmail" type="email" autocomplete="email" required maxlength="254" placeholder="example@gmail.com" style="width:100%;background:var(--bg-surface-elevated);border:1px solid var(--border-card);color:var(--text-primary);padding:10px 14px;border-radius:var(--radius-sm);outline:none;font-size:.88rem" />
                            <span asp-validation-for="CustomerEmail" style="color:#E63946;font-size:.78rem"></span>
                        </div>
                        <div>
                            <label asp-for="City" style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:var(--text-secondary)">Tỉnh / Thành phố</label>
                            <input asp-for="City" autocomplete="address-level1" placeholder="TP. Hồ Chí Minh / Hà Nội" style="width:100%;background:var(--bg-surface-elevated);border:1px solid var(--border-card);color:var(--text-primary);padding:10px 14px;border-radius:var(--radius-sm);outline:none;font-size:.88rem" />
                        </div>
                    </div>
                    <div style="margin-bottom:16px">
                        <label asp-for="ShippingAddress" style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:var(--text-secondary)">Địa chỉ nhận hàng chi tiết *</label>
                        <input asp-for="ShippingAddress" autocomplete="street-address" required maxlength="500" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." style="width:100%;background:var(--bg-surface-elevated);border:1px solid var(--border-card);color:var(--text-primary);padding:10px 14px;border-radius:var(--radius-sm);outline:none;font-size:.88rem" />
                        <span asp-validation-for="ShippingAddress" style="color:#E63946;font-size:.78rem"></span>
                    </div>
                    <div>
                        <label asp-for="OrderNotes" style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:var(--text-secondary)">Ghi chú đơn hàng</label>
                        <textarea asp-for="OrderNotes" rows="2" placeholder="Ghi chú giao giờ hành chính, chỉ đường..." style="width:100%;background:var(--bg-surface-elevated);border:1px solid var(--border-card);color:var(--text-primary);padding:10px 14px;border-radius:var(--radius-sm);outline:none;font-size:.88rem"></textarea>
                    </div>
                </div>

                <!-- Section 2: Luxury Gift Wrapping Experience -->
                <div style="background: linear-gradient(135deg, rgba(212,175,55,0.08) 0%, rgba(20,20,20,0.6) 100%); border: 1px solid var(--gold-primary); border-radius: var(--radius-md); padding: 22px; position: relative;">
                    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 14px;">
                        <div style="display: flex; gap: 12px; align-items: flex-start;">
                            <input type="checkbox" asp-for="IsGiftWrapping" id="chkGiftWrapping" onchange="toggleGiftWrapping(this.checked)" style="width: 20px; height: 20px; accent-color: var(--gold-primary); cursor: pointer; margin-top: 2px;" />
                            <div>
                                <label for="chkGiftWrapping" style="cursor: pointer; font-weight: 700; font-size: 1rem; color: var(--gold-primary); display: flex; align-items: center; gap: 8px;">
                                    <i class="fa-solid fa-gift"></i> Dịch Vụ Gói Quà Hoàng Gia Haute Parfumerie
                                    <span style="font-size: 0.78rem; background: var(--gold-primary); color: #000; padding: 2px 8px; border-radius: 99px; font-weight: 800;">+50.000₫</span>
                                </label>
                                <p style="margin: 6px 0 0; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5;">
                                    Hộp quà nhung đen đặc trưng, thắt nơ ruy-băng lụa vàng kim, niêm phong sáp khắc triện chữ nổi và kèm thiệp chúc mừng viết tay cao cấp.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Gift Message Box (collapsible) -->
                    <div id="giftMessageBox" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px dashed rgba(212,175,55,0.3);">
                        <label asp-for="GiftMessage" style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--gold-primary); margin-bottom: 6px;">
                            <i class="fa-solid fa-feather-pointed" style="margin-right: 6px;"></i> Lời Chúc Viết Tay Trên Thiệp Mỹ Thuật
                        </label>
                        <textarea asp-for="GiftMessage" id="txtGiftMessage" rows="2" maxlength="500" placeholder="VD: Chúc mừng sinh nhật nàng thơ của anh. Mong em luôn ngát hương và rạng rỡ..." style="width:100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 10px 14px; border-radius: var(--radius-sm); outline: none; font-size: 0.88rem; font-style: italic;"></textarea>
                    </div>
                </div>

                <!-- Section 3: Payment Method Selection -->
                <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 24px;">
                    <h3 style="font-size: 1.25rem; margin-bottom: 16px; color: var(--gold-primary);"><i class="fa-solid fa-credit-card" style="margin-right: 8px;"></i> Phương Thức Thanh Toán</h3>
                    
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <!-- Option 1: COD -->
                        <label style="display: flex; align-items: flex-start; gap: 14px; padding: 16px; border: 1px solid var(--border-card); border-radius: var(--radius-sm); cursor: pointer; background: var(--bg-surface-elevated);" class="payment-option-label" id="labelCOD">
                            <input type="radio" asp-for="PaymentMethod" value="@Perfume.Domain.Enums.PaymentMethod.COD" id="radioCOD" checked style="margin-top: 3px; accent-color: var(--gold-primary);" onchange="selectPaymentMethod('COD')" />
                            <div style="flex-grow: 1;">
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <strong style="color: var(--text-primary); font-size: 0.95rem;"><i class="fa-solid fa-money-bill-wave" style="color: #2A9D8F; margin-right: 8px;"></i> Thanh Toán Khi Nhận Hàng (COD)</strong>
                                    <span style="font-size: 0.75rem; color: var(--text-muted);">Phổ biến</span>
                                </div>
                                <p style="margin: 4px 0 0; color: var(--text-secondary); font-size: 0.82rem; line-height: 1.4;">
                                    Bạn kiểm tra kiện hàng niêm phong và thanh toán tiền mặt cho nhân viên vận chuyển khi nhận hàng.
                                </p>
                            </div>
                        </label>

                        <!-- Option 2: VietQR Napas247 -->
                        <label style="display: flex; align-items: flex-start; gap: 14px; padding: 16px; border: 1px solid var(--border-card); border-radius: var(--radius-sm); cursor: pointer; background: var(--bg-surface-elevated);" class="payment-option-label" id="labelVietQR">
                            <input type="radio" asp-for="PaymentMethod" value="@Perfume.Domain.Enums.PaymentMethod.BankTransfer" id="radioVietQR" style="margin-top: 3px; accent-color: var(--gold-primary);" onchange="selectPaymentMethod('VietQR')" />
                            <div style="flex-grow: 1;">
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <strong style="color: var(--text-primary); font-size: 0.95rem;"><i class="fa-solid fa-qrcode" style="color: var(--gold-primary); margin-right: 8px;"></i> Chuyển Khoản Ngân Hàng VietQR Napas247</strong>
                                    <span style="font-size: 0.72rem; background: rgba(42,157,143,0.15); color: #2A9D8F; border: 1px solid rgba(42,157,143,0.3); padding: 2px 8px; border-radius: 4px; font-weight: 700;">Khuyên dùng</span>
                                </div>
                                <p style="margin: 4px 0 0; color: var(--text-secondary); font-size: 0.82rem; line-height: 1.4;">
                                    Quét mã VietQR động tự điền số tiền &amp; nội dung qua Vietcombank hoặc bất kỳ ứng dụng ngân hàng / ví điện tử 24/7.
                                </p>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Right: Order Items & Voucher & Place Order Button -->
            <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 24px; box-shadow: var(--shadow-luxury); position: sticky; top: 20px;">
                <h3 style="font-size: 1.25rem; margin-bottom: 18px; color: var(--gold-primary);">Đơn Hàng Của Bạn (@cart.Count món)</h3>

                <!-- Items list -->
                <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; max-height: 280px; overflow-y: auto;">
                    @foreach (var item in cart)
                    {
                        <div style="display: flex; gap: 12px; align-items: center; border-bottom: 1px solid var(--border-card); padding-bottom: 10px;">
                            <img src="@(item.ProductImageUrl ?? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=80&q=80")" style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;" alt="@item.ProductName" />
                            <div style="flex-grow: 1;">
                                <div style="font-size: 0.85rem; font-weight: 600; line-height: 1.2;">@item.ProductName</div>
                                <div style="font-size: 0.72rem; color: var(--gold-primary);">@item.VariantLabel x @item.Quantity</div>
                            </div>
                            <div style="font-weight: 700; font-size: 0.88rem;">@item.TotalPrice.ToString("N0")₫</div>
                        </div>
                    }
                </div>

                <!-- Voucher Input -->
                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">Mã Giảm Giá / Ưu Đãi (Thử: LUXE2026 hoặc WELCOME)</label>
                    <div style="display: flex; gap: 8px;">
                        <input type="text" id="voucherCodeInput" asp-for="VoucherCode" placeholder="Nhập mã voucher..." style="background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 8px 12px; border-radius: var(--radius-sm); flex-grow: 1; outline: none; font-size: 0.85rem; text-transform: uppercase;" />
                        <button type="button" class="btn-luxe-outline" onclick="applyVoucher()" style="padding: 8px 14px; font-size: 0.8rem;">Áp Dụng</button>
                    </div>
                    <div id="voucherMsg" style="font-size: 0.78rem; margin-top: 6px;"></div>
                </div>

                <!-- VIP Loyalty Status Banner -->
                <div style="margin-bottom: 16px; padding: 12px 14px; border-radius: var(--radius-sm); background: linear-gradient(135deg, rgba(212,175,55,0.12) 0%, rgba(15,23,42,0.6) 100%); border: 1px solid rgba(212,175,55,0.4);">
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <div style="font-size: 0.82rem; font-weight: 700; color: var(--gold-primary);">
                            <i class="fa-solid fa-crown" style="margin-right: 6px;"></i>
                            @if (loyalty != null)
                            {
                                <span>Hạng VIP: @loyalty.CurrentTier (-@vipDiscountPercent.ToString("0")%)</span>
                            }
                            else
                            {
                                <span>Đặc Quyền Thành Viên VIP (-3% / -7% / -12%)</span>
                            }
                        </div>
                        @if (loyalty != null)
                        {
                            <a href="/account/profile" style="font-size: 0.75rem; color: var(--gold-primary); text-decoration: underline;">
                                Xem thẻ VIP &amp; API &rarr;
                            </a>
                        }
                        else
                        {
                            <a href="/account/login?returnUrl=/checkout" style="font-size: 0.75rem; color: var(--gold-primary); text-decoration: underline;">
                                Đăng nhập nhận ưu đãi VIP &rarr;
                            </a>
                        }
                    </div>
                </div>

                <!-- Calculations -->
                <div style="border-top: 1px solid var(--border-card); padding-top: 16px; margin-bottom: 20px; font-size: 0.9rem;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: var(--text-secondary);">Tạm tính:</span>
                        <span id="displaySubTotal" style="font-weight: 600;">@subTotal.ToString("N0")₫</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;" id="vipDiscountRow">
                        <span style="color: var(--gold-primary); font-weight: 600;">
                            <i class="fa-solid fa-crown" style="margin-right: 4px;"></i>Đặc quyền hạng thành viên VIP @(loyalty != null ? $"({loyalty.CurrentTier} -{vipDiscountPercent:0}%)" : "(-3% / -7% / -12%)"):
                        </span>
                        <span id="displayVipDiscount" style="color: #52B788; font-weight: 700;">-@vipDiscountAmount.ToString("N0")₫</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: var(--text-secondary);">Giảm giá Voucher:</span>
                        <span id="displayDiscount" style="color: #E63946; font-weight: 600;">-0₫</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: var(--text-secondary);">Phí vận chuyển:</span>
                        <span style="color: #52B788; font-weight: 600;">@(subTotal >= 2000000 ? "0₫ (Miễn phí)" : "35.000₫")</span>
                    </div>
                    <div id="giftWrappingRow" style="display: none; justify-content: space-between; margin-bottom: 8px; color: var(--gold-primary);">
                        <span><i class="fa-solid fa-gift" style="margin-right: 4px;"></i> Gói quà hoàng gia:</span>
                        <span style="font-weight: 600;">+50.000₫</span>
                    </div>
                    <div style="border-top: 1px solid var(--border-card); padding-top: 12px; display: flex; justify-content: space-between; align-items: baseline;">
                        <span style="font-weight: 700;">Tổng thanh toán:</span>
                        <span id="displayTotal" style="font-size: 1.5rem; font-weight: 700; color: var(--gold-primary);">
                            @initialFinalTotal.ToString("N0")₫
                        </span>
                    </div>
                </div>

                <button type="submit" class="btn-luxe" id="btnPlaceOrder" style="width: 100%; padding: 14px; font-size: 1rem;">
                    <i class="fa-solid fa-check" style="margin-right: 6px;"></i> Xác Nhận Đặt Hàng Ngay
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let baseSubTotal = @subTotal;
        let shippingFee = @(subTotal >= 2000000 ? 0 : 35000);
        let vipDiscountAmount = @vipDiscountAmount;
        let currentDiscount = 0;
        let giftWrappingFee = 0;
        const checkoutForm = document.getElementById('checkoutForm');
        const checkoutError = document.getElementById('checkoutApiError');

        function toggleGiftWrapping(checked) {
            giftWrappingFee = checked ? 50000 : 0;
            const giftBox = document.getElementById('giftMessageBox');
            const giftRow = document.getElementById('giftWrappingRow');
            if (giftBox) giftBox.style.display = checked ? 'block' : 'none';
            if (giftRow) giftRow.style.display = checked ? 'flex' : 'none';
            recalculateTotal();
        }

        function selectPaymentMethod(type) {
            const labelCOD = document.getElementById('labelCOD');
            const labelVietQR = document.getElementById('labelVietQR');
            if (type === 'VietQR') {
                labelVietQR.style.borderColor = 'var(--gold-primary)';
                labelCOD.style.borderColor = 'var(--border-card)';
            } else {
                labelCOD.style.borderColor = 'var(--gold-primary)';
                labelVietQR.style.borderColor = 'var(--border-card)';
            }
        }

        function recalculateTotal() {
            const total = Math.max(0, baseSubTotal - vipDiscountAmount - currentDiscount + shippingFee + giftWrappingFee);
            document.getElementById('displayTotal').innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total);
        }

        checkoutForm?.addEventListener('submit', async event => {
            if (typeof CustomerApi === 'undefined') {
                return; // Let standard form POST proceed
            }
            event.preventDefault();
            const submit = document.getElementById('btnPlaceOrder');
            checkoutError.hidden = true;
            submit.disabled = true;
            submit.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xác nhận đơn…';
            const values = new FormData(checkoutForm);
            
            const isGift = document.getElementById('chkGiftWrapping')?.checked || false;
            const giftMsg = document.getElementById('txtGiftMessage')?.value || '';
            const paymentMethod = document.getElementById('radioVietQR')?.checked ? 1 : 0; // 0=COD, 1=BankTransfer

            try {
                const result = await CustomerApi.post('/api/v1/orders', {
                    customerName: values.get('CustomerName'),
                    customerPhone: values.get('CustomerPhone'),
                    customerEmail: values.get('CustomerEmail'),
                    shippingAddress: values.get('ShippingAddress'),
                    city: values.get('City'),
                    orderNotes: values.get('OrderNotes'),
                    voucherCode: values.get('VoucherCode'),
                    paymentMethod: paymentMethod,
                    isGiftWrapping: isGift,
                    giftMessage: giftMsg
                });
                window.location.assign(result.successUrl || '/account/myorders');
            } catch (error) {
                checkoutError.textContent = error.message || 'Chưa đặt được đơn hàng. Vui lòng thử lại.';
                checkoutError.hidden = false;
            } finally {
                submit.disabled = false;
                submit.innerHTML = '<i class="fa-solid fa-check" style="margin-right: 6px;"></i> Xác Nhận Đặt Hàng Ngay';
            }
        });

        async function applyVoucher() {
            const code = document.getElementById('voucherCodeInput').value;
            const msgEl = document.getElementById('voucherMsg');
            if (!code.trim()) return;

            try {
                const data = await CustomerApi.post('/api/v1/vouchers/validate', { code });

                if (data.valid) {
                    currentDiscount = data.discountAmount;
                    msgEl.style.color = '#52B788';
                    msgEl.innerText = data.message;
                    document.getElementById('displayDiscount').innerText = '-' + new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(currentDiscount);
                    recalculateTotal();
                } else {
                    currentDiscount = 0;
                    msgEl.style.color = '#E63946';
                    msgEl.innerText = data.message;
                    document.getElementById('displayDiscount').innerText = '-0₫';
                    recalculateTotal();
                }
            } catch (err) {
                msgEl.style.color = '#E63946';
                msgEl.innerText = err.message || 'Lỗi kiểm tra voucher.';
            }
        }
    </script>
}
@section Styles {
<style>@@media(max-width:920px){#checkoutGrid{grid-template-columns:1fr!important;gap:22px!important}}@@media(max-width:620px){#checkoutGrid input,#checkoutGrid textarea{font-size:1rem!important}#checkoutGrid [style*="grid-template-columns: 1fr 1fr"]{grid-template-columns:1fr!important}}</style>
}
