@model CheckoutRequestDto
@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
    var cart = ViewBag.Cart as List<CartItemDto> ?? new List<CartItemDto>();
    decimal subTotal = ViewBag.SubTotal as decimal? ?? cart.Sum(i => i.TotalPrice);
}

<div style="max-width: 1200px; margin: 40px auto; padding: 0 24px;">
    <h1 style="font-size: 2.4rem; margin-bottom: 24px;">
        <i class="fa-solid fa-lock text-gold-gradient" style="margin-right: 10px;"></i> Thanh Toán Đơn Hàng
    </h1>

    @if (ViewBag.Error != null)
    {
        <div style="background: rgba(230, 57, 70, 0.15); border: 1px solid rgba(230, 57, 70, 0.4); color: #E63946; padding: 12px 18px; border-radius: var(--radius-sm); margin-bottom: 24px;">
            <i class="fa-solid fa-triangle-exclamation"></i> @ViewBag.Error
        </div>
    }

    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        <div style="display: grid; grid-template-columns: 1fr 420px; gap: 40px; align-items: start;">
            <!-- Left: Customer Information & Payment -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <!-- Section 1: Customer Details -->
                <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 24px;">
                    <h3 style="font-size: 1.25rem; margin-bottom: 18px; color: var(--gold-primary);"><i class="fa-solid fa-user" style="margin-right: 8px;"></i> Thông Tin Giao Hàng</h3>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                        <div>
                            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">Họ & Tên *</label>
                            <input asp-for="CustomerName" required placeholder="Nguyễn Văn A" style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 10px 14px; border-radius: var(--radius-sm); outline: none; font-size: 0.88rem;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">Số Điện Thoại *</label>
                            <input asp-for="CustomerPhone" required placeholder="0912 345 678" style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 10px 14px; border-radius: var(--radius-sm); outline: none; font-size: 0.88rem;" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                        <div>
                            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">Email Nhận Hóa Đơn *</label>
                            <input asp-for="CustomerEmail" type="email" required placeholder="example@gmail.com" style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 10px 14px; border-radius: var(--radius-sm); outline: none; font-size: 0.88rem;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">Tỉnh / Thành Phố</label>
                            <input asp-for="City" placeholder="TP. Hồ Chí Minh / Hà Nội" style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 10px 14px; border-radius: var(--radius-sm); outline: none; font-size: 0.88rem;" />
                        </div>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">Địa Chỉ Nhận Hàng Chi Tiết *</label>
                        <input asp-for="ShippingAddress" required placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 10px 14px; border-radius: var(--radius-sm); outline: none; font-size: 0.88rem;" />
                    </div>

                    <div>
                        <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">Ghi Chú Đơn Hàng</label>
                        <textarea asp-for="OrderNotes" rows="2" placeholder="Ghi chú giao giờ hành chính, đóng gói hộp quà..." style="width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 10px 14px; border-radius: var(--radius-sm); outline: none; font-size: 0.88rem;"></textarea>
                    </div>
                </div>

                <!-- Section 2: Payment Method -->
                <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 24px;">
                    <h3 style="font-size: 1.25rem; margin-bottom: 18px; color: var(--gold-primary);"><i class="fa-solid fa-credit-card" style="margin-right: 8px;"></i> Phương Thức Thanh Toán</h3>
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <label style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; border: 1px solid var(--border-card); border-radius: var(--radius-sm); cursor: pointer; background: var(--bg-surface-elevated);">
                            <input type="radio" asp-for="PaymentMethod" value="COD" checked />
                            <div>
                                <strong style="display: block; font-size: 0.95rem;"><i class="fa-solid fa-money-bill-wave" style="color: #2A9D8F; margin-right: 6px;"></i> Thanh toán khi nhận hàng (COD)</strong>
                                <span style="font-size: 0.8rem; color: var(--text-muted);">Kiểm tra hàng trước khi thanh toán tiền mặt cho shipper</span>
                            </div>
                        </label>
                        <label style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; border: 1px solid var(--border-card); border-radius: var(--radius-sm); cursor: pointer; background: var(--bg-surface-elevated);">
                            <input type="radio" asp-for="PaymentMethod" value="VNPAY" />
                            <div>
                                <strong style="display: block; font-size: 0.95rem;"><i class="fa-solid fa-qrcode text-gold-gradient" style="margin-right: 6px;"></i> Cổng VNPAY / VNPAY-QR</strong>
                                <span style="font-size: 0.8rem; color: var(--text-muted);">Quét mã QR qua ứng dụng ngân hàng hoặc thẻ nội địa</span>
                            </div>
                        </label>
                        <label style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; border: 1px solid var(--border-card); border-radius: var(--radius-sm); cursor: pointer; background: var(--bg-surface-elevated);">
                            <input type="radio" asp-for="PaymentMethod" value="MoMo" />
                            <div>
                                <strong style="display: block; font-size: 0.95rem;"><i class="fa-solid fa-wallet" style="color: #A50064; margin-right: 6px;"></i> Ví điện tử MoMo</strong>
                                <span style="font-size: 0.8rem; color: var(--text-muted);">Thanh toán siêu tốc qua ứng dụng Ví MoMo</span>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Right: Order Items & Voucher & Place Order Button -->
            <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 24px; box-shadow: var(--shadow-luxury);">
                <h3 style="font-size: 1.25rem; margin-bottom: 18px; color: var(--gold-primary);">Đơn Hàng Của Bạn (@cart.Count món)</h3>

                <!-- Items list -->
                <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; max-height: 280px; overflow-y: auto;">
                    @foreach (var item in cart)
                    {
                        <div style="display: flex; gap: 12px; align-items: center; border-bottom: 1px solid var(--border-card); padding-bottom: 10px;">
                            <img src="@(item.ProductImageUrl ?? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=80&q=80")" style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;" alt="@item.ProductName" />
                            <div style="flex-grow: 1;">
                                <div style="font-size: 0.85rem; font-weight: 600; line-height: 1.2;">@item.ProductName</div>
                                <div style="font-size: 0.72rem; color: var(--gold-primary);">@item.VariantLabel x @item.Quantity</div>
                            </div>
                            <div style="font-weight: 700; font-size: 0.88rem;">@item.TotalPrice.ToString("N0")₫</div>
                        </div>
                    }
                </div>

                <!-- Voucher Input -->
                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">Mã Giảm Giá / Ưu Đãi (Thử: LUXE2026 hoặc WELCOME)</label>
                    <div style="display: flex; gap: 8px;">
                        <input type="text" id="voucherCodeInput" asp-for="VoucherCode" placeholder="Nhập mã voucher..." style="background: var(--bg-surface-elevated); border: 1px solid var(--border-card); color: var(--text-primary); padding: 8px 12px; border-radius: var(--radius-sm); flex-grow: 1; outline: none; font-size: 0.85rem; text-transform: uppercase;" />
                        <button type="button" class="btn-luxe-outline" onclick="applyVoucher()" style="padding: 8px 14px; font-size: 0.8rem;">Áp Dụng</button>
                    </div>
                    <div id="voucherMsg" style="font-size: 0.78rem; margin-top: 6px;"></div>
                </div>

                <!-- Calculations -->
                <div style="border-top: 1px solid var(--border-card); padding-top: 16px; margin-bottom: 20px; font-size: 0.9rem;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: var(--text-secondary);">Tạm tính:</span>
                        <span id="displaySubTotal" style="font-weight: 600;">@subTotal.ToString("N0")₫</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: var(--text-secondary);">Giảm giá:</span>
                        <span id="displayDiscount" style="color: #E63946; font-weight: 600;">-0₫</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                        <span style="color: var(--text-secondary);">Phí vận chuyển:</span>
                        <span style="color: #52B788; font-weight: 600;">@(subTotal >= 2000000 ? "0₫ (Miễn phí)" : "35.000₫")</span>
                    </div>
                    <div style="border-top: 1px solid var(--border-card); padding-top: 12px; display: flex; justify-content: space-between; align-items: baseline;">
                        <span style="font-weight: 700;">Tổng thanh toán:</span>
                        <span id="displayTotal" style="font-size: 1.5rem; font-weight: 700; color: var(--gold-primary);">
                            @((subTotal + (subTotal >= 2000000 ? 0 : 35000)).ToString("N0"))₫
                        </span>
                    </div>
                </div>

                <button type="submit" class="btn-luxe" style="width: 100%; padding: 14px; font-size: 1rem;">
                    <i class="fa-solid fa-check" style="margin-right: 6px;"></i> Xác Nhận Đặt Hàng Ngay
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let baseSubTotal = @subTotal;
        let shippingFee = @(subTotal >= 2000000 ? 0 : 35000);
        let currentDiscount = 0;

        async function applyVoucher() {
            const code = document.getElementById('voucherCodeInput').value;
            const msgEl = document.getElementById('voucherMsg');
            if (!code.trim()) return;

            try {
                const res = await fetch('/Checkout/CheckVoucher', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code })
                });
                const data = await res.json();

                if (data.valid) {
                    currentDiscount = data.discount;
                    msgEl.style.color = '#52B788';
                    msgEl.innerText = data.message;
                    document.getElementById('displayDiscount').innerText = '-' + new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(currentDiscount);
                    
                    const total = Math.max(0, baseSubTotal - currentDiscount + shippingFee);
                    document.getElementById('displayTotal').innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total);
                } else {
                    currentDiscount = 0;
                    msgEl.style.color = '#E63946';
                    msgEl.innerText = data.message;
                    document.getElementById('displayDiscount').innerText = '-0₫';
                    const total = baseSubTotal + shippingFee;
                    document.getElementById('displayTotal').innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total);
                }
            } catch (err) {
                msgEl.style.color = '#E63946';
                msgEl.innerText = 'Lỗi kiểm tra voucher.';
            }
        }
    </script>
}
