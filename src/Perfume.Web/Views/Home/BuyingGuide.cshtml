@{
    ViewData["Title"] = "Hướng Dẫn Mua Hàng & Phương Thức Thanh Toán - PERFUME LUXE";
    ViewData["MetaDescription"] = "Cẩm nang hướng dẫn đặt mua nước hoa chính hãng trực tuyến tại PERFUME LUXE, các phương thức thanh toán an toàn và thời gian giao hàng toàn quốc.";
}

<div style="background: radial-gradient(circle at center, rgba(212, 175, 55, 0.1) 0%, rgba(10, 10, 10, 0.98) 75%); padding: 70px 24px; text-align: center; border-bottom: 1px solid var(--border-card);">
    <div style="max-width: 800px; margin: 0 auto;">
        <span style="display: inline-block; padding: 4px 16px; background: rgba(212,175,55,0.12); border: 1px solid rgba(212,175,55,0.3); border-radius: 20px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.25em; color: var(--gold-primary); font-weight: 700; margin-bottom: 16px;">
            Trải Nghiệm Mua Sắm Liền Mạch
        </span>
        <h1 style="font-size: 3rem; font-family: var(--font-serif); font-weight: 700; margin-bottom: 16px;">
            Hướng Dẫn Mua Hàng Trực Tuyến
        </h1>
        <p style="font-size: 1rem; color: var(--text-secondary); line-height: 1.8;">
            Tận hưởng quy trình đặt hàng tinh gọn, đóng gói sang trọng như quà tặng và giao hàng hỏa tốc an toàn.
        </p>
    </div>
</div>

<div style="max-width: 960px; margin: 60px auto; padding: 0 24px; font-size: 0.95rem; line-height: 1.8; color: var(--text-secondary);">
    <!-- Các bước đặt hàng -->
    <h2 style="font-size: 1.6rem; font-family: var(--font-serif); color: var(--text-primary); margin-bottom: 24px;">
        Quy Trình 4 Bước Đặt Hàng Nhanh Chóng
    </h2>

    <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 45px;">
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); padding: 24px; border-radius: var(--radius-md); display: flex; gap: 20px; align-items: flex-start;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--gold-primary); color: #000; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">1</div>
            <div>
                <h3 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 6px;">Chọn Lựa Sản Phẩm & Dung Tích Mong Muốn</h3>
                <p style="margin: 0;">Duyệt qua danh mục <a href="/bo-suu-tap" style="color: var(--gold-primary);">Bộ Sưu Tập</a> hoặc làm bài <a href="/catalog/quiz" style="color: var(--gold-primary);">AI Fragrance Finder Quiz</a> để tìm chai hương chân ái. Chọn dung tích chiết 10ml hoặc Fullbox 50ml/100ml.</p>
            </div>
        </div>

        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); padding: 24px; border-radius: var(--radius-md); display: flex; gap: 20px; align-items: flex-start;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--gold-primary); color: #000; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">2</div>
            <div>
                <h3 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 6px;">Thêm Vào Giỏ Hàng & Nhập Mã Ưu Đãi</h3>
                <p style="margin: 0;">Kiểm tra giỏ hàng và áp dụng mã voucher như <strong style="color: var(--gold-primary);">LUXE2026</strong> (giảm 10% cho thành viên mới) hoặc <strong style="color: var(--gold-primary);">FREESHIP</strong> cho đơn từ 2.000.000₫.</p>
            </div>
        </div>

        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); padding: 24px; border-radius: var(--radius-md); display: flex; gap: 20px; align-items: flex-start;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--gold-primary); color: #000; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">3</div>
            <div>
                <h3 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 6px;">Điền Thông Tin Giao Nhận & Phương Thức Thanh Toán</h3>
                <p style="margin: 0;">Cung cấp họ tên, số điện thoại và địa chỉ nhận hàng chính xác. Lựa chọn phương thức thanh toán thuận tiện nhất (COD nhận hàng thanh toán, VNPAY, MoMo hoặc Chuyển khoản).</p>
            </div>
        </div>

        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); padding: 24px; border-radius: var(--radius-md); display: flex; gap: 20px; align-items: flex-start;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--gold-primary); color: #000; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">4</div>
            <div>
                <h3 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 6px;">Nhận Hàng & Đồng Kiểm Cùng Shipper</h3>
                <p style="margin: 0;">Kiện hàng được đóng gói trong hộp chống sốc chuyên dụng kèm túi giấy và ruy băng nhung thương hiệu. Quý khách được quyền kiểm tra ngoại quan trước khi thanh toán.</p>
            </div>
        </div>
    </div>

    <!-- Phương thức thanh toán -->
    <h2 style="font-size: 1.6rem; font-family: var(--font-serif); color: var(--text-primary); margin: 30px 0 20px;">
        Các Phương Thức Thanh Toán Hỗ Trợ
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px;">
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); padding: 20px; border-radius: var(--radius-sm); text-align: center;">
            <i class="fa-solid fa-hand-holding-dollar" style="font-size: 2rem; color: var(--gold-primary); margin-bottom: 10px;"></i>
            <h4 style="color: var(--text-primary); margin-bottom: 6px;">COD Toàn Quốc</h4>
            <p style="font-size: 0.82rem; margin: 0;">Thanh toán tiền mặt khi nhận hàng</p>
        </div>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); padding: 20px; border-radius: var(--radius-sm); text-align: center;">
            <i class="fa-solid fa-qrcode" style="font-size: 2rem; color: var(--gold-primary); margin-bottom: 10px;"></i>
            <h4 style="color: var(--text-primary); margin-bottom: 6px;">Cổng VNPAY-QR</h4>
            <p style="font-size: 0.82rem; margin: 0;">Quét mã trực tiếp qua app ngân hàng</p>
        </div>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); padding: 20px; border-radius: var(--radius-sm); text-align: center;">
            <i class="fa-solid fa-building-columns" style="font-size: 2rem; color: var(--gold-primary); margin-bottom: 10px;"></i>
            <h4 style="color: var(--text-primary); margin-bottom: 6px;">Chuyển Khoản 24/7</h4>
            <p style="font-size: 0.82rem; margin: 0;">Xác nhận tự động trong 30 giây</p>
        </div>
    </div>
</div>
