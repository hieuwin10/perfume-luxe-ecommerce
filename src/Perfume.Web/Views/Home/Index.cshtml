@using Perfume.Application.DTOs
@{
    ViewData["Title"] = "Nước Hoa Niche & Haute Parfumerie Chính Hãng";
    var activeFlashSale = ViewBag.ActiveFlashSale as FlashSaleDto;
    var featured = ViewBag.FeaturedProducts as List<ProductCardDto> ?? new List<ProductCardDto>();
    var bestSellers = ViewBag.BestSellers as List<ProductCardDto> ?? new List<ProductCardDto>();
    var brands = ViewBag.Brands as List<Brand> ?? new List<Brand>();
    var families = ViewBag.Families as List<FragranceFamily> ?? new List<FragranceFamily>();
    var blogs = ViewBag.RecentBlogs as List<BlogPost> ?? new List<BlogPost>();
    var heroBanners = ViewBag.HeroBanners as List<HeroBanner> ?? new List<HeroBanner>();
    ViewData["LcpImage"] = heroBanners.FirstOrDefault()?.ImageUrl
        ?? "https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?auto=format&fit=crop&w=1920&q=80";
}

<partial name="Partials/_HeroSliderPartial" model="heroBanners" />

<!-- BRAND CAROUSEL / LOGOS -->
<section style="background: var(--bg-surface); border-bottom: 1px solid var(--border-card); padding: 30px 24px;">
    <div style="max-width: 1360px; margin: 0 auto; display: flex; align-items: center; justify-content: space-around; flex-wrap: wrap; gap: 28px; opacity: 0.85;">
        <span style="font-family: var(--font-heading); font-size: 1.5rem; letter-spacing: 0.15em; font-weight: 700;">DIOR</span>
        <span style="font-family: var(--font-heading); font-size: 1.5rem; letter-spacing: 0.15em; font-weight: 700;">CHANEL</span>
        <span style="font-family: var(--font-heading); font-size: 1.5rem; letter-spacing: 0.15em; font-weight: 700;">CREED</span>
        <span style="font-family: var(--font-heading); font-size: 1.5rem; letter-spacing: 0.15em; font-weight: 700;">TOM FORD</span>
        <span style="font-family: var(--font-heading); font-size: 1.5rem; letter-spacing: 0.15em; font-weight: 700;">LE LABO</span>
        <span style="font-family: var(--font-heading); font-size: 1.5rem; letter-spacing: 0.15em; font-weight: 700;">KILIAN</span>
        <span style="font-family: var(--font-heading); font-size: 1.5rem; letter-spacing: 0.15em; font-weight: 700;">MAISON MARGIELA</span>
    </div>
</section>

<!-- FLASH SALE BANNER WITH REAL-TIME COUNTDOWN TIMER -->
@if (activeFlashSale != null && activeFlashSale.IsOngoing && activeFlashSale.Items.Any())
{
    <section id="flashSaleSection" style="max-width: 1360px; margin: 60px auto 40px; padding: 0 24px;">
        <div style="background: radial-gradient(circle at top right, rgba(245, 158, 11, 0.15) 0%, rgba(20, 20, 25, 0.95) 60%), #141419; border: 1px solid rgba(245, 158, 11, 0.4); border-radius: var(--radius-lg); padding: 36px 32px; box-shadow: 0 16px 50px rgba(0,0,0,0.7), 0 0 25px rgba(245, 158, 11, 0.2); position: relative; overflow: hidden;">
            
            <div style="position: absolute; top: -50px; left: 20%; width: 300px; height: 100px; background: rgba(245, 158, 11, 0.15); filter: blur(50px); pointer-events: none;"></div>

            <!-- Banner Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; margin-bottom: 32px; border-bottom: 1px solid rgba(245, 158, 11, 0.2); padding-bottom: 24px;">
                <div>
                    <div style="display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(245, 158, 11, 0.25)); border: 1px solid rgba(245, 158, 11, 0.5); padding: 6px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: #f59e0b; margin-bottom: 10px;">
                        <i class="fa-solid fa-bolt" style="color: #ef4444;"></i> FLASH SALE GIỜ VÀNG
                    </div>
                    <h2 style="font-size: clamp(1.8rem, 3vw, 2.4rem); margin: 0 0 6px; color: #FFF; font-family: var(--font-heading);">
                        @activeFlashSale.Name
                    </h2>
                    <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
                        @(activeFlashSale.Description ?? "Ưu đãi đặc quyền cho các kiệt tác mùi hương cao cấp với số lượng giới hạn.")
                    </p>
                </div>

                <!-- Real-time Countdown Timer -->
                <div id="flashCountdownContainer" style="display: flex; align-items: center; gap: 12px; background: rgba(11, 11, 14, 0.85); border: 1px solid rgba(212, 175, 55, 0.3); padding: 12px 20px; border-radius: var(--radius-md); box-shadow: 0 8px 24px rgba(0,0,0,0.5);">
                    <div style="text-align: center; margin-right: 4px;">
                        <span style="display: block; font-size: 0.7rem; color: var(--gold-primary); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700;">Kết Thúc Sau</span>
                    </div>
                    <div class="timer-box" style="text-align: center;">
                        <div id="timerDays" style="font-size: 1.6rem; font-weight: 800; font-family: var(--font-heading); background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; min-width: 40px;">00</div>
                        <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase;">Ngày</div>
                    </div>
                    <span style="font-size: 1.4rem; font-weight: 700; color: var(--gold-primary); line-height: 1;">:</span>
                    <div class="timer-box" style="text-align: center;">
                        <div id="timerHours" style="font-size: 1.6rem; font-weight: 800; font-family: var(--font-heading); background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; min-width: 40px;">00</div>
                        <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase;">Giờ</div>
                    </div>
                    <span style="font-size: 1.4rem; font-weight: 700; color: var(--gold-primary); line-height: 1;">:</span>
                    <div class="timer-box" style="text-align: center;">
                        <div id="timerMinutes" style="font-size: 1.6rem; font-weight: 800; font-family: var(--font-heading); background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; min-width: 40px;">00</div>
                        <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase;">Phút</div>
                    </div>
                    <span style="font-size: 1.4rem; font-weight: 700; color: var(--gold-primary); line-height: 1;">:</span>
                    <div class="timer-box" style="text-align: center;">
                        <div id="timerSeconds" style="font-size: 1.6rem; font-weight: 800; font-family: var(--font-heading); background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; min-width: 40px;">00</div>
                        <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase;">Giây</div>
                    </div>
                </div>
            </div>

            <!-- Flash Sale Products Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
                @foreach (var item in activeFlashSale.Items)
                {
                    var soldPercent = item.StockLimit > 0 ? (int)Math.Min(100, Math.Round((double)item.SoldQuantity / item.StockLimit * 100)) : 0;
                    bool isSoldOut = item.RemainingQuantity <= 0;

                    <div class="flash-sale-product-card" 
                         data-product-id="@item.ProductId"
                         data-base-price="@item.OriginalPrice"
                         data-flash-price="@item.FlashSalePrice"
                         data-sold-out="@isSoldOut.ToString().ToLower()"
                         style="background: var(--bg-surface-elevated); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: var(--radius-md); padding: 18px; display: flex; flex-direction: column; position: relative; transition: transform 0.3s ease, border-color 0.3s ease;">
                        
                        <div class="flash-badge-container" style="position: absolute; top: 12px; left: 12px; z-index: 2;">
                            <span class="badge-tag flash-badge" style="background: linear-gradient(135deg, #ef4444, #f59e0b); color: #FFF; font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 20px; box-shadow: 0 4px 10px rgba(239, 68, 68, 0.4);">
                                <i class="fa-solid fa-bolt"></i> GIẢM @item.DiscountPercent%
                            </span>
                        </div>

                        <a href="/nuoc-hoa/@item.ProductSlug" style="display: block; width: 100%; height: 220px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 14px; background: #000;">
                            <img src="@(item.ProductImageUrl ?? "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=800&q=80")" alt="@item.ProductName" loading="lazy" decoding="async" width="400" height="400" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;" />
                        </a>

                        <div style="font-size: 0.75rem; color: var(--gold-primary); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 4px;">
                            @(item.BrandName ?? "Haute Parfumerie")
                        </div>
                        <h3 style="font-size: 1.1rem; margin: 0 0 12px; line-height: 1.3;">
                            <a href="/nuoc-hoa/@item.ProductSlug" style="color: #FFF; text-decoration: none;">@item.ProductName</a>
                        </h3>

                        <div class="pricing-container" style="margin-bottom: 14px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;">
                            <span class="current-price" style="font-size: 1.35rem; font-weight: 800; color: #f59e0b;">
                                @item.FlashSalePrice.ToString("N0")₫
                            </span>
                            <span class="original-price" style="font-size: 0.85rem; text-decoration: line-through; color: var(--text-muted);">
                                @item.OriginalPrice.ToString("N0")₫
                            </span>
                        </div>

                        <div class="stock-progress-container" style="margin-bottom: 16px;">
                            <div style="display: flex; justify-content: space-between; font-size: 0.75rem; margin-bottom: 6px; color: var(--text-secondary);">
                                <span class="stock-text"><i class="fa-solid fa-fire" style="color: #ef4444; margin-right: 4px;"></i> Đã bán @item.SoldQuantity/@item.StockLimit</span>
                                <span class="stock-percent">@soldPercent%</span>
                            </div>
                            <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;">
                                <div class="progress-bar-fill" style="width: @soldPercent%; height: 100%; background: linear-gradient(90deg, #ef4444, #f59e0b); border-radius: 3px;"></div>
                            </div>
                        </div>

                        <div style="margin-top: auto;">
                            @if (!isSoldOut)
                            {
                                <button type="button" class="btn-luxe buy-btn" onclick="addToCart('@item.ProductSlug', @(item.VariantId.HasValue ? item.VariantId.Value.ToString() : "null"), 1)" style="width: 100%; padding: 10px; font-size: 0.85rem; font-weight: 700;">
                                    <i class="fa-solid fa-bolt" style="margin-right: 6px;"></i> Sở Hữu Ngay
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn-luxe-outline buy-btn" disabled style="width: 100%; padding: 10px; font-size: 0.85rem; opacity: 0.6; cursor: not-allowed;">
                                    Đã Hết Suất Flash Sale
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Real-time Countdown & Auto-Reversion Script -->
    <script>
        (function() {
            const endTimeStr = '@activeFlashSale.EndTime.ToString("o")';
            const endTime = new Date(endTimeStr).getTime();

            function updateFlashTimer() {
                const now = new Date().getTime();
                const distance = endTime - now;

                if (distance <= 0) {
                    clearInterval(timerInterval);
                    handleFlashSaleExpired();
                    return;
                }

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                const dEl = document.getElementById('timerDays');
                const hEl = document.getElementById('timerHours');
                const mEl = document.getElementById('timerMinutes');
                const sEl = document.getElementById('timerSeconds');

                if (dEl) dEl.innerText = String(days).padStart(2, '0');
                if (hEl) hEl.innerText = String(hours).padStart(2, '0');
                if (mEl) mEl.innerText = String(minutes).padStart(2, '0');
                if (sEl) sEl.innerText = String(seconds).padStart(2, '0');
            }

            function handleFlashSaleExpired() {
                const container = document.getElementById('flashCountdownContainer');
                if (container) {
                    container.innerHTML = '<span style="color: #ef4444; font-weight: 700; font-size: 0.9rem;"><i class="fa-solid fa-circle-exclamation"></i> Chiến Dịch Đã Kết Thúc</span>';
                }

                const cards = document.querySelectorAll('.flash-sale-product-card');
                cards.forEach(card => {
                    const basePrice = Number(card.getAttribute('data-base-price')) || 0;
                    const priceEl = card.querySelector('.current-price');
                    const origEl = card.querySelector('.original-price');
                    const badgeEl = card.querySelector('.flash-badge');
                    const buyBtn = card.querySelector('.buy-btn');

                    if (priceEl && basePrice > 0) {
                        priceEl.innerText = basePrice.toLocaleString('vi-VN') + '₫';
                        priceEl.style.color = 'var(--text-primary)';
                    }
                    if (origEl) origEl.style.display = 'none';
                    if (badgeEl) badgeEl.style.display = 'none';
                    if (buyBtn) {
                        buyBtn.innerHTML = '<i class="fa-solid fa-bag-shopping"></i> Thêm Vào Giỏ';
                        buyBtn.classList.remove('btn-luxe');
                        buyBtn.classList.add('btn-luxe-outline');
                    }
                });
            }

            updateFlashTimer();
            const timerInterval = setInterval(updateFlashTimer, 1000);
        })();
    </script>
}

<!-- FEATURED PERFUMES (BỘ SƯU TẬP TIÊU BIỂU) -->
<section style="max-width: 1360px; margin: 80px auto; padding: 0 24px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; flex-wrap: wrap; gap: 16px;">
        <div>
            <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--gold-primary); font-weight: 600;">Tuyển Chọn Độc Quyền</span>
            <h2 style="font-size: 2.4rem; margin-top: 4px;">Kiệt Tác Mùi Hương Nổi Bật</h2>
        </div>
        <a href="/bo-suu-tap" class="btn-luxe-outline" style="padding: 8px 20px; font-size: 0.82rem;">
            Khám Phá Toàn Bộ Tuyển Chọn (@featured.Count+ Mùi Hương) <i class="fa-solid fa-arrow-right" style="margin-left: 6px;"></i>
        </a>
    </div>

    @if (featured.Any())
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px;">
            @foreach (var p in featured)
            {
                <partial name="Partials/_ProductCardPartial" model="p" />
            }
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 60px 20px; background: var(--bg-surface); border-radius: var(--radius-md); border: 1px dashed var(--border-card);">
            <i class="fa-solid fa-database" style="font-size: 2.5rem; color: var(--gold-primary); margin-bottom: 16px;"></i>
            <h3 style="font-size: 1.4rem; margin-bottom: 8px;">Cơ Sở Dữ Liệu Chưa Được Nạp Sản Phẩm Mẫu</h3>
            <p style="color: var(--text-secondary); max-width: 550px; margin: 0 auto 24px; font-size: 0.9rem;">
                Bạn có thể nhấn vào <strong>Quản Lý CSDL (Admin)</strong> để kiểm tra các bảng và thực hiện <strong>1-Click Nạp Dữ Liệu Mẫu</strong> từ file <code>scripts/seed_perfume_data.sql</code> ngay lập tức!
            </p>
            <a href="/admin/databaseconsole" class="btn-luxe">
                <i class="fa-solid fa-terminal" style="margin-right: 6px;"></i> Mở Console Nạp Data
            </a>
        </div>
    }
</section>

<!-- FRAGRANCE FINDER QUIZ TEASER -->
<section style="background: var(--bg-surface); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); padding: 80px 24px;">
    <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 50px; align-items: center;">
        <div>
            <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--gold-primary); font-weight: 700;">AI Fragrance Finder</span>
            <h2 style="font-size: 2.6rem; margin: 12px 0 20px; line-height: 1.2;">
                Trắc Nghiệm Khám Phá <br /><span class="text-gold-gradient">Mùi Hương Định Danh</span>
            </h2>
            <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.8; margin-bottom: 30px;">
                Mỗi con người mang một trường năng lượng và phong thái riêng biệt. Chỉ với 3 câu hỏi nhanh về sở thích, tính cách và dịp sử dụng, hệ thống sẽ gợi ý chính xác tác phẩm mùi hương dành riêng cho bạn.
            </p>
            <a href="/catalog/quiz" class="btn-luxe" style="padding: 14px 32px;">
                <i class="fa-solid fa-wand-magic-sparkles" style="margin-right: 8px;"></i> Bắt Đầu Trắc Nghiệm Ngay
            </a>
        </div>

        <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 36px; box-shadow: var(--shadow-luxury); position: relative; overflow: hidden;">
            <div style="position: absolute; top: -30px; right: -30px; width: 120px; height: 120px; background: var(--gold-gradient); opacity: 0.15; filter: blur(40px); border-radius: 50%;"></div>
            <h3 style="font-size: 1.3rem; margin-bottom: 18px; color: var(--gold-primary);"><i class="fa-solid fa-layer-group" style="margin-right: 8px;"></i> Cấu Trúc 3 Tầng Hương Độc Bản</h3>
            <div style="display: flex; flex-direction: column; gap: 14px; font-size: 0.9rem;">
                <div style="padding: 12px 16px; background: var(--bg-surface); border-radius: var(--radius-sm); border-left: 3px solid var(--gold-primary);">
                    <strong>Hương Đầu (Top Notes):</strong> 10 - 15 phút đầu ấn tượng rực rỡ với cam bergamot, bưởi, tiêu cay.
                </div>
                <div style="padding: 12px 16px; background: var(--bg-surface); border-radius: var(--radius-sm); border-left: 3px solid var(--gold-primary);">
                    <strong>Hương Giữa (Heart Notes):</strong> Linh hồn mùi hương đọng lại 2 - 4 giờ cùng hoa oải hương, nhài trắng.
                </div>
                <div style="padding: 12px 16px; background: var(--bg-surface); border-radius: var(--radius-sm); border-left: 3px solid var(--gold-primary);">
                    <strong>Hương Cuối (Base Notes):</strong> Vương vấn đến 12 giờ sâu thẳm của đàn hương, tuyết tùng và vani ấm.
                </div>
            </div>
        </div>
    </div>
</section>

<!-- RECENT BLOG POSTS (CẨM NANG & SEO) -->
@if (blogs.Any())
{
    <section style="max-width: 1360px; margin: 80px auto; padding: 0 24px;">
        <div style="text-align: center; margin-bottom: 50px;">
            <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--gold-primary); font-weight: 700;">Cẩm Nang Mùi Hương</span>
            <h2 style="font-size: 2.4rem; margin-top: 6px;">Nghệ Thuật & Kiến Thức Nước Hoa</h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
            @foreach (var b in blogs)
            {
                <div style="background: var(--bg-surface); border: 1px solid var(--border-card); border-radius: var(--radius-md); overflow: hidden; display: flex; flex-direction: column;">
                    <a href="/blog/@b.Slug" style="display: block; width: 100%; height: 220px; overflow: hidden;" aria-label="Xem chi tiết bài viết: @b.Title">
                        <img src="@(b.ThumbnailUrl ?? "https://images.unsplash.com/photo-1547887537-6158d64c35b3?auto=format&fit=crop&w=600&q=75")" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;" alt="@b.Title" loading="lazy" decoding="async" width="400" height="220" />
                    </a>
                    <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
                        <span style="font-size: 0.75rem; color: var(--gold-primary); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">@(b.Category?.Name ?? "Kiến Thức")</span>
                        <h3 style="font-size: 1.3rem; margin-bottom: 12px; line-height: 1.3;">
                            <a href="/blog/@b.Slug">@b.Title</a>
                        </h3>
                        <p style="color: var(--text-secondary); font-size: 0.88rem; line-height: 1.6; margin-bottom: 16px;">
                            @b.Summary
                        </p>
                        <a href="/blog/@b.Slug" aria-label="Đọc bài viết: @b.Title" style="margin-top: auto; font-size: 0.82rem; font-weight: 600; color: var(--gold-primary); display: inline-flex; align-items: center; gap: 6px;">
                            <span>Đọc Chuyên Đề: @b.Title</span> <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- SEO EDITORIAL: NGHỆ THUẬT NƯỚC HOA NICHE & HAUTE PARFUMERIE (TĂNG WORD COUNT & KEYWORD DISTRIBUTION) -->
<section style="background: var(--bg-surface-elevated); border-top: 1px solid var(--border-card); border-bottom: 1px solid var(--border-card); padding: 70px 24px; margin-top: 60px;">
    <div style="max-width: 1200px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 36px;">
            <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.25em; color: var(--gold-primary); font-weight: 700;">Đặc Quyền Di Sản Mùi Hương</span>
            <h2 style="font-size: clamp(1.8rem, 3.2vw, 2.6rem); margin-top: 8px; font-family: var(--font-heading);">
                Thế Giới Nước Hoa Niche & Haute Parfumerie Đích Thực
            </h2>
            <div style="width: 60px; height: 2px; background: var(--gold-primary); margin: 16px auto 0;"></div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; line-height: 1.8; color: var(--text-secondary); font-size: 0.95rem;">
            <div>
                <h3 style="font-size: 1.25rem; color: var(--text-primary); margin-bottom: 12px; font-family: var(--font-heading);">
                    <i class="fa-solid fa-gem text-gold-gradient" style="margin-right: 8px;"></i> Bộ Sưu Tập Nước Hoa Thượng Hạng
                </h3>
                <p>
