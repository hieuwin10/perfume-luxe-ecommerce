@{
    ViewData["Title"] = "Chính Sách Đổi Trả & Bảo Hành Chính Hãng - PERFUME LUXE";
    ViewData["MetaDescription"] = "Chính sách đổi trả linh hoạt trong vòng 7 ngày, bảo hành vòi xịt trọn đời và cam kết hoàn tiền 200% nếu phát hiện hàng không chính hãng.";
}

<div style="background: radial-gradient(circle at center, rgba(212, 175, 55, 0.1) 0%, rgba(10, 10, 10, 0.98) 75%); padding: 70px 24px; text-align: center; border-bottom: 1px solid var(--border-card);">
    <div style="max-width: 800px; margin: 0 auto;">
        <span style="display: inline-block; padding: 4px 16px; background: rgba(212,175,55,0.12); border: 1px solid rgba(212,175,55,0.3); border-radius: 20px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.25em; color: var(--gold-primary); font-weight: 700; margin-bottom: 16px;">
            Đặc Quyền An Tâm Tuyệt Đối
        </span>
        <h1 style="font-size: 3rem; font-family: var(--font-serif); font-weight: 700; margin-bottom: 16px;">
            Chính Sách Đổi Trả & Bảo Hành
        </h1>
        <p style="font-size: 1rem; color: var(--text-secondary); line-height: 1.8;">
            Tại PERFUME LUXE, sự hài lòng và niềm tin tuyệt đối của quý khách là tiêu chuẩn phục vụ tối thượng.
        </p>
    </div>
</div>

<div style="max-width: 960px; margin: 60px auto; padding: 0 24px; font-size: 0.95rem; line-height: 1.8; color: var(--text-secondary);">
    <!-- Cam kết bồi hoàn 200% -->
    <div style="background: linear-gradient(135deg, rgba(212,175,55,0.15), rgba(20,20,20,0.95)); border: 1px solid var(--gold-primary); border-radius: var(--radius-md); padding: 30px; margin-bottom: 40px; display: flex; gap: 24px; align-items: center;">
        <div style="font-size: 3rem; color: var(--gold-primary);"><i class="fa-solid fa-shield-halved"></i></div>
        <div>
            <h3 style="font-size: 1.3rem; font-family: var(--font-serif); color: var(--gold-primary); margin-bottom: 8px;">
                Bảo Đảm Chính Hãng 100% • Cam Kết Bồi Hoàn 200%
            </h3>
            <p style="margin: 0; color: var(--text-primary); font-size: 0.92rem;">
                Mọi chai nước hoa bán ra tại PERFUME LUXE đều được bảo hiểm trọn đời sản phẩm. Nếu có bất kỳ kiểm định nào từ cơ quan chức năng hoặc hãng chứng minh hàng không chính hãng, chúng tôi bồi hoàn ngay lập tức 200% giá trị đơn hàng.
            </p>
        </div>
    </div>

    <!-- Điều kiện đổi trả -->
    <h2 style="font-size: 1.6rem; font-family: var(--font-serif); color: var(--text-primary); margin: 30px 0 16px;">
        1. Điều Kiện Đổi Trả Trong Vòng 7 Ngày
    </h2>
    <p>Quý khách được quyền yêu cầu đổi sang sản phẩm khác hoặc hoàn tiền trong vòng <strong>07 ngày</strong> kể từ thời điểm nhận hàng theo các điều kiện sau:</p>
    <ul style="padding-left: 20px; margin-bottom: 24px;">
        <li><strong>Lỗi do nhà sản xuất hoặc vận chuyển:</strong> Vòi xịt bị nghẹt, rò rỉ dung dịch, chai nứt vỡ trong quá trình vận chuyển (PERFUME LUXE đổi mới 100% không phát sinh bất kỳ chi phí nào).</li>
        <li><strong>Sản phẩm giao không đúng đơn đặt:</strong> Sai dung tích (ml), sai phiên bản nồng độ (EDT / EDP / Parfum).</li>
        <li><strong>Chai Fullbox chưa mở seal:</strong> Sản phẩm còn nguyên tem chống hàng giả, bọc seal nilon nguyên bản và hộp giấy không bị móp rách.</li>
    </ul>

    <!-- Bảo hành vòi xịt trọn đời -->
    <h2 style="font-size: 1.6rem; font-family: var(--font-serif); color: var(--text-primary); margin: 30px 0 16px;">
        2. Bảo Hành Vòi Xịt Trọn Đời Sản Phẩm
    </h2>
    <p>
        Đối với tất cả chai chiết 10ml và chai Fullbox mua tại PERFUME LUXE, quý khách được hưởng chính sách <strong>bảo hành thay thế vòi xịt hoàn toàn miễn phí</strong> trọn đời chai nước hoa nếu gặp hiện tượng tia xịt không tơi sương hoặc kẹt nắp.
    </p>

    <!-- Quy trình 3 bước -->
    <h2 style="font-size: 1.6rem; font-family: var(--font-serif); color: var(--text-primary); margin: 30px 0 16px;">
        3. Quy Trình Đổi Trả Đơn Giản Trong 3 Bước
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin: 24px 0 40px;">
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); padding: 24px; border-radius: var(--radius-md);">
            <div style="font-size: 1.5rem; color: var(--gold-primary); font-weight: 700; margin-bottom: 8px;">01. Liên Hệ</div>
            <p style="margin: 0; font-size: 0.88rem;">Nhắn tin qua Zalo VIP hoặc gọi Hotline <strong style="color: var(--text-primary);">024.3828.9999</strong> cung cấp mã đơn hàng và video mở hộp.</p>
        </div>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); padding: 24px; border-radius: var(--radius-md);">
            <div style="font-size: 1.5rem; color: var(--gold-primary); font-weight: 700; margin-bottom: 8px;">02. Shipper Thu Hồi</div>
            <p style="margin: 0; font-size: 0.88rem;">Shipper của chúng tôi sẽ đến tận nhà quý khách lấy hàng về mà quý khách không cần mang ra bưu cục.</p>
        </div>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-card); padding: 24px; border-radius: var(--radius-md);">
            <div style="font-size: 1.5rem; color: var(--gold-primary); font-weight: 700; margin-bottom: 8px;">03. Hoàn Tiền / Giao Mới</div>
            <p style="margin: 0; font-size: 0.88rem;">Ngay khi nhận được kiện hàng, PERFUME LUXE gửi sản phẩm mới hoặc hoàn tiền chuyển khoản trong vòng 24 giờ.</p>
        </div>
    </div>
</div>
